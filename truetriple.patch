+// Un descriptor es valido si sus 4 floats son plausibles Y la matriz a +0x2C
+// se deriva de ellos (firma de la sesion pasada, sirve de control positivo).
+static bool cull_desc_ok(const float *d, float aspect_real, float *m11_out)
+{
+	float fov = d[0], near_ = d[1], far_ = d[2], asp = d[3];
+	if (!(fov > 5.0f && fov < 175.0f))
+		return false;
+	if (!(near_ > 0.001f && near_ < 5.0f))
+		return false;
+	if (!(far_ > 200.0f && far_ < 1e6f))
+		return false;
+	if (asp < aspect_real - 0.0005f || asp > aspect_real + 0.0005f)
+		return false;
+
+	float m11 = 1.0f / tanf(fov * 0.008726646f);	// pi/180/2
+	float m00 = m11 / asp;
+	const float *M = d + 11;						// +0x2C
+	float e11 = M[5] - m11; if (e11 < 0) e11 = -e11;
+	float e00 = M[0] - m00; if (e00 < 0) e00 = -e00;
+	if (e11 > m11 * 0.002f || e00 > m00 * 0.002f)
+		return false;
+	// una proyeccion de verdad tiene ceros fuera de la diagonal y w=-z
+	if (M[1] != 0.0f || M[4] != 0.0f || M[12] != 0.0f || M[13] != 0.0f)
+		return false;
+	if (M[11] > -0.9f || M[11] < -1.1f)
+		return false;
+	if (m11_out)
+		*m11_out = m11;
+	return true;
+}
