+// v1.15: TODO ESTO ES thread_local (uno por contexto diferido).
+// CAUSA DEL PARPADEO en v1.14: eran globales compartidos. DiRT graba en 7
+// contextos diferidos, y en un contexto diferido UpdateSubresource NO se ejecuta
+// al llamarlo: queda GRABADO en la lista de comandos de ESE contexto. Con un
+// unico juego de buffers y un unico g_triple_frame:
+//   - el hilo A veia frame nuevo, grababa el Update y marcaba el frame como hecho;
+//   - el hilo B veia el frame ya hecho, NO grababa nada, y bindeaba igual;
+//   - si la lista de B se ejecutaba ANTES que la de A, B dibujaba con el contenido
+//     del frame ANTERIOR -> valores alternando entre cuadros = parpadeo.
+// Con buffers y bookkeeping por contexto, cada uno graba su propia actualizacion
+// antes de sus propios draws y queda internamente consistente.
+static thread_local ID3D11Buffer *g_triple_region_cb[3] = { NULL, NULL, NULL };
+// Copia sin modificar de la camara capturada, para restaurar sin usar Get* (los
+// metodos Get* de ID3D11DeviceContext no son fiables en contextos diferidos: fue
+// exactamente la causa del desastre de v1.5b con RSGetScissorRects).
+static thread_local ID3D11Buffer *g_triple_orig_cb = NULL;
+static thread_local UINT g_triple_cb_size = 0;
+static thread_local unsigned g_triple_frame = 0xFFFFFFFF;
+static thread_local bool g_triple_valid = false;
+
+// Per-context: the game's real camera cb3, saved on region 0 and restored by
+// triple_restore after the redraws (else unmatched draws leak the override).
+static thread_local ID3D11Buffer *tls_triple_saved_cb3 = NULL;
