+// Resultado de un match de PLANOS6: que par es que, y los angulos medidos.
+struct Planos6Info {
+	int nf0, nf1;		// par near/far (dot ~ -1)
+	int lat0, lat1;		// par lateral (dot ~ -cos fovH)
+	int v0, v1;			// par vertical (dot ~ -cos fovV)
+	float fovh, fovv;	// grados medidos desde los dots
+};
+
+// Layouts posibles de un juego de 6 planos en 24 floats:
+//   AoS (0): x0 y0 z0 d0 | x1 y1 z1 d1 | ...   (lo clasico)
+//   SoA (1): x0..x5 | y0..y5 | z0..z5 | d0..d5 (lo que usa un culler SIMD,
+//            que procesa los 6 planos de a 4/8 lanes — invisible para AoS)
+#define CULL_LAYOUT_AOS 0
+#define CULL_LAYOUT_SOA 1
+
+static inline void cull_plane_at(const float *g, int layout, int i,
+	float *x, float *y, float *z, float *d)
+{
+	if (layout == CULL_LAYOUT_SOA) {
+		*x = g[i]; *y = g[6 + i]; *z = g[12 + i]; *d = g[18 + i];
+	} else {
+		*x = g[i * 4]; *y = g[i * 4 + 1]; *z = g[i * 4 + 2]; *d = g[i * 4 + 3];
+	}
+}
+
+// PLANOS6: ¿hay en `g` 6 planos cuyas normales se aparean como el frustum de
+// esta camara? dot_h = -cos(fovH), dot_v = -cos(fovV).
+static bool cull_planos6_layout(const float *g, int layout, float dot_h,
+	float dot_v, Planos6Info *out)
+{
+	float n[6][3];
+	for (int i = 0; i < 6; i++) {
+		float q[4];
+		cull_plane_at(g, layout, i, &q[0], &q[1], &q[2], &q[3]);
+		// mismo cuidado con NaN que en cull_par_lateral: un rango escrito como
+		// `l2 < min || l2 > max` no rechaza NaN, lo deja pasar.
+		if (!(q[0] > -1e18f && q[0] < 1e18f) || !(q[1] > -1e18f && q[1] < 1e18f) ||
+		    !(q[2] > -1e18f && q[2] < 1e18f))
+			return false;
+		float l2 = q[0] * q[0] + q[1] * q[1] + q[2] * q[2];
+		// normal "unitaria con margen": si el engine no normaliza exacto igual
+		// la agarramos, y normalizamos nosotros antes de los dots
+		if (l2 < 0.49f || l2 > 2.25f)
+			return false;
+		float inv = 1.0f / sqrtf(l2);
+		n[i][0] = q[0] * inv; n[i][1] = q[1] * inv; n[i][2] = q[2] * inv;
+	}
+	// clasificar los 15 pares por su dot
+	int nf[15][2], nh[15][2], nv[15][2];
+	int c_nf = 0, c_h = 0, c_v = 0;
+	for (int i = 0; i < 6; i++) {
+		for (int j = i + 1; j < 6; j++) {
+			float d = n[i][0] * n[j][0] + n[i][1] * n[j][1] + n[i][2] * n[j][2];
+			float e;
+			e = d + 1.0f;   if (e < 0) e = -e;
+			if (e < 0.02f && c_nf < 15) { nf[c_nf][0] = i; nf[c_nf][1] = j; c_nf++; }
+			e = d - dot_h;  if (e < 0) e = -e;
+			if (e < 0.03f && c_h < 15)  { nh[c_h][0] = i; nh[c_h][1] = j; c_h++; }
+			e = d - dot_v;  if (e < 0) e = -e;
+			if (e < 0.03f && c_v < 15)  { nv[c_v][0] = i; nv[c_v][1] = j; c_v++; }
+		}
+	}
+	// apareamiento perfecto: un par de cada clase y los 6 indices distintos
+	for (int a = 0; a < c_nf; a++) {
+		for (int b = 0; b < c_h; b++) {
+			for (int c = 0; c < c_v; c++) {
+				unsigned mask = (1u << nf[a][0]) | (1u << nf[a][1]) |
+					(1u << nh[b][0]) | (1u << nh[b][1]) |
+					(1u << nv[c][0]) | (1u << nv[c][1]);
+				// 6 bits prendidos = sin repetidos
+				unsigned m = mask; int bits = 0;
+				while (m) { bits += m & 1; m >>= 1; }
+				if (bits != 6)
+					continue;
+				const float *p1 = &n[nh[b][0]][0], *p2 = &n[nh[b][1]][0];
+				float dh = p1[0] * p2[0] + p1[1] * p2[1] + p1[2] * p2[2];
+				p1 = &n[nv[c][0]][0]; p2 = &n[nv[c][1]][0];
+				float dv = p1[0] * p2[0] + p1[1] * p2[1] + p1[2] * p2[2];
+				out->nf0 = nf[a][0]; out->nf1 = nf[a][1];
+				out->lat0 = nh[b][0]; out->lat1 = nh[b][1];
+				out->v0 = nv[c][0]; out->v1 = nv[c][1];
+				out->fovh = 180.0f - acosf(dh) * 57.29578f;
+				out->fovv = 180.0f - acosf(dv) * 57.29578f;
+				return true;
+			}
+		}
+	}
+	return false;
+}
