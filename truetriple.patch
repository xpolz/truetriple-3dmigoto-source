+// Camera cb captured at write-time (from HackerContext Map/Unmap) to avoid a
+// deferred-context GPU readback, which is illegal on deferred contexts.
+static char g_triple_cam_buf[512];
+static UINT g_triple_cam_size = 0;
+static volatile bool g_triple_cam_valid = false;
