+// ===== v1.59: PAR de planos laterales (culler 2D) ===========================
+//
+// El sintoma que describe el usuario es preciso: una linea recta que se va al
+// horizonte, matas que aparecen y desaparecen al cruzarla, y vuelven en marcha
+// atras. Eso es un recorte por PLANO, mata por mata — pero horizontal.
+//
+// Toda la caceria anterior busco juegos de SEIS planos (izq/der/arriba/abajo/
+// near/far), que es la forma clasica de un frustum 3D. Un culler de vegetacion
+// no necesita recortar por arriba ni por abajo: el pasto vive en el suelo. Le
+// alcanzan DOS planos laterales, y con esa firma nunca lo hubieramos visto.
+//
+// Firma: dos float4 con normal unitaria, casi horizontales (|ny| chico) y con
+// dot entre ellos == -cos(fovH). Se aceptan separados hasta 64 bytes porque no
+// tienen por que ser contiguos.
+static bool cull_par_lateral(const float *g, int sep, float dot_h, float *ang)
+{
+	const float *a = g, *b = g + sep;
+	// FILTRO BARATO PRIMERO (rendimiento): un plano lateral de culler 2D tiene
+	// la normal casi horizontal -> ny ~ 0. Esta sola comparacion descarta el
+	// 99%+ de las posiciones de una, y de paso rechaza NaN (toda comparacion
+	// contra NaN es falsa, asi que el `!( )` la mata). Sin esto el barrido de
+	// 8 GB no llegaba a terminar antes de que el usuario cerrara el juego.
+	if (!(a[1] > -0.10f && a[1] < 0.10f))
+		return false;
+	if (!(b[1] > -0.10f && b[1] < 0.10f))
+		return false;
+	// resto de la validacion de NaN sobre los campos que quedan
+	if (!(a[0] > -1e18f && a[0] < 1e18f) || !(a[2] > -1e18f && a[2] < 1e18f) ||
+	    !(b[0] > -1e18f && b[0] < 1e18f) || !(b[2] > -1e18f && b[2] < 1e18f))
+		return false;
+	float la = a[0]*a[0] + a[1]*a[1] + a[2]*a[2];
+	float lb = b[0]*b[0] + b[1]*b[1] + b[2]*b[2];
+	if (la < 0.96f || la > 1.04f || lb < 0.96f || lb > 1.04f)
+		return false;
+	// casi horizontales: un plano lateral de un culler 2D tiene la normal en el
+	// plano del suelo. Esto es lo que separa el par lateral de cualquier otro
+	// par de vectores unitarios sueltos que ande dando vueltas en memoria.
+	if (a[1] > 0.10f || a[1] < -0.10f || b[1] > 0.10f || b[1] < -0.10f)
+		return false;
+	float d = a[0]*b[0] + a[1]*b[1] + a[2]*b[2];
+	float e = d - dot_h; if (e < 0) e = -e;
+	if (e > 0.02f)
+		return false;
+	// y que no sean el mismo plano repetido
+	if (d > 0.999f)
+		return false;
+	*ang = 180.0f - acosf(d) * 57.29578f;
+	return true;
+}
+
+// Prueba los dos layouts. Devuelve el que matcheo, o -1.
+static int cull_planos6_any(const float *g, float dot_h, float dot_v,
+	Planos6Info *out)
+{
+	if (cull_planos6_layout(g, CULL_LAYOUT_AOS, dot_h, dot_v, out))
+		return CULL_LAYOUT_AOS;
+	if (cull_planos6_layout(g, CULL_LAYOUT_SOA, dot_h, dot_v, out))
+		return CULL_LAYOUT_SOA;
+	return -1;
+}
+
+// El interceptor de constant buffers solo usa AoS.
+static bool cull_planos6(const float *g, float dot_h, float dot_v,
+	Planos6Info *out)
+{
+	return cull_planos6_layout(g, CULL_LAYOUT_AOS, dot_h, dot_v, out);
+}
+
+// ===== v1.38 fase 2: ABRIR el frustum escribiendo los planos ================
+// El escaneo del 2026-07-28 encontro dos familias de juegos de 6 planos con
+// los angulos EXACTOS de la camara en uso (ver docs/MEMORIA.md):
+//   GRUPO A (tipo 1): orden canonico [near,far,izq,der,arriba,abajo], w de
+//     miles -> planos en ESPACIO DE MUNDO, actualizados con el movimiento.
+//   GRUPO B (tipo 2): orden [izq,der,near,far,arriba,abajo], w chicos,
+//     angulos con banda (149.90/68.97 vs 150.31/70.00).
+// El truco de escritura no necesita rotar nada: se pisan los DOS planos
+// laterales con copias del par near/far. El test lateral queda redundante
+// (todo lo que pasa near/far pasa los laterales) -> culling horizontal
+// abierto, vertical intacto. Como cada plano es un semiespacio independiente,
+// esto equivale a abrir el frustum a 360 en horizontal — el techo de tan(90)
+// de las proyecciones no aplica.
+// El engine reconstruye los planos por frame, asi que mientras este activado
+// se escribe en bucle apretado (la leccion del descriptor: escribir 1 vez por
+// frame pierde la carrera contra el culling del mismo frame). Un core al 100%
+// mientras esta prendido: es diagnostico, no release.
+// Se controla con $cull_widen desde el ini (F8): 0=off 1=grupoA 2=grupoB 3=ambos.
+
+#define CULL_MAX_SETS 64
+struct PlaneSet {
+	volatile float *p;	// los 24 floats del juego de planos
+	int tipo;			// 1=grupo A, 2=grupo B, 0=no escribible
+	int layout;			// CULL_LAYOUT_AOS / _SOA
+	Planos6Info info;
+	bool aplicado;		// nuestros valores estan puestos ahora mismo
+	bool muerto;		// AV o dejo de parecer un juego de planos
+	int reescrituras;	// veces que el engine nos piso (= reconstruye por frame)
+	int cambios;		// v1.40: cuantas veces cambio SOLO (sin tocarlo)
+	float snapshot[24];
+};
+static PlaneSet g_cull_sets[CULL_MAX_SETS];
+static int g_cull_nsets = 0;
+
+// ===== v1.40: ¿cual de estos juegos de planos esta VIVO? =====================
+// La prueba en pista mostro que los 4 sets del v1.38 apenas se reescriben (~1/s
+// segun reescrituras_engine). El frustum que de verdad decide el culling se
+// reconstruye POR FRAME: sus 24 floats cambian ~60 veces por segundo mientras
+// el auto se mueve. Esta pasada no escribe nada: solo mira quien late.
+// Sin esto seguiriamos escribiendo copias en cache y viendo efectos parciales.
+static DWORD WINAPI cull_vitals_thread(LPVOID)
+{
+	// dejar que el juego llegue a pista y se mueva un poco
+	Sleep(2000);
+
+	for (int i = 0; i < g_cull_nsets; i++) {
+		PlaneSet *s = &g_cull_sets[i];
+		s->cambios = 0;
+		__try {
+			for (int k = 0; k < 24; k++)
+				s->snapshot[k] = s->p[k];
+		} __except (EXCEPTION_EXECUTE_HANDLER) {
+			s->muerto = true;
+		}
+	}
+
+	// 60 muestras cada 50 ms = 3 segundos de observacion
+	for (int muestra = 0; muestra < 60; muestra++) {
+		Sleep(50);
+		for (int i = 0; i < g_cull_nsets; i++) {
+			PlaneSet *s = &g_cull_sets[i];
+			if (s->muerto)
+				continue;
+			__try {
+				bool cambio = false;
+				for (int k = 0; k < 24; k++) {
+					float v = s->p[k];
+					if (v != s->snapshot[k]) {
+						cambio = true;
+						s->snapshot[k] = v;
+					}
+				}
+				if (cambio)
+					s->cambios++;
+			} __except (EXCEPTION_EXECUTE_HANDLER) {
+				s->muerto = true;
+			}
+		}
+	}
+
+	LogInfo("CULLVITAL: ==== quien late (60 muestras en 3s, sin escribir) ====\n");
+	int vivos = 0;
+	for (int i = 0; i < g_cull_nsets; i++) {
+		PlaneSet *s = &g_cull_sets[i];
+		bool vivo = (s->cambios >= 30);	// cambia en al menos la mitad
+		if (vivo)
+			vivos++;
+		LogInfo("CULLVITAL set #%d en %p layout=%s tipo=%d fovH=%.2f fovV=%.2f: "
+			"cambios=%d/60 %s\n",
+			i, (void *)s->p,
+			s->layout == CULL_LAYOUT_SOA ? "SoA" : "AoS",
+			s->tipo, s->info.fovh, s->info.fovv, s->cambios,
+			vivo ? "<== VIVO (se reconstruye por frame)" :
+			(s->cambios > 0 ? "(tibio)" : "(congelado)"));
+	}
+	LogInfo("CULLVITAL: %d de %d sets estan VIVOS. Los vivos son los que de "
+		"verdad decide el culler; F8 escribe SOLO esos si hay alguno.\n",
+		vivos, g_cull_nsets);
+
+	// Si hay vivos, restringir la escritura a ellos: escribir copias muertas
+	// fue exactamente lo que dio el efecto parcial del v1.38.
+	if (vivos > 0) {
+		for (int i = 0; i < g_cull_nsets; i++)
+			// tipo 1 (frustum canonico, angulos EXACTOS de la camara) es la
+			// camara por definicion: NUNCA se demota. El test de vitalidad solo
+			// filtra los ambiguos (tipo 2/4). Sin esto, entrar QUIETO a pista
+			// daba 0 cambios en la ventana y desactivaba hasta la camara real
+			// -> F8 no hacia nada (regresion del RAM-A reportada).
+			if (g_cull_sets[i].cambios < 30 && g_cull_sets[i].tipo != 1)
+				g_cull_sets[i].tipo = 0;	// no escribible
+		LogInfo("CULLVITAL: escritura restringida a los vivos + tipo-1 (camara).\n");
+	} else {
+		LogInfo("CULLVITAL: NINGUNO late. El frustum real no esta en memoria "
+			"escaneable con esta firma (candidatos: otro layout, planos "
+			"derivados en el momento desde la matriz VP, o culling por "
+			"celdas/PVS).\n");
+	}
+	return 0;
+}
+
+// Una pasada de escritura sobre un juego de planos. SEH sin objetos C++: la
+// memoria es del engine y puede liberarse en cualquier momento.
+// `todo` = abrir tambien el par vertical (modo agresivo de diagnostico: sirve
+// para saber SI este frustum manda sobre lo que buscamos, sin depender de haber
+// identificado bien cual par es el lateral y cual el vertical).
+// Devuelve: 1 escrito, 0 ya estaba puesto, -1 ya no son planos, -2 AV.
+static int cull_widen_one(PlaneSet *s, bool todo)
+{
+	// v1.59: par lateral 2D (tipo 5). No hay near/far con que taparlo, asi que
+	// se rota cada normal hacia afuera hasta dejarlas antiparalelas: dos planos
+	// mirando en sentidos opuestos no recortan nada en horizontal. Es el
+	// equivalente 2D de abrir el frustum a 360.
+	if (s->tipo == 5) {
+		__try {
+			volatile float *p = s->p;
+			int sep = s->layout;
+			float ax = p[0], ay = p[1], az = p[2];
+			float bx = p[sep], by = p[sep + 1], bz = p[sep + 2];
+			float la = ax*ax + ay*ay + az*az, lb = bx*bx + by*by + bz*bz;
+			if (la < 0.9f || la > 1.1f || lb < 0.9f || lb > 1.1f)
+				return -1;
+			// ¿ya estan antiparalelas? entonces nuestra escritura sigue puesta
+			float d = ax*bx + ay*by + az*bz;
+			if (d < -0.995f)
+				return 0;
+			if (s->aplicado)
+				s->reescrituras++;
+			// eje comun = bisectriz; cada normal pasa a apuntar al opuesto del
+			// otro. Se conservan las distancias (w): mover el plano de lugar
+			// recortaria por distancia, que no es lo que queremos tocar.
+			float ex = ax - bx, ey = ay - by, ez = az - bz;
+			float le = sqrtf(ex*ex + ey*ey + ez*ez);
+			if (le < 1e-4f)
+				return -1;
+			ex /= le; ey /= le; ez /= le;
+			p[0] = ex;  p[1] = ey;  p[2] = ez;
+			p[sep] = -ex; p[sep+1] = -ey; p[sep+2] = -ez;
+			s->aplicado = true;
+			return 1;
+		} __except (EXCEPTION_EXECUTE_HANDLER) {
+			return -2;
+		}
+	}
+
+	__try {
+		volatile float *p = s->p;
+		// indices de los 4 floats de cada plano segun el layout
+		int paso = (s->layout == CULL_LAYOUT_SOA) ? 1 : 4;
+		int salto = (s->layout == CULL_LAYOUT_SOA) ? 6 : 1;
+		// revalidar barato: las 6 normales siguen teniendo largo sano
+		for (int i = 0; i < 6; i++) {
+			float x = p[i * paso], y = p[i * paso + salto], z = p[i * paso + 2 * salto];
+			float l2 = x * x + y * y + z * z;
+			if (l2 < 0.25f || l2 > 4.0f)
+				return -1;
+		}
+		int na = s->info.nf0 * paso, nb = s->info.nf1 * paso;
+		// planos a neutralizar: los dos laterales, y en modo agresivo tambien
+		// los dos verticales. Cada uno se pisa con una copia de un plano del
+		// par near/far, que ya lo contiene: el test se vuelve redundante.
+		int dst[4], src[4], n = 0;
+		dst[n] = s->info.lat0 * paso; src[n++] = na;
+		dst[n] = s->info.lat1 * paso; src[n++] = nb;
+		if (todo) {
+			dst[n] = s->info.v0 * paso; src[n++] = na;
+			dst[n] = s->info.v1 * paso; src[n++] = nb;
+		}
+		// si ya estan puestos, nuestra escritura sigue vigente
+		bool puesto = true;
+		for (int i = 0; i < n && puesto; i++)
+			for (int k = 0; k < 4 && puesto; k++)
+				if (p[dst[i] + k * salto] != p[src[i] + k * salto])
+					puesto = false;
+		if (puesto)
+			return 0;
+		if (s->aplicado)
+			s->reescrituras++;	// el engine reconstruyo: dato en si mismo
+		for (int i = 0; i < n; i++)
+			for (int k = 0; k < 4; k++)
+				p[dst[i] + k * salto] = p[src[i] + k * salto];
+		s->aplicado = true;
+		return 1;
+	} __except (EXCEPTION_EXECUTE_HANDLER) {
+		return -2;
+	}
+}
+
+static DWORD WINAPI cull_widen_thread(LPVOID)
+{
+	// Lectura directa de la variable del ini (los punteros a valores de un
+	// unordered_map sobreviven; despues de cargar el ini no se agregan claves).
+	CommandListVariable *var = NULL;
+	{
+		auto it = command_list_globals.find(L"$cull_widen");
+		if (it != command_list_globals.end())
+			var = &it->second;
+	}
+	LogInfo("CULLWIDEN: variable $cull_widen %s | %d juego(s) de planos "
+		"registrados\n", var ? "encontrada" : "NO ENCONTRADA -> inerte",
+		g_cull_nsets);
+	if (!var)
+		return 0;
+
+	int ultimo_modo = -1;
+	unsigned escrituras = 0;
+	int ciclos_log = 0;
+
+	while (true) {
+		int modo = (int)var->fval;
+
+		if (modo != ultimo_modo) {
+			ultimo_modo = modo;
+			int na = 0, nb = 0;
+			for (int i = 0; i < g_cull_nsets; i++) {
+				g_cull_sets[i].aplicado = false;
+				if (g_cull_sets[i].muerto || !g_cull_sets[i].tipo)
+					continue;
+				if (g_cull_sets[i].tipo == 1) na++;
+				else nb++;
+			}
+			LogInfo("CULLWIDEN: modo=%d (bits: 1=camara 4=cbufferGPU 8=TODOS los "
+				"frustums vivos) | sets escribibles=%d\n", modo, na + nb);
+			LogOverlay(LOG_WARNING, "Culling: %s%s%s%s\n",
+				modo == 0 ? "original" : "abierto:",
+				(modo & 1) ? " camara" : "",
+				(modo & 4) ? " GPU-cb" : "",
+				(modo & 8) ? " TODOS-los-frustums" : "");
+		}
+
+		// los bits 1/2/8 (RAM) los aplica este hilo; el bit 4 lo aplica el
+		// interceptor de constant buffers (TripleScanPlanesInCB) en el momento
+		// exacto de la subida, sin carrera. Aca solo importa si hay RAM activa.
+		if ((modo & 11) == 0) {
+			// apagado: no restauramos nada a mano — el engine reconstruye los
+			// planos por frame solo (verificado: w cambia con el movimiento)
+			Sleep(50);
+			continue;
+		}
+
+		// prendido: bucle apretado para ganarle a la reconstruccion por frame
+		for (int k = 0; k < 2000; k++) {
+			for (int i = 0; i < g_cull_nsets; i++) {
+				PlaneSet *s = &g_cull_sets[i];
+				if (s->muerto || s->tipo == 0)
+					continue;
+				// bit 1 = solo el frustum canonico de la camara (tipo 1, lo que ya
+				// sabemos que mueve arboles). bit 8 = TODOS los frustums vivos,
+				// abriendo tambien el par vertical: es el modo de diagnostico
+				// para saber si el pasto obedece a ALGUNO de los otros.
+				// tipo 5 = par lateral 2D (el candidato del pasto). Entra siempre
+				// que haya algun modo prendido: es el hallazgo mas nuevo y no
+				// tiene sentido esconderlo detras de un bit extra.
+				bool agresivo = (modo & 8) != 0;
+				if (!agresivo && s->tipo != 1 && s->tipo != 5)
+					continue;
+				int r = cull_widen_one(s, agresivo);
+				if (r == 1)
+					escrituras++;
+				else if (r < 0)
+					s->muerto = true;
+			}
+			YieldProcessor();
+		}
+
+		// estado periodico (~cada 2s con el bucle de 2000): el log habla solo
+		if (++ciclos_log % 32 == 0) {
+			int vivos = 0, pisadas = 0;
+			for (int i = 0; i < g_cull_nsets; i++) {
+				if (!g_cull_sets[i].muerto && g_cull_sets[i].tipo)
+					vivos++;
+				pisadas += g_cull_sets[i].reescrituras;
+			}
+			LogInfo("CULLWIDEN [estado] modo=%d escrituras=%u sets_vivos=%d "
+				"reescrituras_engine=%d\n", modo, escrituras, vivos, pisadas);
+		}
+		Sleep(0);
+	}
+}
+
+// ===== v1.39: planos que viajan por CONSTANT BUFFER (culling en GPU) =========
+// La prueba en pista del v1.38 confirmo que el grupo A (planos en RAM) es
+// consumido por UN camino de culling (arboles que aparecen), pero el pasto y
+// la linea de corte lejana no se inmutaron. El sospechoso: la vegetacion se
+// instancia por GPU (los compute shaders HZBOcclusion* del exe), y un culling
+// en GPU recibe sus planos por constant buffer. Somos un wrapper de D3D11:
+// interceptamos la subida (Map/Unmap y UpdateSubresource, via HackerContext),
+// buscamos la MISMA firma de 6 planos en los datos, y con el bit 4 de
+// $cull_widen los parcheamos ANTES de que la GPU los vea — determinista, sin
+// carrera contra el engine.
+// Devuelve: 0 = nada, 1 = planos encontrados (sin parchear), 2 = parcheados.
+int TripleScanPlanesInCB(void *data, unsigned size, void *res_id,
+	unsigned bindFlags, int allow_patch)
+{
+	return 0;	// v1.74 LIMPIEZA: el "culling por constant buffer GPU" nunca
+				// encontro nada real (todos falsos positivos). Neutralizado.
+	if (!g_triple_cam_valid || !data || size < 96)
+		return 0;
+	// v1.40: SOLO constant buffers. La primera prueba escaneaba tambien vertex
+	// buffers (bind=0x1) y se llenaba de falsos positivos: un buffer de normales
+	// de vertices es, por construccion, un mar de vectores unitarios — justo lo
+	// que esta firma busca. Los 40 CULLCB de esa sesion eran todos basura.
+	if (!(bindFlags & D3D11_BIND_CONSTANT_BUFFER))
+		return 0;
+	const float *cam = (const float *)g_triple_cam_buf;
+	float m00 = cam[0], m11 = cam[5];
+	if (m00 < 0.0001f || m11 < 0.0001f)
+		return 0;
+	// y solo con la camara de CONDUCCION en mano: con la del menu (m11 4.27) los
+	// angulos objetivo son otros y todo lo que matchea es ruido.
+	if (m11 < 1.2f || m11 > 3.0f)
+		return 0;
+	// dots objetivo desde la camara actual (fovH = 2*atan(aspect/m11) =
+	// 2*atan(1/m00)); invariantes a rotacion, igual que en el escaner
+	float dot_h = -cosf(2.0f * atanf(1.0f / m00));
+	float dot_v = -cosf(2.0f * atanf(1.0f / m11));
+
+	// bit 4 de $cull_widen = parchear los cbs. Lectura directa del ini, como
+	// el resto; el puntero al valor del unordered_map es estable tras la carga.
+	static CommandListVariable *var = NULL;
+	static volatile LONG var_init = 0;
+	if (!var_init) {
+		auto it = command_list_globals.find(L"$cull_widen");
+		if (it != command_list_globals.end())
+			var = &it->second;
+		InterlockedExchange(&var_init, 1);
+	}
+	bool patch = allow_patch && var && (((int)var->fval) & 4);
+
+	// presupuesto de log compartido entre hilos (contextos diferidos)
+	static volatile LONG logged = 0;
+
+	int resultado = 0;
+	unsigned limite = size > 16384 ? 16384 : size;
+	for (unsigned off = 0; off + 96 <= limite; off += 16) {
+		float *g = (float *)((uint8_t *)data + off);
+		Planos6Info pi;
+		if (!cull_planos6(g, dot_h, dot_v, &pi))
+			continue;
+
+		if (logged < 40 && InterlockedIncrement(&logged) <= 40) {
+			LogInfo("CULLCB: planos en buffer res=%p size=%u bind=0x%X off=%u | "
+				"nearfar=[%d,%d] lat=[%d,%d] fovH=%.2f vert=[%d,%d] fovV=%.2f | "
+				"w={%.3f %.3f %.3f %.3f %.3f %.3f}%s\n",
+				res_id, size, bindFlags, off,
+				pi.nf0, pi.nf1, pi.lat0, pi.lat1, pi.fovh,
+				pi.v0, pi.v1, pi.fovv,
+				g[3], g[7], g[11], g[15], g[19], g[23],
+				patch ? " -> PARCHEADO" : "");
+		}
+
+		if (patch) {
+			for (int k = 0; k < 4; k++) g[pi.lat0 * 4 + k] = g[pi.nf0 * 4 + k];
+			for (int k = 0; k < 4; k++) g[pi.lat1 * 4 + k] = g[pi.nf1 * 4 + k];
+			resultado = 2;
+		} else if (resultado == 0) {
+			resultado = 1;
+		}
+		off += 80;	// saltar el resto de este set (el for suma los 16 restantes)
+	}
+	return resultado;
+}
+
+// Escanea una region ya validada. SEH aparte (sin objetos C++) porque la region
+// puede liberarse entre el VirtualQuery y la lectura: un AV aca se traga y se
+// sigue con la siguiente.
+static int cull_scan_region(const uint8_t *base, size_t size, const CullScanReq *req,
+	int *n_mat, int *n_fov, int *n_planos, int *n_planos6,
+	int *n_laxos, int *n_pares, const uint8_t **ultimo_plano,
+	const uint8_t **ultimo_p6, const uint8_t **ultimo_par)
+{
+	unsigned needle0 = *(const unsigned *)&req->P[0];
+	float fov_rad = 2.0f * atanf(1.0f / req->m11);
+	float fov_deg = fov_rad * 57.29578f;
+	float tan_half = 1.0f / req->m11;
+	char who[MAX_PATH];
+
+	// Componentes de los planos laterales y verticales del frustum de ESTA
+	// camara, en espacio de vista (firma por valor exacto).
+	float kl = sqrtf(req->m00 * req->m00 + 1.0f);
+	float plano_lat = req->m00 / kl, plano_lat_z = 1.0f / kl;
+	float kv = sqrtf(req->m11 * req->m11 + 1.0f);
+	float plano_vert = req->m11 / kv, plano_vert_z = 1.0f / kv;
+
+	// Dots objetivo del apareamiento (invariantes a rotacion):
+	// laterales: dot = -cos(fovH); verticales: dot = -cos(fovV)
+	float fovH = 2.0f * atanf(req->aspect / req->m11);
+	float dot_h = -cosf(fovH);
+	float dot_v = -cosf(fov_rad);
+
+	__try {
+		for (size_t off = 0; off + 128 <= size; off += 4) {
+			const uint8_t *p = base + off;
+			float v = *(const float *)p;
+
+			// 0. PLANOS6: la firma nueva. Quick-reject adentro (primer grupo).
+			if (*n_planos6 < 48 && (uintptr_t)(p - *ultimo_p6) > 96) {
+				Planos6Info pi;
+				int layout = cull_planos6_any((const float *)p, dot_h, dot_v, &pi);
+				if (layout >= 0) {
+					*ultimo_p6 = p;
+					(*n_planos6)++;
+
+					// clasificar para la fase 2 (v1.38):
+					//   tipo 1 = grupo A: canonico [nf,lat,vert]=[01,23,45] y
+					//            angulos exactos (los del culling en mundo)
+					//   tipo 2 = grupo B: orden [lat,nf,vert]=[01,23,45] invertido
+					float fovh_req = fovH * 57.29578f;
+					float fovv_req = fov_deg;
+					float eh = pi.fovh - fovh_req; if (eh < 0) eh = -eh;
+					float ev = pi.fovv - fovv_req; if (ev < 0) ev = -ev;
+					int tipo = 0;
+					if (pi.nf0 == 0 && pi.nf1 == 1 && pi.lat0 == 2 &&
+						pi.lat1 == 3 && pi.v0 == 4 && pi.v1 == 5 &&
+						eh < 0.2f && ev < 0.2f)
+						tipo = 1;
+					else if (pi.lat0 == 0 && pi.lat1 == 1 && pi.nf0 == 2 &&
+						pi.nf1 == 3 && pi.v0 == 4 && pi.v1 == 5)
+						tipo = 2;
+					// v1.41: registrar TODOS los candidatos, sin filtro de angulo.
+					// La v1.40 exigia coincidir con la camara a menos de 0.5 deg
+					// y dejaba en tipo=0 (ni medidos ni escritos) juegos de
+					// planos con fovH 147.2 / 148.6 / 151.7 / 153.4 — justo el
+					// rango donde caeria un frustum de SIEMBRA con margen, que
+					// es el sospechoso de cullear el pasto. Ahora entran todos y
+					// decide la vitalidad.
+					if (tipo == 0)
+						tipo = 4;	// candidato generico
+					if (tipo && g_cull_nsets < CULL_MAX_SETS) {
+						PlaneSet *s = &g_cull_sets[g_cull_nsets++];
+						s->p = (volatile float *)p;
+						s->tipo = tipo;
+						s->layout = layout;
+						s->cambios = 0;
+						s->info = pi;
+						s->aplicado = false;
+						s->muerto = false;
+						s->reescrituras = 0;
+					}
+
+					const float *g = (const float *)p;
+					int ds = (layout == CULL_LAYOUT_SOA) ? 1 : 4;
+					int d0 = (layout == CULL_LAYOUT_SOA) ? 18 : 3;
+					LogInfo("CULLSCAN PLANOS6 #%d en %p (%s) layout=%s: "
+						"nearfar=[%d,%d] lat=[%d,%d] (fovH medido %.2f deg) "
+						"vert=[%d,%d] (fovV medido %.2f deg) "
+						"d={%.3f %.3f %.3f %.3f %.3f %.3f} tipo=%d\n",
+						*n_planos6, p, cull_owner(p, who, sizeof(who)),
+						layout == CULL_LAYOUT_SOA ? "SoA" : "AoS",
+						pi.nf0, pi.nf1, pi.lat0, pi.lat1, pi.fovh,
+						pi.v0, pi.v1, pi.fovv,
+						g[d0], g[d0 + ds], g[d0 + 2 * ds], g[d0 + 3 * ds],
+						g[d0 + 4 * ds], g[d0 + 5 * ds], tipo);
+					cull_dump(p, base, size, 16, 40);
+				}
+			}
+
+			// 1. DESCRIPTOR estricto (control positivo de la sesion pasada) y
+			//    camaras laxas (candidatas a la camara del hilo de simulacion).
+			if (v > req->aspect - 0.0005f && v < req->aspect + 0.0005f && off >= 12) {
+				const float *d = (const float *)(p - 12);
+				float m11 = 0.0f;
+
+				if (!cull_desc_ok(d, req->aspect, NULL) && *n_laxos < 24 &&
+					d[0] > 5.0f && d[0] < 175.0f &&
+					d[1] > 0.001f && d[1] < 5.0f &&
+					d[2] > 200.0f && d[2] < 1e6f) {
+					(*n_laxos)++;
+					float mm = 1.0f / tanf(d[0] * 0.008726646f);
+					LogInfo("CULLSCAN camara-laxa #%d en %p (%s): fov=%.4f near=%.4f "
+						"far=%.1f -> m11=%.6f%s\n", *n_laxos, d,
+						cull_owner(d, who, sizeof(who)), d[0], d[1], d[2], mm,
+						(mm > req->m11 * 0.9999f && mm < req->m11 * 1.0001f)
+							? "  <== MISMO FOV QUE LA CAMARA EN USO" : "");
+					cull_dump((const uint8_t *)d, base, size, 8, 40);
+				}
+
+				if (cull_desc_ok(d, req->aspect, &m11)) {
+					char w2[MAX_PATH];
+					float em = m11 - req->m11; if (em < 0) em = -em;
+					bool activo = (em < req->m11 * 1e-5f);
+					LogInfo("CULLSCAN descriptor %s en %p (%s): fov=%.4f near=%.4f "
+						"far=%.1f aspect=%.6f -> m11=%.6f fovH=%.1f deg\n",
+						activo ? "**ACTIVO**" : "otro", d,
+						cull_owner(d, w2, sizeof(w2)),
+						d[0], d[1], d[2], d[3], m11,
+						2.0f * atanf(req->aspect / m11) * 57.29578f);
+					if (activo)
+						cull_dump((const uint8_t *)d, base, size, 16, 48);
+				}
+			}
+
+			// 1b. PAR LATERAL (culler 2D del pasto). Se prueban varias
+			//     separaciones porque los dos planos no tienen por que estar
+			//     pegados: pueden vivir en campos distintos de una estructura.
+			//     SOLO en offsets alineados a 16 bytes: los planos float4 casi
+			//     siempre lo estan, y esto divide por 4 el costo del barrido —
+			//     que es lo que hacia que no terminara.
+			if ((off & 15) == 0 && *n_pares < 32 &&
+			    (uintptr_t)(p - *ultimo_par) > 32) {
+				static const int seps[] = { 4, 8, 3 };
+				for (int si = 0; si < 3; si++) {
+					float ang = 0.0f;
+					if (off + (size_t)(seps[si] + 4) * 4 > size)
+						continue;
+					if (!cull_par_lateral((const float *)p, seps[si], dot_h, &ang))
+						continue;
+					*ultimo_par = p;
+					(*n_pares)++;
+					const float *g = (const float *)p;
+					// SOLO LOG. Los pares NO se registran como sets escribibles:
+					// meterlos en g_cull_sets llenaba los 64 lugares y desplazaba
+					// los planos tipo 1 (los que mueven los arbustos), rompiendo
+					// F8. Primero se identifica cual par lateral es el del pasto
+					// leyendo el log; recien ahi se escribe, con su direccion.
+					if (*n_pares <= 12)
+						LogInfo("CULLSCAN PAR-LATERAL #%d en %p (%s) sep=%d: "
+							"fovH=%.2f | n0=(%.4f %.4f %.4f) d0=%.2f | "
+							"n1=(%.4f %.4f %.4f) d1=%.2f\n",
+							*n_pares, p, cull_owner(p, who, sizeof(who)),
+							seps[si], ang, g[0], g[1], g[2], g[3],
+							g[seps[si]], g[seps[si]+1], g[seps[si]+2], g[seps[si]+3]);
+					break;
+				}
+			}
+
+			// 2. Componentes de plano en vista por VALOR EXACTO (firma vieja;
+			//    solo cubre espacio de vista, pero el dump es oro si pega).
+			if (*n_planos < 24) {
+				float av = v < 0 ? -v : v;
+				bool hit = (av > plano_lat - 3e-5f && av < plano_lat + 3e-5f) ||
+				           (av > plano_lat_z - 3e-5f && av < plano_lat_z + 3e-5f) ||
+				           (av > plano_vert - 3e-5f && av < plano_vert + 3e-5f) ||
+				           (av > plano_vert_z - 3e-5f && av < plano_vert_z + 3e-5f);
+				if (hit && (uintptr_t)(p - *ultimo_plano) > 128) {
+					*ultimo_plano = p;
+					(*n_planos)++;
+					LogInfo("CULLSCAN PLANO? #%d = %.6f en %p (%s)\n", *n_planos, v, p,
+						cull_owner(p, who, sizeof(who)));
+					cull_dump(p, base, size, 12, 28);
+				}
+			}
+
+			// 3. matriz completa (normal o traspuesta), ancla en m00 bit-exacto
+			if (*(const unsigned *)p == needle0 && *n_mat < 8) {
+				const float *m = (const float *)p;
+				bool normal = memcmp(m, req->P, 44) == 0 &&
+					m[12] == req->P[12] && m[13] == req->P[13] && m[15] == req->P[15];
+				bool traspuesta = false;
+				if (normal) {
+					normal = m[11] == req->P[11] && m[14] == req->P[14];
+					traspuesta = !normal && m[11] == req->P[14] && m[14] == req->P[11];
+				}
+				if (normal || traspuesta) {
+					(*n_mat)++;
+					LogInfo("CULLSCAN MATRIZ #%d en %p (%s)%s\n", *n_mat, p,
+						cull_owner(p, who, sizeof(who)), traspuesta ? " [traspuesta]" : "");
+					cull_dump(p, base, size, 96, 48);
+				}
+			}
+			// 4. fov vertical suelto en rad / grados / tan-mitad
+			else if (*n_fov < 32 &&
+				((v > fov_rad - 0.0006f && v < fov_rad + 0.0006f) ||
+				 (v > fov_deg - 0.03f && v < fov_deg + 0.03f) ||
+				 (v > tan_half - 0.0004f && v < tan_half + 0.0004f))) {
+				(*n_fov)++;
+				LogInfo("CULLSCAN fov? #%d = %.6f en %p (%s)\n", *n_fov, v, p,
+					cull_owner(p, who, sizeof(who)));
+				cull_dump(p, base, size, 6, 10);
+			}
+		}
+	} __except (EXCEPTION_EXECUTE_HANDLER) {
+		return -1;
+	}
+	return 0;
+}
+
+static DWORD WINAPI cull_scan_thread(LPVOID)
+{
+	CullScanReq req = g_cullscan_req;
+	int n_mat = 0, n_fov = 0, n_av = 0;
+	int n_planos = 0, n_planos6 = 0, n_laxos = 0, n_pares = 0;
+	const uint8_t *ultimo_plano = NULL, *ultimo_p6 = NULL, *ultimo_par = NULL;
+	unsigned long long total = 0;
+
+	{
+		float fovH = 2.0f * atanf(req.aspect / req.m11);
+		float fovV = 2.0f * atanf(1.0f / req.m11);
+		LogInfo("CULLSCAN: empezando (v1.40 AoS+SoA, test de vitalidad). m00=%.6f "
+			"m11=%.6f near=%.4f aspect=%.6f | fovH juego=%.2f deg fovV=%.2f deg | "
+			"dots buscados: lat=%.5f vert=%.5f nearfar=-1\n",
+			req.m00, req.m11, req.nearz, req.aspect,
+			fovH * 57.29578f, fovV * 57.29578f,
+			-cosf(fovH), -cosf(fovV));
+	}
+
+  for (int intento = 1; intento <= 5; intento++) {
+	n_mat = n_fov = n_av = n_planos = n_planos6 = n_laxos = n_pares = 0;
+	ultimo_plano = ultimo_p6 = ultimo_par = NULL;
+	total = 0;
+
+	MEMORY_BASIC_INFORMATION mbi;
+	uint8_t *p = NULL;
+	while (VirtualQuery(p, &mbi, sizeof(mbi)) == sizeof(mbi)) {
+		uint8_t *sig = (uint8_t *)mbi.BaseAddress + mbi.RegionSize;
+		if (sig <= p)
+			break;
+		uint8_t *base = (uint8_t *)mbi.BaseAddress;
+		size_t size = mbi.RegionSize;
+		p = sig;
+
+		if (mbi.State != MEM_COMMIT)
+			continue;
+		if (mbi.Protect & (PAGE_GUARD | PAGE_NOACCESS))
+			continue;
+		DWORD prot = mbi.Protect & 0xFF;
+		// solo memoria escribible: los planos son dato vivo, no constantes
+		if (prot != PAGE_READWRITE && prot != PAGE_EXECUTE_READWRITE && prot != PAGE_WRITECOPY)
+			continue;
+		if (mbi.Type != MEM_PRIVATE && mbi.Type != MEM_IMAGE)
+			continue;
+
+		total += size;
+		// Por BLOQUES, no por region entera: el juego libera memoria mientras
+		// escaneamos y un AV abortaria todo el resto de la region. Asi se
+		// pierden 64 KB en vez de cientos de megas. Solape de 256 bytes para
+		// no partir una estructura al medio.
+		const size_t BLOQUE = 64 * 1024, SOLAPE = 256;
+		for (size_t o = 0; o < size; o += BLOQUE) {
+			size_t len = min(BLOQUE + SOLAPE, size - o);
+			if (len < 128)
+				break;
+			if (cull_scan_region(base + o, len, &req, &n_mat, &n_fov,
+					&n_planos, &n_planos6, &n_laxos, &n_pares, &ultimo_plano,
+					&ultimo_p6, &ultimo_par) < 0)
+				n_av++;
+		}
+	}
+
+	LogInfo("CULLSCAN: intento %d. %.1f GB | PLANOS6=%d PARES-LATERALES=%d | "
+		"planos-exactos=%d camaras-laxas=%d matrices=%d (AV: %d)\n",
+		intento, total / 1073741824.0, n_planos6, n_pares, n_planos, n_laxos,
+		n_mat, n_av);
+
+	if (n_planos6 > 0 || n_pares > 0)
+		break;
+	if (intento < 5) {
+		LogInfo("CULLSCAN: sin candidatos todavia. Reintento en 3s.\n");
+		Sleep(3000);
+	}
+  }
+
+	// control positivo: nuestra propia copia TIENE que aparecer (d3d11.dll)
+	LogInfo("CULLSCAN: g_triple_cam_buf (control, debe estar arriba) = %p\n",
+		(void *)g_triple_cam_buf);
+
+	// v1.40: primero medir QUIEN LATE (3s sin escribir nada), y recien despues
+	// habilitar la escritura — restringida a los sets vivos. El v1.38 escribia
+	// copias congeladas y por eso el efecto era parcial.
+	if (g_cull_nsets > 0) {
+		HANDLE hv = CreateThread(NULL, 0, cull_vitals_thread, NULL, 0, NULL);
+		if (hv) {
+			WaitForSingleObject(hv, 15000);
+			CloseHandle(hv);
+		}
+		HANDLE h = CreateThread(NULL, 0, cull_widen_thread, NULL, 0, NULL);
+		if (h)
+			CloseHandle(h);
+		else
+			LogInfo("CULLWIDEN: no pude lanzar el hilo aplicador.\n");
+	} else {
+		LogInfo("CULLWIDEN: ningun juego de planos clasificado; no hay nada "
+			"que escribir.\n");
+	}
+	LogInfo("CULLSCAN: terminado.\n");
+	return 0;
+}
+
+// ===== v1.36: aviso en pantalla del ojo virtual ==============================
+// Al ajustar el FOV a mano hace falta saber DONDE se esta parado: cuanto se ve,
+// cuanto dibuja el juego, y si sobra (o sea si los bordes de los laterales
+// quedan vacios). Sin esto, elegir el punto de compromiso es a ciegas.
+// Va como LOG_WARNING y no como LOG_NOTICE a proposito: NOTICE tiene
+// hide_in_release=true, o sea que fuera del modo hunting no se dibuja nunca y el
+// aviso no se veria. Es el mismo canal por el que salian las letras rojas del
+// "Error opening d3dx.ini", asi que sale en naranja y dura unos segundos.
+static volatile LONG g_hud_state = 0;
+
+static CommandListVariable *cl_global(const wchar_t *nombre)
+{
+	auto it = command_list_globals.find(nombre);
+	return (it != command_list_globals.end()) ? &it->second : NULL;
+}
+
+static DWORD WINAPI eye_hud_thread(LPVOID)
+{
+	CommandListVariable *v_eye = cl_global(L"$eye_d");
+	CommandListVariable *v_pw  = cl_global(L"$panel_w");
+	CommandListVariable *v_sa  = cl_global(L"$side_sa");
+	CommandListVariable *v_ca  = cl_global(L"$side_ca");
+	if (!v_eye || !v_pw || !v_sa || !v_ca) {
+		LogInfo("EYEHUD: faltan variables del ini; no se muestra el aviso.\n");
+		return 0;
+	}
+
+	float ultimo = -12345.0f;
+	while (true) {
+		float e = v_eye->fval;
+		if (e != ultimo) {
+			ultimo = e;
+			// Esquina externa del panel lateral, vista desde arriba, con el
+			// centro sobre el eje X y el ojo por delante.
+			float pw = v_pw->fval, sa = v_sa->fval, ca = v_ca->fval;
+			float xc = pw * 0.5f + pw * ca;
+			float yc = pw * sa;
+			// atan2 y no atan: con el ojo por delante de la esquina el angulo
+			// pasa de 90 grados y hay que seguir midiendolo bien.
+			float fov = 2.0f * atan2f(xc, e - yc) * 57.29578f;
+
+			float m00 = g_triple_cam_valid ? ((const float *)g_triple_cam_buf)[0] : 0.0f;
+			float fovj = (m00 > 0.0001f) ? 2.0f * atanf(1.0f / m00) * 57.29578f : 0.0f;
+
+			if (fovj > 1.0f) {
+				float sobra = fov - fovj;
+				LogOverlay(LOG_WARNING, "Ojo virtual %.0f cm  |  ves %.0f deg  |  "
+					"el juego dibuja %.0f deg  |  %s\n", e, fov, fovj,
+					(sobra > 1.0f)
+						? "sobran los bordes de los laterales"
+						: "sin bordes vacios");
+			} else {
+				LogOverlay(LOG_WARNING, "Ojo virtual %.0f cm  |  ves %.0f deg\n", e, fov);
+			}
+		}
+		Sleep(120);
+	}
+}
+
+// ===== v1.66: HOOK de BuildFrustum — abrir el culling de objetos en la FUENTE =
+//
+// El workflow del 2026-07-29 encontro la funcion generica del motor que arma
+// TODOS los frustums (Gribb-Hartmann): dirtrally2.exe+0x8B85D0 =
+// BuildFrustum(rcx=dst, rdx=viewProj). Verificado por desensamblado: escribe 6
+// planos float4 en dst[+0x00..+0x50] (orden near, far, IZQ+0x20, DER+0x30,
+// abajo+0x40, arriba+0x50) + 8 esquinas en +0x60. NO usa r8/r9 -> 2 argumentos.
+//
+// Esta es la FUENTE de los planos que RAM-A encontraba por firma y escribia
+// compitiendo contra el engine (carrera + fragilidad). Hookeando el RETORNO se
+// pisan los planos JUSTO despues de que el engine los escribe y ANTES de que el
+// culler (+0x8BCCD0, quadtree +0xA94840) los lea: determinista, sin carrera,
+// sin escaneo, sin test de vitalidad.
+//
+// Se abre SOLO el frustum de la camara principal (perspectiva, fovH ~100..175),
+// discriminando por el dot de las normales lateral izq/der: ortho (sombras) da
+// dot~-1, cubemap 90 da dot~0; la camara de manejo da dot ~0.17..0.997. Asi no
+// se tocan sombras/reflejos/envmap. Se abre copiando near->izq y far->der (el
+// mismo truco de RAM-A tipo-1, ya probado que trae arboles): el test lateral se
+// vuelve redundante -> horizontal abierto. Con bit 8 tambien el par vertical.
+// Controlado por $cull_widen (F8). Reversible: F8 a 0.
+
+typedef void (*BuildFrustum_t)(void *dst, float *viewProj);
+static BuildFrustum_t g_bf_orig = NULL;
+static CommandListVariable *g_bf_var = NULL;
+static volatile LONG g_bf_var_init = 0;
+static volatile LONG g_bf_hooked = 0;
+// RVA (dentro del exe) del call site de render que SI hay que abrir. 0 = modo
+// diagnostico: NO se abre nada, solo se loguean los call sites. El intento de
+// abrir TODOS los frustums de fovH plausible (v1.66) crasheo el juego (AV en
+// +0x4B2B9D): BuildFrustum lo llaman ~32 sitios (streaming, queries espaciales,
+// visibilidad) y abrir uno que un consumidor asume acotado -> overflow. Hay que
+// abrir SOLO el frustum de la vista de render principal, identificado por su
+// return address.
+static uintptr_t g_bf_target_ret = 0;
+static uintptr_t g_bf_exe_base = 0;
+
+// Pisa los planos laterales con SEH. En helper aparte SIN objetos C++: el __try
+// no convive con el iterador del unordered_map en la misma funcion (C2712).
+static void bf_abrir(float *p, int modo)
+{
+	__try {
+		// normales laterales: izq = p[8..10], der = p[12..14] (ya normalizadas).
+		// dot = -cos(fovH). Solo perspectiva de manejo (fovH ~100..175):
+		float dot = p[8] * p[12] + p[9] * p[13] + p[10] * p[14];
+		if (dot > 0.17f && dot < 0.997f) {
+			// horizontal: izq = copia de near, der = copia de far -> el test
+			// lateral queda redundante y pasa todo en horizontal.
+			for (int k = 0; k < 4; k++) p[8 + k] = p[0 + k];
+			for (int k = 0; k < 4; k++) p[12 + k] = p[4 + k];
+			if (modo & 8) {	// tambien vertical (= modo 8 de RAM-A)
+				for (int k = 0; k < 4; k++) p[16 + k] = p[0 + k];
+				for (int k = 0; k < 4; k++) p[20 + k] = p[4 + k];
+			}
+		}
+	} __except (EXCEPTION_EXECUTE_HANDLER) {}
+}
+
+// DIAGNOSTICO: loguea cada call site distinto (return address -> RVA del exe) con
+// el fovH de su frustum. Con eso se identifica cual es el de la vista de render.
+// SEH y sin objetos C++ (C2712). dot(izq,der)=-cos(fovH) -> fovH=acos(-dot).
+static void bf_diag(void *ret, const float *p)
+{
+	static void *vistos[64];
+	static int n = 0;
+	static volatile LONG lk = 0;
+	__try {
+		float dot = p[8] * p[12] + p[9] * p[13] + p[10] * p[14];
+		while (InterlockedCompareExchange(&lk, 1, 0) != 0)
+			YieldProcessor();
+		bool nuevo = true;
+		for (int i = 0; i < n; i++)
+			if (vistos[i] == ret) { nuevo = false; break; }
+		if (nuevo && n < 64)
+			vistos[n++] = ret;
+		else
+			nuevo = false;
+		InterlockedExchange(&lk, 0);
+		if (nuevo) {
+			float c = -dot; if (c > 1) c = 1; if (c < -1) c = -1;
+			float fovH = acosf(c) * 57.29578f;
+			uintptr_t rva = (uintptr_t)ret - g_bf_exe_base;
+			LogInfo("BFDIAG call site dirtrally2.exe+0x%llX : fovH=%.1f dot=%.3f\n",
+				(unsigned long long)rva, fovH, dot);
+		}
+	} __except (EXCEPTION_EXECUTE_HANDLER) {}
+}
+
+static void Hooked_BuildFrustum(void *dst, float *viewProj)
+{
+	void *ret = _ReturnAddress();
+	g_bf_orig(dst, viewProj);	// el engine arma los 6 planos + 8 esquinas
+
+	bf_diag(ret, (const float *)dst);	// siempre: mapear los call sites
+
+	// Abrir SOLO el call site de render ya identificado (g_bf_target_ret).
+	// Mientras sea 0 esto es inerte -> el juego se comporta normal (no crashea).
+	if (g_bf_target_ret == 0)
+		return;
+	if (((uintptr_t)ret - g_bf_exe_base) != g_bf_target_ret)
+		return;
+
+	if (!g_bf_var_init) {
+		auto it = command_list_globals.find(L"$cull_widen");
+		if (it != command_list_globals.end())
+			g_bf_var = &it->second;
+		InterlockedExchange(&g_bf_var_init, 1);
+	}
+	int modo = g_bf_var ? (int)g_bf_var->fval : 0;
+	if (modo != 0)
+		bf_abrir((float *)dst, modo);
+}
+
+// Instala el hook una sola vez. Verifica el prologo por bytes antes de tocar:
+// si el exe fuera otra version, 0x8B85D0 no seria BuildFrustum -> NO hookear
+// (evita colgar el juego con una version distinta). Prologo esperado:
+// 48 8B C4  mov rax,rsp ; 48 89 58 08  mov [rax+8],rbx ; 57 push rdi ;
+// 48 81 EC C0 00 00 00  sub rsp,0xC0.
+static void triple_install_buildfrustum_hook()
+{
+	if (InterlockedCompareExchange(&g_bf_hooked, 1, 0) != 0)
+		return;
+	HMODULE base = GetModuleHandleA(NULL);
+	if (!base) {
+		LogInfo("BFHOOK: no pude obtener la base del exe.\n");
+		return;
+	}
+	g_bf_exe_base = (uintptr_t)base;
+	uint8_t *fn = (uint8_t *)base + 0x8B85D0;
+	static const uint8_t prologo[] = {
+		0x48, 0x8B, 0xC4, 0x48, 0x89, 0x58, 0x08, 0x57,
+		0x48, 0x81, 0xEC, 0xC0, 0x00, 0x00, 0x00 };
+	bool ok = true;
+	__try {
+		for (size_t i = 0; i < sizeof(prologo); i++)
+			if (fn[i] != prologo[i]) { ok = false; break; }
+	} __except (EXCEPTION_EXECUTE_HANDLER) { ok = false; }
+	if (!ok) {
+		LogInfo("BFHOOK: el prologo en exe+0x8B85D0 NO coincide con BuildFrustum "
+			"(otra version del juego?). No se hookea; queda el RAM-A.\n");
+		return;
+	}
+	SIZE_T id = 0;
+	DWORD e = cHookMgr.Hook(&id, (void **)&g_bf_orig, fn, Hooked_BuildFrustum);
+	if (e == ERROR_SUCCESS)
+		LogInfo("BFHOOK: BuildFrustum hookeado en %p. El culling de objetos se "
+			"abre en la fuente (determinista, sin RAM-A).\n", (void *)fn);
+	else
+		LogInfo("BFHOOK: fallo el hook de BuildFrustum (err 0x%x).\n", e);
+}
+
+// Called from HackerContext when the game writes a constant buffer that looks
+// like the main perspective camera (cb3 = CameraParamsConstantBuffer). Captures
+// it CPU-side so no GPU readback is needed.
+// ===========================================================================
+// IDENTIFICACION DEL AUTO POR SU MALLA (v1.36)
+//
+// El problema: el usuario quiere una postura de asiento por camara Y por auto,
+// pero nada de lo que veniamos leyendo distingue el auto. Medido: las camaras de
+// DiRT tienen los mismos parametros en todos los autos (se probo con dos autos y
+// no aparecio ni una firma nueva).
+//
+// Por que la MALLA y no una textura: 3Dmigoto hashea los recursos por CONTENIDO,
+// asi que la textura del auto serviria... hasta que el usuario le cambia la
+// pintura, y ahi el mismo auto pasa a parecer otro. Lo hizo notar el propio
+// usuario. La geometria del interior, en cambio, es la misma pintes como pintes.
+//
+// De donde sale el shader: de una caza del usuario. Al saltear
+// d0d1ddd09d064e71 el interior del auto se pone negro, y ese shader visita 19
+// mallas distintas (los pedazos del habitaculo: volante, tablero, puertas...) y
+// solo 2 texturas en el registro 0 — un shader generico de pista tendria
+// cientos, asi que es del auto. La caza se hace UNA sola vez en la vida del
+// proyecto, no una por auto: de aca en mas el mod aprende cada auto solo.
+//
+// La huella es el hash de la malla MAS GRANDE que dibuje ese shader en el frame
+// (la carroceria del habitaculo). Se elige la mas grande y no el conjunto entero
+// porque el conjunto cambia con el culling de las piezas chicas, mientras que la
+// pieza principal se dibuja siempre.
+//
+// CONTEXTOS DIFERIDOS (regla 5): esto corre en los 7 contextos del juego y el
+// "maximo del frame" es un global sin candado. Una carrera puede hacer que un
+// frame suelto publique la malla equivocada. Es tolerable a proposito: el que
+// consume la huella exige que se mantenga varios frames seguidos antes de
+// hacerle caso, igual que con las camaras. Un candado por draw costaria mas que
+// el problema que evita.
+// ===========================================================================
+#define TRIPLE_CAR_VS 0xd0d1ddd09d064e71ULL
+
+void TripleTrackCarMesh(UINT64 vs_hash, uint32_t ib_hash, UINT index_count)
+{
+	if (!ib_hash || vs_hash != TRIPLE_CAR_VS)
+		return;
+
+	static unsigned frame = 0xFFFFFFFF;
+	static UINT mejor_n = 0;
+	static uint32_t mejor_ib = 0;
+
+	if (G->frame_no != frame) {
+		// Cierre del frame anterior: se publica el ganador.
+		if (mejor_ib) {
+			// Se recortan los 24 bits bajos para que entre EXACTO en un float32
+			// (la mantisa son 24 bits). Si se publicara el hash completo, el
+			// redondeo podria juntar dos autos distintos en el mismo valor.
+			if (G->iniParams.size() >= 9)
+				G->iniParams[8].x = (float)(mejor_ib & 0x00FFFFFF);
+
+			// Log deduplicado: una linea por malla distinta. Con esto se ve si la
+			// huella es estable dentro de un auto y si cambia entre autos.
+			static uint32_t vistos[64];
+			static int nvistos = 0;
+			bool nuevo = true;
+			for (int k = 0; k < nvistos; k++)
+				if (vistos[k] == mejor_ib) { nuevo = false; break; }
+			if (nuevo && nvistos < 64) {
+				vistos[nvistos++] = mejor_ib;
+				LogInfo("TRIPLE car mesh #%d: ib=%08x indices=%u -> huella=%.0f\n",
+					nvistos - 1, mejor_ib, mejor_n,
+					(double)(mejor_ib & 0x00FFFFFF));
+			}
+		}
+		frame = G->frame_no;
+		mejor_n = 0;
+		mejor_ib = 0;
+	}
+
+	if (index_count > mejor_n) {
+		mejor_n = index_count;
+		mejor_ib = ib_hash;
+	}
+}
+
+// LISTA NEGRA de camaras del motor (v1.41). Los tres m11 de las camaras que NO
+// deben recibir el triple: menu principal, menu del garage y la orbita del
+// garage. Son CONSTANTES del juego, bit-exactas en toda sesion — a diferencia
+// del rango de "camaras de conduccion" que se uso antes, que en realidad media
+// el slider de FOV del usuario (m11 = 1/tan(fovV/2), ajustable POR CAMARA en
+// DiRT) y por eso se rompio dos veces. La tolerancia 0.01 en espacio m11 es
+// generosa para constantes exactas y chica frente a la camara real mas cercana
+// medida (cockpit 3.732 vs menu2 3.546: distancia 0.186).
+// El ASM de los shaders hace la misma comparacion por su cuenta (fila 5 de
+// IniParams, publicada por [Present]); esta copia es para los flags x3/x9.
+static inline bool tt_es_camara_de_menu(float m11)
+{
+	const float negras[3] = { 4.272611f, 3.545733f, 1.000000f };
+	for (int i = 0; i < 3; i++) {
+		float d = m11 - negras[i];
+		if (d < 0) d = -d;
+		if (d < 0.01f)
+			return true;
+	}
+	return false;
+}
+
+void TripleCaptureCameraCB(const void *data, unsigned size)
+{
+	// v1.69: hook de BuildFrustum ABANDONADO. Crasheo el juego en la MISMA
+	// direccion (+0x4B2B9D) tanto abriendo planos (v1.66) como en modo inerte
+	// que no tocaba nada (v1.68) -> el problema es HOOKEAR la funcion en si:
+	// Nektra no puede reubicar su prologo (mov rax,rsp + escrituras al shadow
+	// space del caller) sin corromper el frame -> el consumidor +0x4B26F0
+	// crashea. Los objetos quedan cubiertos por RAM-A (ya robusto con el fix de
+	// vitalidad). El codigo del hook queda abajo, inerte, como referencia.
+	// triple_install_buildfrustum_hook();
+
+	if (!data || size < 208 || size > sizeof(g_triple_cam_buf))
+		return;
+	const float *f = (const float*)data;
+	float aspect = (f[0] != 0.0f) ? (f[5] / f[0]) : 0.0f;
+
+	// Gate: solo la camara PRINCIPAL (perspectiva m33~0 + aspecto de triple).
+	//
+	// El rango era 4.5-6.5, hecho a medida del rig del autor (3x 2560x1440 =
+	// 5.39). Eso dejaba afuera EN SILENCIO a cualquier otro triple: tres
+	// ultrawide 21:9 dan 7.1, tres pantallas 5:4 dan 3.75. Esos usuarios
+	// instalaban el mod y no les pasaba absolutamente nada, sin un solo aviso.
+	// Aparecio probando otra cosa (bajar la resolucion para ensanchar el
+	// culling): el aspecto se fue a 7.18 y el mod dejo de ver camaras.
+	//
+	// Ahora cubre de 3x 5:4 (3.75) a 3x 32:9 (10.67) con margen. El piso 3.6
+	// sigue excluyendo los espejos del juego, que son 768x256 = 3.0 exacto, y
+	// el envmap, que es 1.0.
+	if (f[51] < 0.5f && aspect > 3.6f && aspect < 12.0f) {
+		memcpy(g_triple_cam_buf, data, size);
+		g_triple_cam_size = size;
+		g_triple_cam_valid = true;
+
+		// v1.26: DETECCION DE MENU. La camara de fondo del frontend tiene una
+		// firma inconfundible (m11 = 4.2726 / 3.5457; las de conduccion van de
+		// 1.9 a 2.5 y el garage es 1.0). Si en los ultimos frames se escribio
+		// una camara con m11 > 3.0, publicamos x3 = 1 y el d3dx.ini pasa el
+		// triple a passthrough -> los menus se ven como el juego normal.
+		// (Identificada por el analisis del volcado: el fondo 3D del menu usa
+		// los MISMOS shaders de mundo; la UI 2D nunca declara cb3.)
+		{
+			// v1.41: el umbral "m11 > 3.0" dejo de servir — el cockpit del
+			// usuario tiene FOV de 30 grados = m11 3.732, o sea que manejar
+			// contaba como "menu". Se pasa al mismo criterio que el resto: la
+			// LISTA NEGRA de camaras del motor (constantes bit-exactas que el
+			// usuario no puede tocar). Ver tt_es_camara_de_menu().
+			static unsigned g_triple_menu_frame = 0x80000000;
+			if (tt_es_camara_de_menu(f[5]))
+				g_triple_menu_frame = G->frame_no;
+			if (G->iniParams.size() >= 4)
+				G->iniParams[3].x = (G->frame_no - g_triple_menu_frame <= 3) ? 1.0f : 0.0f;
+		}
+
+		// v1.17: publicar m11 (escala vertical de la proyeccion del juego) en
+		// IniParams[3].w para que el d3dx.ini pueda calcular solo la distancia de
+		// ojo EXACTA: eye_d = 19.9688 * m11. En ese valor KXc==m00 y KYc==m11, o
+		// sea que la NDC y el depth del monitor CENTRAL son identicos a los del
+		// juego -> todo lo que se calcula en espacio de pantalla (sombras, AO)
+		// queda correcto en el centro sin parchear nada.
+		// Se escribe directo en G->iniParams porque las EXPRESIONES del ini lo leen
+		// del lado CPU (no hace falta subirlo a la textura para esto).
+		//
+		// v1.35 — ARREGLO: NO publicar las camaras que no son de conduccion.
+		//
+		// Esta funcion se queda con LA ULTIMA camara de pantalla completa del
+		// frame, y una medicion (volcado del cbuffer entero, 2026-07-31) mostro
+		// que el juego escribe DIEZ por frame y que la ultima es SIEMPRE la del
+		// frontend: m11 = 4.272610 / near = -0.2, identica en las 8 vistas del
+		// juego. O sea que w3 nunca fue el FOV de la vista que se esta viendo —
+		// era un valor constante de otra camara. Por eso la deteccion de vista
+		// por m11 fallaba de forma total y silenciosa: todas las vistas
+		// aprendian la misma clave.
+		//
+		// Las de conduccion salen de la anteultima (cap=8 en la medicion) y SI
+		// se distinguen: 2.02780, 2.19430, 2.65694, 2.86356, y son bit-estables
+		// mientras la vista se mantiene. El umbral 3.0 es el mismo que ya usa la
+		// deteccion de menu de arriba, asi que no introduce una constante nueva:
+		// las de conduccion medidas van de 1.57 a 2.87, y las de frontend son
+		// 3.55 y 4.27.
+		//
+		// Se publica tambien el NEAR en w7 (que estaba libre) porque el m11 solo
+		// no alcanza: hay dos vistas que comparten m11 = 2.02780 y solo difieren
+		// en el near (-0.11436 vs -0.05198). El par (m11, near) separa cinco de
+		// las ocho vistas; las tres que faltan comparten los DOS valores con otra
+		// (las dos de persecucion entre si, y las dos interiores cercanas entre
+		// si), asi que no hay nada en este buffer que pueda separarlas.
+		// Ventaja extra del near: no se mueve con el slider de FOV del juego,
+		// que es lo que corre al m11 (regla 9).
+		if (f[5] <= 3.0f) {
+			if (G->iniParams.size() >= 4)
+				G->iniParams[3].w = f[5];
+			if (G->iniParams.size() >= 8)
+				G->iniParams[7].w = f[14];
+
+			// v1.38 — LO QUE NECESITA EL PARCHE DEL AGUA.
+			//
+			// El agua (oceano, rio, lago) NO proyecta con la matriz de camara
+			// de cb3 sino con `modelViewProj` de cb0, asi que nuestros parches
+			// no la alcanzaban: se dibujaba UNA vez sin corregir a lo ancho de
+			// los tres monitores mientras el mundo se triplicaba. De ahi los
+			// tres sintomas que reporto el usuario — el oceano corrido de
+			// lugar, el "no hay nada" al mirar de costado, y el agua pasando
+			// por encima de los objetos (su profundidad no coincide con la del
+			// mundo corregido).
+			//
+			// Esos shaders no pueden auto-calibrarse como los demas: el truco
+			// de recuperar m00/m11 de las filas de la matriz funciona porque la
+			// vista es una rotacion pura, pero en modelViewProj esta el MODELO
+			// horneado adentro y las filas ya no dan la escala de proyeccion.
+			// Asi que se les publica desde aca.
+			if (G->iniParams.size() >= 9) {
+				G->iniParams[8].z = f[0];    // m00
+				G->iniParams[8].w = f[5];    // m11
+			}
+
+			// Y ademas: "en este frame se vio una camara DE CONDUCCION".
+			//
+			// Es el gate que evita repetir el error que rompio los menus. Los
+			// otros grupos se protegen leyendo cb3 para saber si la camara esta
+			// en la lista blanca; el agua no tiene cb3, asi que necesita la
+			// misma respuesta por otro lado.
+			//
+			// Tiene que ser "se vio EN EL FRAME", no "la ultima que se vio": la
+			// medicion del cbuffer mostro que el juego escribe hasta diez
+			// camaras de pantalla completa por frame y que la ULTIMA es siempre
+			// la del frontend, incluso manejando. Un flag basado en la ultima
+			// diria "menu" todo el tiempo — es exactamente el error que hacia
+			// que w3 nunca fuera el FOV de la vista.
+			//
+			// En los menus no aparece ninguna camara en el rango de conduccion
+			// (el frontend usa 4.27 y 3.55, el garage 1.00), asi que el flag da
+			// 0 y el agua queda sin tocar, igual que hoy.
+			{
+				// v1.41: mismo cambio que en el resto — de rango (dependia del
+				// slider de FOV del usuario) a lista negra de camaras del motor.
+				// Ademas se exige perspectiva real (m22 < -0.9): en el log
+				// aparecio una camara ORTOGRAFICA colandose por el gate de
+				// captura (m22 == m00, near -1209) y con lista negra en vez de
+				// rango habria contado como "de conduccion".
+				static unsigned g_frame_conduccion = 0x80000000;
+				if (!tt_es_camara_de_menu(f[5]) && f[10] < -0.9f)
+					g_frame_conduccion = G->frame_no;
+				if (G->iniParams.size() >= 10)
+					G->iniParams[9].x =
+						(G->frame_no - g_frame_conduccion <= 1) ? 1.0f : 0.0f;
+			}
+		}
+		// Calibration: log each DISTINCT camera (by m11/near) so we can read the
+		// real driving-camera FOV and regenerate the region matrices to match.
+		// Se recuerdan TODAS las firmas ya vistas, no solo la ultima. Y la
+		// deduplicacion es por CUBETA (m11 a 0.02, near a 0.05), no por igualdad:
+		// el juego tiene camaras con FOV ANIMADO (el zoom de entrada, el FOV por
+		// velocidad de la persecucion) que derivan en pasos de ~0.002 — con
+		// igualdad estricta una sola de esas se comia los 64 lugares en el garage
+		// y las camaras de conduccion no se registraban nunca. Paso dos veces:
+		// con el tope de 16 y con el de 64. La cubeta de 0.02 convierte una rampa
+		// de 2.29→2.42 en ~7 entradas en vez de 62.
+		// Ademas se dice si cada una cae en la lista negra (menu/garage), que
+		// es lo que decide si esa vista queda passthrough o recibe el triple.
+		static float vistas_m11[96];
+		static float vistas_m23[96];
+		static int triple_logcount = 0;
+		bool ya_vista = false;
+		for (int k = 0; k < triple_logcount; k++) {
+			float dm11 = f[5] - vistas_m11[k]; if (dm11 < 0) dm11 = -dm11;
+			float dm23 = f[14] - vistas_m23[k]; if (dm23 < 0) dm23 = -dm23;
+			if (dm11 <= 0.02f && dm23 <= 0.05f) { ya_vista = true; break; }
+		}
+		if (!ya_vista && triple_logcount < 96) {
+			bool negra = tt_es_camara_de_menu(f[5]);
+			// las camaras interiores (cockpit/capo/piso) se distinguen por el
+			// near chico; marcarlas hace el log legible de un vistazo
+			bool interior = (f[14] > -0.16f && f[14] < -0.02f);
+			LogInfo("TRIPLE camera #%d: m00=%.6f m11=%.6f aspect=%.3f m22=%.6f"
+				" m23(near)=%.6f %s %s\n",
+				triple_logcount, f[0], f[5], aspect, f[10], f[14],
+				interior ? "[INTERIOR]" : "[exterior]",
+				negra ? "LISTA NEGRA (menu/garage: passthrough)"
+				      : "corregida (triple)");
+			vistas_m11[triple_logcount] = f[5];
+			vistas_m23[triple_logcount] = f[14];
+			triple_logcount++;
+		}
+
+		// Aviso del ojo virtual: una sola vez por sesion, en cuanto hay camara.
+		if (InterlockedCompareExchange(&g_hud_state, 1, 0) == 0) {
+			HANDLE h = CreateThread(NULL, 0, eye_hud_thread, NULL, 0, NULL);
+			if (h)
+				CloseHandle(h);
+		}
+
+		// v1.37: pedir el cazaplanos UNA vez por sesion, cuando hay camara de
+		// CONDUCCION (near ~0.1) con el mismo m11 durante ~100 capturas
+		// seguidas: la proyeccion esta quieta y sirve de firma. Las carreras
+		// entre hilos de captura son benignas; el lanzamiento del hilo esta
+		// serializado por el InterlockedCompareExchange.
+		if (g_cullscan_state == 0 && f[14] > -0.15f && f[14] < -0.05f) {
+			static float cull_last_m11 = 0.0f;
+			static int cull_estable = 0;
+			float d = f[5] - cull_last_m11;
+			if (d > -1e-6f && d < 1e-6f) {
+				cull_estable++;
+			} else {
+				cull_estable = 0;
+				cull_last_m11 = f[5];
+			}
+			if (cull_estable >= 100 &&
+				InterlockedCompareExchange(&g_cullscan_state, 1, 0) == 0) {
+				memcpy(g_cullscan_req.P, f, 64);
+				g_cullscan_req.m00 = f[0];
+				g_cullscan_req.m11 = f[5];
+				g_cullscan_req.nearz = -f[14];
+				g_cullscan_req.aspect = aspect;
+				HANDLE h = CreateThread(NULL, 0, cull_scan_thread, NULL, 0, NULL);
+				if (h)
+					CloseHandle(h);
+				else
+					g_cullscan_state = 0;
+			}
+		}
+	}
+}
+
+// v1.50: la posicion del ojo en coordenadas de mundo, para el volcado del
+// pasto (que vive en HackerContext.cpp y no ve estos globales). Es cb3[8], el
+// mismo valor que el VS del pasto resta a cada instancia antes de proyectar.
+// Devuelve 0 si todavia no hay camara capturada.
+int TripleGetCameraPos(float *out3)
+{
+	if (!g_triple_cam_valid || g_triple_cam_size < 144)
+		return 0;
+	const float *f = (const float *)g_triple_cam_buf;
+	out3[0] = f[32];
+	out3[1] = f[33];
+	out3[2] = f[34];
+	return 1;
+}
+
+// R = A * B, all column-major 4x4 (m[col*4+row]).
+static void triple_mat_mul(float *R, const float *A, const float *B)
+{
+	for (int col = 0; col < 4; col++) {
+		for (int row = 0; row < 4; row++) {
+			float s = 0.0f;
+			for (int k = 0; k < 4; k++)
+				s += A[k * 4 + row] * B[col * 4 + k];
+			R[col * 4 + row] = s;
+		}
+	}
+}
+
+// Inversa general 4x4 (column-major m[col*4+row], igual convencion que el juego:
+// cada registro del cbuffer es una COLUMNA, como se ve en el ASM
+// "clip = cb3[9]*x + cb3[10]*y + cb3[11]*z + cb3[12]").
+// Devuelve false si es singular.
+static bool triple_mat_inverse(float *out, const float *m)
+{
+	float inv[16];
+
+	inv[0]  =  m[5]*m[10]*m[15] - m[5]*m[11]*m[14] - m[9]*m[6]*m[15]
+	         + m[9]*m[7]*m[14] + m[13]*m[6]*m[11] - m[13]*m[7]*m[10];
+	inv[4]  = -m[4]*m[10]*m[15] + m[4]*m[11]*m[14] + m[8]*m[6]*m[15]
+	         - m[8]*m[7]*m[14] - m[12]*m[6]*m[11] + m[12]*m[7]*m[10];
+	inv[8]  =  m[4]*m[9]*m[15] - m[4]*m[11]*m[13] - m[8]*m[5]*m[15]
+	         + m[8]*m[7]*m[13] + m[12]*m[5]*m[11] - m[12]*m[7]*m[9];
+	inv[12] = -m[4]*m[9]*m[14] + m[4]*m[10]*m[13] + m[8]*m[5]*m[14]
+	         - m[8]*m[6]*m[13] - m[12]*m[5]*m[10] + m[12]*m[6]*m[9];
+	inv[1]  = -m[1]*m[10]*m[15] + m[1]*m[11]*m[14] + m[9]*m[2]*m[15]
+	         - m[9]*m[3]*m[14] - m[13]*m[2]*m[11] + m[13]*m[3]*m[10];
+	inv[5]  =  m[0]*m[10]*m[15] - m[0]*m[11]*m[14] - m[8]*m[2]*m[15]
+	         + m[8]*m[3]*m[14] + m[12]*m[2]*m[11] - m[12]*m[3]*m[10];
+	inv[9]  = -m[0]*m[9]*m[15] + m[0]*m[11]*m[13] + m[8]*m[1]*m[15]
+	         - m[8]*m[3]*m[13] - m[12]*m[1]*m[11] + m[12]*m[3]*m[9];
+	inv[13] =  m[0]*m[9]*m[14] - m[0]*m[10]*m[13] - m[8]*m[1]*m[14]
+	         + m[8]*m[2]*m[13] + m[12]*m[1]*m[10] - m[12]*m[2]*m[9];
+	inv[2]  =  m[1]*m[6]*m[15] - m[1]*m[7]*m[14] - m[5]*m[2]*m[15]
+	         + m[5]*m[3]*m[14] + m[13]*m[2]*m[7] - m[13]*m[3]*m[6];
+	inv[6]  = -m[0]*m[6]*m[15] + m[0]*m[7]*m[14] + m[4]*m[2]*m[15]
+	         - m[4]*m[3]*m[14] - m[12]*m[2]*m[7] + m[12]*m[3]*m[6];
+	inv[10] =  m[0]*m[5]*m[15] - m[0]*m[7]*m[13] - m[4]*m[1]*m[15]
+	         + m[4]*m[3]*m[13] + m[12]*m[1]*m[7] - m[12]*m[3]*m[5];
+	inv[14] = -m[0]*m[5]*m[14] + m[0]*m[6]*m[13] + m[4]*m[1]*m[14]
+	         - m[4]*m[2]*m[13] - m[12]*m[1]*m[6] + m[12]*m[2]*m[5];
+	inv[3]  = -m[1]*m[6]*m[11] + m[1]*m[7]*m[10] + m[5]*m[2]*m[11]
+	         - m[5]*m[3]*m[10] - m[9]*m[2]*m[7] + m[9]*m[3]*m[6];
+	inv[7]  =  m[0]*m[6]*m[11] - m[0]*m[7]*m[10] - m[4]*m[2]*m[11]
+	         + m[4]*m[3]*m[10] + m[8]*m[2]*m[7] - m[8]*m[3]*m[6];
+	inv[11] = -m[0]*m[5]*m[11] + m[0]*m[7]*m[9] + m[4]*m[1]*m[11]
+	         - m[4]*m[3]*m[9] - m[8]*m[1]*m[7] + m[8]*m[3]*m[5];
+	inv[15] =  m[0]*m[5]*m[10] - m[0]*m[6]*m[9] - m[4]*m[1]*m[10]
+	         + m[4]*m[2]*m[9] + m[8]*m[1]*m[6] - m[8]*m[2]*m[5];
+
+	float det = m[0]*inv[0] + m[1]*inv[4] + m[2]*inv[8] + m[3]*inv[12];
+	if (det > -1e-20f && det < 1e-20f)
+		return false;
+	det = 1.0f / det;
+	for (int i = 0; i < 16; i++)
+		out[i] = inv[i] * det;
+	return true;
+}
+
+// Construye P_region (view-space del juego -> clip de la region i) desde la
+// geometria viva (constantes K en IniParams) y el near REAL de la camara.
+// Deducida de compute_matrices.py; equivale exactamente a lo que hace el ASM:
+//   laterales: x = KA*Xv + s*KB*Zv ; y = KC*Yv ; w = s*sa*Xv - ca*Zv ; z = w - near
+//   centro:    x = KXc*Xv ; y = KYc*Yv ; w = -Zv ; z = w - near
+// con s = -1 para LEFT y +1 para RIGHT (Zv = -w, de ahi los signos).
+// Fracciones de cada region dentro del ancho total (2560/7760, 2600/7760, ...).
+// Se usan para calcular el scissor a partir del ancho REAL del render target, de
+// modo que funcione tambien en pases a resolucion reducida (la mascara de sombras
+// puede rendarizarse a media resolucion).
+// v1.29: fracciones de region PARAMETRIZADAS. [Present] las publica en las filas
+// 6/7 de IniParams a partir de $mon_px/$bezel_px (z6 = fin izq, w6 = inicio
+// centro, x7 = fin centro, y7 = inicio der). Si aun no estan publicadas (arranque
+// temprano) se usa la tabla historica de 2560/40 como respaldo.
+static void triple_get_frac(int region, float *lo, float *hi);
+
+static const float TRIPLE_FRAC[3][2] = {
+	{ 0.0000000f, 0.3298969f },   // LEFT   0 .. 2560
+	{ 0.3350515f, 0.6649485f },   // CENTER 2600 .. 5160
+	{ 0.6701031f, 1.0000000f },   // RIGHT  5200 .. 7760
+};
+
+static void triple_get_frac(int region, float *lo, float *hi)
+{
+	if (G->iniParams.size() >= 8 && G->iniParams[6].z > 0.0f) {
+		float fl  = G->iniParams[6].z;   // fin de la region izquierda
+		float fcl = G->iniParams[6].w;   // inicio del centro
+		float fcr = G->iniParams[7].x;   // fin del centro
+		float frl = G->iniParams[7].y;   // inicio de la derecha
+		switch (region) {
+			case 0: *lo = 0.0f; *hi = fl;   return;
+			case 1: *lo = fcl;  *hi = fcr;  return;
+			default: *lo = frl; *hi = 1.0f; return;
+		}
+	}
+	*lo = TRIPLE_FRAC[region][0];
+	*hi = TRIPLE_FRAC[region][1];
+}
+
+static void ProcessParamRTSize(CommandListState *state);
+
+// Consulta ROBUSTA del tamano del render target.
+// ProcessParamRTSize (la que alimenta la variable rt_width del ini) solo acepta
+// vistas D3D11_RTV_DIMENSION_TEXTURE2D / TEXTURE2DMS y sale dejando rt_width en
+// -1 para cualquier otra (p.ej. vistas de ARRAY). Esa es la explicacion mas
+// probable de que el gate "rt_width >= N" nunca se cumpliera en el pase de la
+// mascara de sombras. Aca miramos el RECURSO, no la vista, asi que sirve para
+// arrays y cualquier dimension de vista.
+static bool triple_get_rt_size(CommandListState *state, float *w, float *h)
+{
+	ID3D11RenderTargetView *view = NULL;
+	ID3D11Resource *res = NULL;
+	D3D11_RESOURCE_DIMENSION dim;
+	bool ok = false;
+
+	state->mOrigContext1->OMGetRenderTargets(1, &view, NULL);
+	if (!view)
+		return false;
+	view->GetResource(&res);
+	view->Release();
+	if (!res)
+		return false;
+
+	res->GetType(&dim);
+	if (dim == D3D11_RESOURCE_DIMENSION_TEXTURE2D) {
+		D3D11_TEXTURE2D_DESC d;
+		((ID3D11Texture2D*)res)->GetDesc(&d);
+		*w = (float)d.Width;
+		*h = (float)d.Height;
+		ok = (d.Width > 0);
+	}
+	res->Release();
+	return ok;
+}
+
+static void triple_build_pregion(float *P, int region, float nearz)
+{
+	memset(P, 0, 16 * sizeof(float));
+	if (region == 1) {                 // CENTER
+		P[0]  = TRIPLE_KXC;            // col0.row0
+		P[5]  = TRIPLE_KYC;            // col1.row1
+		P[10] = -1.0f;                 // col2.row2
+		P[11] = -1.0f;                 // col2.row3
+		P[14] = -nearz;                // col3.row2
+	} else {
+		float s = (region == 0) ? -1.0f : 1.0f;
+		P[0]  = TRIPLE_KA;             // col0.row0
+		P[2]  = s * TRIPLE_SA;         // col0.row2
+		P[3]  = s * TRIPLE_SA;         // col0.row3
+		P[5]  = TRIPLE_KC;             // col1.row1
+		P[8]  = s * TRIPLE_KB;         // col2.row0
+		P[10] = -TRIPLE_CA;            // col2.row2
+		P[11] = -TRIPLE_CA;            // col2.row3
+		P[14] = -nearz;                // col3.row2
+	}
+}
+
+void TripleRegionCommand::run(CommandListState *state)
+{
+	ID3D11DeviceContext1 *ctx = state->mOrigContext1;
+	ID3D11Device1 *dev = state->mOrigDevice1;
+
+	// Log de entrada INCONDICIONAL: si el pase no se corrige, este log dice por que
+	// (si no aparece, es que el command list ni siquiera se ejecuto).
+	// triple_scissor = restore: reponer los scissor rects del JUEGO desde la
+	// copia sombra (v1.26). Si el juego no habia seteado ninguno, dejamos el
+	// rect neutro de 16384 que no puede recortar nada.
+	if (scissor_only == 2) {
+		HackerContext *hc = state->mHackerContext;
+		if (hc && hc->mTripleScissorShadowCount > 0) {
+			ctx->RSSetScissorRects(hc->mTripleScissorShadowCount, hc->mTripleScissorShadow);
+		} else {
+			D3D11_RECT r;
+			r.left = 0; r.top = 0; r.right = 16384; r.bottom = 16384;
+			ctx->RSSetScissorRects(1, &r);
+		}
+		return;
+	}
+
+	// triple_scissor: solo el rectangulo del tercio, como FRACCION del render
+	// target real. Independiente de la resolucion. No toca ningun cbuffer.
+	if (scissor_only) {
+		float rw = 0.0f, rh = 0.0f;
+		if (region >= 0 && region < 3 && triple_get_rt_size(state, &rw, &rh)) {
+			float flo, fhi;
+			triple_get_frac(region, &flo, &fhi);
+			D3D11_RECT r;
+			r.left   = (LONG)(rw * flo + 0.5f);
+			r.right  = (LONG)(rw * fhi + 0.5f);
+			r.top    = 0;
+			r.bottom = (LONG)(rh + 0.5f);
+			ctx->RSSetScissorRects(1, &r);
+		}
+		return;
+	}
+
+	// Se loguea UNA vez por cada combinacion distinta de (id de shader, tamano de
+	// RT), asi se ve exactamente CUALES de los 15 pases se estan corrigiendo, a que
+	// resolucion, y con que near de camara — sin inundar el log.
+	if (region == 0 && G->iniParams.size() >= 4) {
+		float lw = -1.0f, lh = -1.0f;
+		triple_get_rt_size(state, &lw, &lh);
+		int id = (int)G->iniParams[3].z;
+		const float *cf = (const float*)g_triple_cam_buf;
+		static int seen[32] = { 0 };
+		static int nseen = 0;
+		int key = id * 100000 + (int)lw;
+		bool nuevo = true;
+		for (int k = 0; k < nseen; k++) if (seen[k] == key) { nuevo = false; break; }
+		if (nuevo && nseen < 32) {
+			seen[nseen++] = key;
+			LogInfo("TRIPLE pase #%d: rt=%.0fx%.0f  near_cam=%.4f m00=%.5f m11=%.5f  cam_valid=%d\n",
+				id, lw, lh, g_triple_cam_valid ? -cf[14] : 0.0f,
+				g_triple_cam_valid ? cf[0] : 0.0f, g_triple_cam_valid ? cf[5] : 0.0f,
+				(int)g_triple_cam_valid);
+		}
+	}
+
+	if (!g_triple_cam_valid)
+		return;  // main camera not captured yet
+
+	// v1.13: NADA de Get* aca. Los metodos Get* de ID3D11DeviceContext no son
+	// fiables en contextos diferidos (DiRT usa 7) — fue la causa exacta del
+	// desastre de v1.5b. Para restaurar usamos g_triple_orig_cb, una copia sin
+	// modificar de la camara capturada.
+
+	// Recompute the 3 region cbs at most once per frame from the captured camera.
+	// Only UpdateSubresource / bind here (both valid on deferred contexts).
+	if (g_triple_frame != G->frame_no) {
+		if (g_triple_cb_size != g_triple_cam_size) {
+			for (int i = 0; i < 3; i++) {
+				if (g_triple_region_cb[i]) { g_triple_region_cb[i]->Release(); g_triple_region_cb[i] = NULL; }
+			}
+			if (g_triple_orig_cb) { g_triple_orig_cb->Release(); g_triple_orig_cb = NULL; }
+			g_triple_cb_size = g_triple_cam_size;
+
+			D3D11_BUFFER_DESC rd;
+			rd.ByteWidth = g_triple_cam_size;
+			rd.Usage = D3D11_USAGE_DEFAULT;
+			rd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+			rd.CPUAccessFlags = 0;
+			rd.MiscFlags = 0;
+			rd.StructureByteStride = 0;
+			for (int i = 0; i < 3; i++)
+				dev->CreateBuffer(&rd, NULL, &g_triple_region_cb[i]);
+			dev->CreateBuffer(&rd, NULL, &g_triple_orig_cb);
+		}
+
+		if (g_triple_region_cb[0] && G->iniParams.size() >= 3) {
+			const float *f = (const float*)g_triple_cam_buf;
+			// La camara original: projection en f[0..15], inverseProj en f[16..31],
+			// relativeViewProjection en f[36..51]. Todas column-major (cada registro
+			// del cbuffer es una COLUMNA).
+			const float *Pg   = f;
+			const float *IPg  = f + 16;
+			const float *RVPg = f + 36;
+			float nearz = -f[14];               // m23 = -near
+			if (nearz <= 0.0f) nearz = 0.1f;    // guarda
+
+			float Pgi[16];
+			bool ok_pg = triple_mat_inverse(Pgi, Pg);
+
+			// Copia intacta para restaurar sin Get*.
+			if (g_triple_orig_cb)
+				ctx->UpdateSubresource(g_triple_orig_cb, 0, NULL, g_triple_cam_buf, 0, 0);
+
+			for (int i = 0; i < 3 && ok_pg; i++) {
+				char rbuf[512];
+				memcpy(rbuf, g_triple_cam_buf, g_triple_cam_size);
+				float *rf = (float*)rbuf;
+
+				float Preg[16], Pregi[16], Mi[16], Mii[16], tmp[16];
+				triple_build_pregion(Preg, i, nearz);
+				if (!triple_mat_inverse(Pregi, Preg))
+					continue;
+
+				// REGLA UNIVERSAL (no depende de que mapea cada matriz):
+				// nuestra correccion en el shader equivale a clip_i = M_i * clip_juego,
+				// con M_i = P_region_i * inv(P_juego). Entonces:
+				//   toda matriz que produce CLIP  -> se premultiplica por M_i
+				//   toda matriz que consume CLIP  -> se posmultiplica por inv(M_i)
+				triple_mat_mul(Mi,  Preg, Pgi);    // M_i        = P_region * inv(P_juego)
+				triple_mat_mul(Mii, Pg,   Pregi);  // inv(M_i)   = P_juego  * inv(P_region)
+
+				// v1.14: SOLO se reemplaza inverseProj. projection y
+				// relativeViewProjection se dejan INTACTAS. Esto es esencial:
+				//  - el parche ASM del vertex shader calcula la correccion leyendo
+				//    cb3[9..12] (relativeViewProjection). Si tambien la
+				//    cambiaramos, aplicaria la correccion DOS VECES. Eso es
+				//    exactamente lo que hizo fracasar el intento v2 (menus
+				//    aplastados, auto negro, vegetacion desgarrada).
+				//  - para reconstruir posicion desde el depth alcanza con
+				//    inverseProj, que es lo unico que leen esos pixel shaders.
+				// Radio de dano minimo: si la camara capturada fuera la
+				// equivocada, solo se degrada la reconstruccion (que hoy ya
+				// esta mal), nunca la geometria.
+				(void)Preg; (void)Mi; (void)RVPg;
+				triple_mat_mul(tmp, IPg, Mii);     // inverseProj_i = inverseProj * inv(M_i)
+				memcpy(rf + 16, tmp, 64);
+
+				ctx->UpdateSubresource(g_triple_region_cb[i], 0, NULL, rbuf, 0, 0);
+
+				static int trdbg = 0;
+				if (trdbg < 3) {
+					LogInfo("TRIPLE region %d: near=%.6f KA=%.5f KB=%.5f KC=%.5f KXc=%.5f KYc=%.5f sa=%.5f ca=%.5f\n",
+						i, nearz, TRIPLE_KA, TRIPLE_KB, TRIPLE_KC,
+						TRIPLE_KXC, TRIPLE_KYC, TRIPLE_SA, TRIPLE_CA);
+					LogInfo("            M_i col0=(%.4f %.4f %.4f %.4f) invM col0=(%.4f %.4f %.4f %.4f)\n",
+						Mi[0], Mi[1], Mi[2], Mi[3], Mii[0], Mii[1], Mii[2], Mii[3]);
+					trdbg++;
+				}
+			}
+			g_triple_valid = ok_pg;
+			g_triple_frame = G->frame_no;
+		}
+	}
+
+	if (g_triple_valid && region >= 0 && region < 3 && g_triple_region_cb[region]) {
+		ctx->VSSetConstantBuffers(3, 1, &g_triple_region_cb[region]);
+		ctx->PSSetConstantBuffers(3, 1, &g_triple_region_cb[region]);
+
+		// Scissor PROPORCIONAL al render target real de este pase. Asi funciona
+		// tanto a resolucion completa como a media (la mascara de sombras puede
+		// renderizarse reducida) sin hardcodear pixeles.
+		float rw = 0.0f, rh = 0.0f;
+		if (triple_get_rt_size(state, &rw, &rh)) {
+			float flo, fhi;
+			triple_get_frac(region, &flo, &fhi);
+			D3D11_RECT r;
+			r.left   = (LONG)(rw * flo + 0.5f);
+			r.right  = (LONG)(rw * fhi + 0.5f);
+			r.top    = 0;
+			r.bottom = (LONG)(rh + 0.5f);
+			ctx->RSSetScissorRects(1, &r);
+
+			static int trrt = 0;
+			if (trrt < 6) {
+				LogInfo("TRIPLE fullscreen pass: rt=%.0fx%.0f region=%d scissor=%ld..%ld\n",
+					rw, rh, region, r.left, r.right);
+				trrt++;
+			}
+		}
+	}
+}
+
+// ---- triple_params: texturas de IniParams pre-armadas por region ------------
+// 4 juegos (region 0/1/2 y 3 = passthrough), POR CONTEXTO (thread_local, la
+// leccion de los contextos diferidos). Se refrescan una vez por frame desde
+// G->iniParams — el mismo contenido que subiria el flush normal — con la unica
+// diferencia de que row0.x = region fija.
+static thread_local ID3D11Texture1D *g_triple_par_tex[4] = { NULL, NULL, NULL, NULL };
+static thread_local ID3D11ShaderResourceView *g_triple_par_srv[4] = { NULL, NULL, NULL, NULL };
+static thread_local UINT g_triple_par_size = 0;
+static thread_local unsigned g_triple_par_frame = 0xFFFFFFFF;
+
+void TripleParamsCommand::run(CommandListState *state)
+{
+	ID3D11DeviceContext1 *ctx = state->mOrigContext1;
+	ID3D11Device1 *dev = state->mOrigDevice1;
+	UINT n = (UINT)G->iniParams.size();
+
+	if (!n || G->IniParamsReg < 0)
+		return;
+
+	if (g_triple_par_size != n) {
+		for (int i = 0; i < 4; i++) {
+			if (g_triple_par_srv[i]) { g_triple_par_srv[i]->Release(); g_triple_par_srv[i] = NULL; }
+			if (g_triple_par_tex[i]) { g_triple_par_tex[i]->Release(); g_triple_par_tex[i] = NULL; }
+		}
+		g_triple_par_size = n;
+
+		D3D11_TEXTURE1D_DESC desc;
+		memset(&desc, 0, sizeof(desc));
+		desc.Width = n;
+		desc.MipLevels = 1;
+		desc.ArraySize = 1;
+		desc.Format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+		desc.Usage = D3D11_USAGE_DEFAULT;
+		desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+		for (int i = 0; i < 4; i++) {
+			if (FAILED(dev->CreateTexture1D(&desc, NULL, &g_triple_par_tex[i])))
+				return;
+			if (FAILED(dev->CreateShaderResourceView(g_triple_par_tex[i], NULL, &g_triple_par_srv[i]))) {
+				g_triple_par_tex[i]->Release(); g_triple_par_tex[i] = NULL;
+				return;
+			}
+		}
+		g_triple_par_frame = 0xFFFFFFFF;  // forzar refresco
+	}
+
+	if (g_triple_par_frame != G->frame_no && g_triple_par_tex[0]) {
+		std::vector<DirectX::XMFLOAT4> buf(G->iniParams);
+		for (int i = 0; i < 4; i++) {
+			buf[0].x = (float)i;  // 0,1,2 = region ; 3 = passthrough
+			ctx->UpdateSubresource(g_triple_par_tex[i], 0, NULL, buf.data(), n * 16, 0);
+		}
+		g_triple_par_frame = G->frame_no;
+	}
+
+	// y3 == 1 solo en triple normal ($triple_on == 1, lo publica [Present]).
+	// En diagnostico (2) o apagado se bindea la passthrough (x = 3).
+	int idx = region;
+	if (n > 3 && G->iniParams[3].y < 0.5f)
+		idx = 3;
+
+	// DIAGNOSTICO (2026-08-07, "el triple no corrige en cockpit/capo/piso").
+	// Este es EL contador que separa las dos causas posibles de "se ve como
+	// vanilla": si las cuentas de r0/r1/r2 son ~0 mientras se maneja, el command
+	// list del redibujo NO corre (gate de rt_width/triple_on); si son altas pero
+	// todo cae en r3, la maquinaria corre en passthrough (y3). Sin esto, ambas
+	// se ven identicas en pantalla y en el log.
+	// Contadores globales sin candado a proposito: es diagnostico, una carrera
+	// entre contextos pierde alguna cuenta y no importa.
+	{
+		static unsigned cnt[4];
+		static unsigned ultimo_frame = 0;
+		if (idx >= 0 && idx <= 3)
+			cnt[idx]++;
+		if (G->frame_no - ultimo_frame >= 600) {
+			ultimo_frame = G->frame_no;
+			LogInfo("TRIPLE params (ultimos ~600 frames): r0=%u r1=%u r2=%u"
+				" passthrough=%u  y3=%.0f\n",
+				cnt[0], cnt[1], cnt[2], cnt[3],
+				(n > 3) ? G->iniParams[3].y : -1.0f);
+			cnt[0] = cnt[1] = cnt[2] = cnt[3] = 0;
+		}
+	}
+
+	if (g_triple_par_srv[idx]) {
+		ctx->VSSetShaderResources((UINT)G->IniParamsReg, 1, &g_triple_par_srv[idx]);
+		ctx->DSSetShaderResources((UINT)G->IniParamsReg, 1, &g_triple_par_srv[idx]);
+	}
+}
+
+void TripleRestoreCommand::run(CommandListState *state)
+{
+	// Rebind la copia INTACTA de la camara (mismo contenido que tenia el juego en
+	// este frame). No usamos Get*/save por ser inseguro en contextos diferidos.
+	if (g_triple_valid && g_triple_orig_cb) {
+		state->mOrigContext1->VSSetConstantBuffers(3, 1, &g_triple_orig_cb);
+		state->mOrigContext1->PSSetConstantBuffers(3, 1, &g_triple_orig_cb);
+	}
+	// v1.26: restaurar los rects del JUEGO (copia sombra); si no habia, el rect
+	// neutro de 16384 que no puede recortar nada (leccion v1.18: el rect de
+	// tijera es estado global que sobrevive al pase — 16384 = max textura D3D11).
+	{
+		HackerContext *hc = state->mHackerContext;
+		if (hc && hc->mTripleScissorShadowCount > 0) {
+			state->mOrigContext1->RSSetScissorRects(hc->mTripleScissorShadowCount, hc->mTripleScissorShadow);
+		} else {
+			D3D11_RECT r;
+			r.left = 0; r.top = 0; r.right = 16384; r.bottom = 16384;
+			state->mOrigContext1->RSSetScissorRects(1, &r);
+		}
+	}
+}
