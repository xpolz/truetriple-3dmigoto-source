+static bool bf_es_camara_principal(const float *p, float *fovh_out,
+	float *fovv_out)
+{
+	__try {
+		if (!g_triple_cam_valid || g_triple_cam_size < 208)
+			return false;
+		const float *cam = (const float *)g_triple_cam_buf;
+		float m00 = fabsf(cam[0]), m11 = fabsf(cam[5]);
+		if (m00 < 0.05f || m11 < 0.05f)
+			return false;
+		float dh = p[8]*p[12] + p[9]*p[13] + p[10]*p[14];
+		float dv = p[16]*p[20] + p[17]*p[21] + p[18]*p[22];
+		float ch = -dh, cv = -dv;
+		if (ch > 1) ch = 1; if (ch < -1) ch = -1;
+		if (cv > 1) cv = 1; if (cv < -1) cv = -1;
+		float fh = acosf(ch) * 57.2957795f;
+		float fv = acosf(cv) * 57.2957795f;
+		float want_h = 2.0f * atanf(1.0f / m00) * 57.2957795f;
+		float want_v = 2.0f * atanf(1.0f / m11) * 57.2957795f;
+		if (fovh_out) *fovh_out = fh;
+		if (fovv_out) *fovv_out = fv;
+		return fabsf(fh - want_h) < 1.25f && fabsf(fv - want_v) < 1.25f;
+	} __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+
+// Solo la geometria de los 6 planos, sin comparar contra nada: FOV horizontal y vertical.
+static bool bf_fov_de_planos(const float *p, float *fh, float *fv)
+{
+	__try {
+		float dh = p[8]*p[12] + p[9]*p[13] + p[10]*p[14];
+		float dv = p[16]*p[20] + p[17]*p[21] + p[18]*p[22];
+		float ch = -dh, cv = -dv;
+		if (ch > 1) ch = 1; if (ch < -1) ch = -1;
+		if (cv > 1) cv = 1; if (cv < -1) cv = -1;
+		*fh = acosf(ch) * 57.2957795f;
+		*fv = acosf(cv) * 57.2957795f;
+		return true;
+	} __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+
+// ctx+0x1E98: el modo del contexto de render, el que elige la rama de 3C7AA0
+// (0 = camino normal BA58D0 -> BC9540). Ver docs/CULLING-GHIDRA-2026-09-05.md.
+// -1 = punteros nulos, -2 = no legible.
+static int bf_modo_ctx()
+{
+	__try {
+		if (!g_bf_exe_base) return -1;
+		uintptr_t renderer = *(uintptr_t *)(g_bf_exe_base + 0x159DD90);
+		if (!renderer) return -1;
+		uintptr_t ctx = *(uintptr_t *)(renderer + 0x2050);
+		if (!ctx) return -1;
+		return *(int *)(ctx + 0x1E98);
+	} __except (EXCEPTION_EXECUTE_HANDLER) { return -2; }
+}
