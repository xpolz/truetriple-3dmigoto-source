+// Bit 16: abre todo sitio cuyo FOV coincida con la camara capturada (experimento del
+// 2026-09-04; el log de esa corrida solo mostro coincidencias con la camara del garage,
+// 159x90, y registraba cada sitio una sola vez). Bit 32: abre SOLO CS10, sin compuerta
+// de FOV: el sitio identifica la vista por construccion. Los dos cuentan por sitio.
+// Texto humano del modo, bit por bit. Lo usan el aviso de cambio y la linea permanente.
+static float tt_hfov_objetivo();
+static void bf_describir_modo(int modo, char *buf, size_t n)
+{
+	if (modo & 1024) { _snprintf_s(buf, n, _TRUNCATE, "CS10 360 grados alcance conservado"); return; }
+	if (modo & 512) { _snprintf_s(buf, n, _TRUNCATE, "DIAGNOSTICO CS10 caja 250m 360 grados"); return; }
+	if (modo & 256) { _snprintf_s(buf, n, _TRUNCATE, "DIAGNOSTICO CS10 horizontal+vertical 178"); return; }
+	if (modo == 0) { _snprintf_s(buf, n, _TRUNCATE, "frustum original (sin tocar)"); return; }
+	int k = 0;
+	buf[0] = 0;
+	if (modo & 64) {
+		float h = tt_hfov_objetivo();
+		if (h < -2.5f) k += _snprintf_s(buf + k, n - k, _TRUNCATE, "%sgancho PASANTE puro", k ? " + " : "");
+		else if (h < -1.5f) k += _snprintf_s(buf + k, n - k, _TRUNCATE, "%sgancho PASANTE + pila 0xFF", k ? " + " : "");
+		else if (h < 0.0f) k += _snprintf_s(buf + k, n - k, _TRUNCATE, "%sgancho PASANTE + pila 0x00", k ? " + " : "");
+		else if (h <= 0.0f) k += _snprintf_s(buf + k, n - k, _TRUNCATE, "%sgancho sin cambiar la matriz", k ? " + " : "");
+		else k += _snprintf_s(buf + k, n - k, _TRUNCATE, "%smatriz %.0f deg", k ? " + " : "", h);
+	}
+	if (modo & 128) k += _snprintf_s(buf + k, n - k, _TRUNCATE, "%scbuffer SIN restaurar (GPU ve la ancha)", k ? " + " : "");
+	if (modo & 32) k += _snprintf_s(buf + k, n - k, _TRUNCATE, "%sCS10 abierto 178", k ? " + " : "");
+	if (modo & 16) k += _snprintf_s(buf + k, n - k, _TRUNCATE, "%sFOV-match 178", k ? " + " : "");
+	if (modo & 15) k += _snprintf_s(buf + k, n - k, _TRUNCATE, "%sRAM-A %d", k ? " + " : "", modo & 15);
+}
