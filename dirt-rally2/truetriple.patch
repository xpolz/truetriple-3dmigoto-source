+// Llamado desde HackerSwapChain::Present despues de dibujar el overlay y antes del Present real.
+void TripleAutoCapturaTick(IDXGISwapChain *sc, ID3D11Device *dev, ID3D11DeviceContext *ctx)
+{
+	(void)dev;
+	float pedido = tt_auto_leer_var();
+	ULONGLONG ahora = GetTickCount64();
+	LONG estado = InterlockedCompareExchange(&g_auto_estado, 0, 0);
+	if (estado != 1) {
+		if (pedido < 0.5f) {
+			if (estado == 2) InterlockedExchange(&g_auto_estado, 0);   // lista para otra vuelta
+			return;
+		}
+		if (estado == 2) return;      // termino y la variable sigue en 1: esperar a que baje
+		// arrancar
+		SYSTEMTIME st; GetLocalTime(&st);
+		CreateDirectoryW(L"E:\\Nueva carpeta\\TrueTriple-Culling-Test\\capturas-auto", NULL);
+		_snwprintf_s(g_auto_dir, _countof(g_auto_dir), _TRUNCATE,
+			L"E:\\Nueva carpeta\\TrueTriple-Culling-Test\\capturas-auto\\%04d-%02d-%02d_%02d%02d%02d",
+			st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond);
+		CreateDirectoryW(g_auto_dir, NULL);
+		g_auto_paso = 0; g_auto_t0 = ahora; g_auto_aviso_hasta = 0;
+		g_auto_guardadas = 0; g_auto_fallidas = 0;
+		tt_auto_poner_estado(g_auto_pasos[0].modo, g_auto_pasos[0].hfov);
+		InterlockedExchange(&g_auto_estado, 1);
+		LogInfo("AUTO: corrida automatica ARRANCA (%d pasos de %d s) -> %S (frame %u)\n",
+			(int)_countof(g_auto_pasos), TT_AUTO_SEG, g_auto_dir, G ? G->frame_no : 0u);
+		LogOverlay(LOG_WARNING, "AUTO: arranca. Quedate quieto; toca el acelerador solo cuando lo pida.\n");
+		return;
+	}
+	// corriendo
+	if (pedido < 0.5f) {
+		InterlockedExchange(&g_auto_estado, 0);
+		LogInfo("AUTO: abortada por el usuario en el paso %d.\n", g_auto_paso + 1);
+		LogOverlay(LOG_WARNING, "AUTO: abortada.\n");
+		return;
+	}
+	if (ahora - g_auto_t0 < (ULONGLONG)TT_AUTO_SEG * 1000ULL)
+		return;
+	// el estado se sostuvo TT_AUTO_SEG s: capturar y pasar al siguiente
+	tt_auto_capturar(sc, ctx, g_auto_pasos[g_auto_paso].nombre, g_auto_paso);
+	g_auto_paso++;
+	g_auto_aviso_hasta = ahora + 4000;
+	if (g_auto_paso >= (int)_countof(g_auto_pasos)) {
+		InterlockedExchange(&g_auto_estado, 2);
+		if (g_auto_var) g_auto_var->fval = 0.0f;
+		LogInfo("AUTO: corrida automatica TERMINADA: %d guardadas, %d fallidas, en %S\n",
+			g_auto_guardadas, g_auto_fallidas, g_auto_dir);
+		LogOverlay(LOG_WARNING, "AUTO: LISTO. %d capturas guardadas. Ya podes salir.\n", g_auto_guardadas);
+		return;
+	}
+	g_auto_t0 = ahora;
+	tt_auto_poner_estado(g_auto_pasos[g_auto_paso].modo, g_auto_pasos[g_auto_paso].hfov);
+	LogInfo("AUTO: paso %d/%d -> modo %d hfov %.0f (%s) (frame %u)\n", g_auto_paso + 1,
+		(int)_countof(g_auto_pasos), g_auto_pasos[g_auto_paso].modo, g_auto_pasos[g_auto_paso].hfov,
+		g_auto_pasos[g_auto_paso].nombre, G ? G->frame_no : 0u);
+}
