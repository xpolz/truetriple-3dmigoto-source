+// Segunda linea del overlay (verde, grande): que paso va, cuanto falta, y cuando tocar el acelerador.
+void TripleAutoCapturaOSD(wchar_t *buf, size_t n)
+{
+	buf[0] = 0;
+	LONG estado = InterlockedCompareExchange(&g_auto_estado, 0, 0);
+	ULONGLONG ahora = GetTickCount64();
+	if (estado == 1 && g_auto_paso >= 0 && g_auto_paso < (int)_countof(g_auto_pasos)) {
+		int faltan = (int)((ULONGLONG)TT_AUTO_SEG * 1000ULL - (ahora - g_auto_t0) + 999) / 1000;
+		if (faltan < 0) faltan = 0;
+		int k = _snwprintf_s(buf, n, _TRUNCATE, L"AUTO paso %d/%d: %S | faltan %d s | QUEDATE QUIETO",
+			g_auto_paso + 1, (int)_countof(g_auto_pasos), g_auto_pasos[g_auto_paso].nombre, faltan);
+		if (k > 0 && ahora < g_auto_aviso_hasta)
+			_snwprintf_s(buf + k, n - k, _TRUNCATE, L"  >>> CAPTURA %d GUARDADA: TOCA EL ACELERADOR AHORA <<<", g_auto_paso);
+	} else if (estado == 2) {
+		_snwprintf_s(buf, n, _TRUNCATE, L"AUTO LISTO: %d capturas guardadas (%d fallidas). Ya podes salir.",
+			g_auto_guardadas, g_auto_fallidas);
+	} else if (tt_auto_leer_var() >= 0.0f && g_auto_var) {
+		_snwprintf_s(buf, n, _TRUNCATE, L"AUTO: ubicate, quedate quieto y apreta la tecla de corrida automatica");
+	}
+}
