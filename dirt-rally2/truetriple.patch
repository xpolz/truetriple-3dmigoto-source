+
+// triple_region = 0 | 1 | 2
+// Custom addition (triple-monitor): overrides the camera constant buffer (b3 =
+// CameraParamsConstantBuffer) with a per-region corrected version, so BOTH the
+// vertex position AND pixel-shader reconstruction (depth->position, shadows, fog)
+// use the same corrected projection. Reads the game's cb3 once per frame, applies
+// the precomputed per-region matrices, and binds the result. No shader patching.
+class TripleRegionCommand : public CommandListCommand {
+public:
+	wstring ini_section;
+	int region;  // 0 = left, 1 = center, 2 = right
+	// scissor_only = 1 -> el comando "triple_scissor": SOLO fija el rectangulo de
+	// tijera del tercio, calculado como FRACCION del render target real, sin tocar
+	// ningun constant buffer. Sirve para que la configuracion no dependa de la
+	// resolucion (antes los rectangulos estaban escritos a mano en pixeles).
+	int scissor_only;
+
+	TripleRegionCommand(wstring section, int r, int so = 0) :
+		ini_section(section), region(r), scissor_only(so)
+	{}
+
+	void run(CommandListState*) override;
+};
+
+// triple_params = 0|1|2 : bindea a t<IniParamsReg> (VS+DS) una textura PRE-ARMADA
+// identica a IniParams pero con x = region. Sustituye el "x = $regN" del ini, que
+// obligaba a un Map(WRITE_DISCARD) de la textura de IniParams antes de CADA
+// redibujo (~2400 actualizaciones de recurso GPU por frame). Bindear un SRV es
+// casi gratis; las 4 texturas (0,1,2 y 3=passthrough) se actualizan UNA vez por
+// frame y por contexto. Si y3 == 0 (triple en modo diagnostico o apagado) se
+// bindea siempre la passthrough.
+class TripleParamsCommand : public CommandListCommand {
+public:
+	wstring ini_section;
+	int region;
+
+	TripleParamsCommand(wstring section, int r) :
+		ini_section(section), region(r)
+	{}
+
+	void run(CommandListState*) override;
+};
+
+// triple_restore
+// Re-binds the game's original camera cb3 (saved by triple_region region 0) after
+// the 3 per-region redraws, so subsequent unmatched draws (car body, cockpit, etc.)
+// are not corrupted by the leftover per-region camera override.
+class TripleRestoreCommand : public CommandListCommand {
+public:
+	wstring ini_section;
+
+	TripleRestoreCommand(wstring section) :
+		ini_section(section)
+	{}
+
+	void run(CommandListState*) override;
+};
