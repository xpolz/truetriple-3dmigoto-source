+			// v1.98: y el ROLIDO, por la misma via. f[53] es la componente Y del
+			// vector DERECHA de relativeView (fila 0, row_major en 52..55): cuanto
+			// se sale de la horizontal el eje lateral de la camara, o sea el seno
+			// del rolido. Mismo criterio que el cabeceo: el seno y no el coseno,
+			// porque cerca de 0 grados es el que se mueve.
+			//
+			// La investigacion que lo motiva: iRacing, ACC y el mod VR de RBR
+			// estabilizan el rolido ADEMAS del cabeceo — para varios es el eje
+			// principal del lock-to-horizon. Nosotros solo teniamos cabeceo, y el
+			// autor reportaba la mitad del horizonte quieta y la otra bailando.
+			G->iniParams[9].y = f[53];
+		}
