diff --git b/DirectX11/TrueTripleCmaaLock.cpp b/DirectX11/TrueTripleCmaaLock.cpp
new file mode 100644
index 0000000..f475c45
--- /dev/null
+++ b/DirectX11/TrueTripleCmaaLock.cpp
@@ -0,0 +1,246 @@
+#include "TrueTripleCmaaLock.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace TrueTripleCmaaLock
+{
+namespace
+{
+constexpr DWORD kExpectedTimestamp = 0x605CBAE3;
+constexpr DWORD kExpectedSizeOfImage = 0x02255000;
+constexpr std::size_t kMaxPatchBytes = 4;
+
+struct Site
+{
+	std::uintptr_t rva;
+	std::size_t size;
+	std::uint8_t original[kMaxPatchBytes];
+	std::uint8_t patched[kMaxPatchBytes];
+};
+
+// Force the two-part native representation CMAA=(MSAA sample count 0, flag 1)
+// in both the startup path and the ChangeMSAASettings receiver.
+constexpr Site kSites[] = {
+	{ 0x004735DA, 3, { 0x41, 0x8B, 0xFC }, { 0x33, 0xFF, 0x90 } },
+	{ 0x004735D6, 2, { 0x8B, 0xF8 }, { 0x33, 0xFF } },
+	{ 0x009C8DF1, 3, { 0xC6, 0x01, 0x00 }, { 0xC6, 0x01, 0x01 } },
+	{ 0x009C8E5C, 3, { 0x0F, 0x94, 0xC0 }, { 0xB0, 0x01, 0x90 } },
+	{ 0x0047E24C, 3, { 0x8B, 0x52, 0x10 }, { 0x31, 0xD2, 0x90 } },
+	{ 0x0047E276, 4, { 0x0F, 0xB6, 0x53, 0x14 }, { 0xB2, 0x01, 0x90, 0x90 } },
+};
+
+volatile LONG g_state = 0; // 0 absent, 1 installed, 2 transition/unknown
+
+bool IsExpectedExecutable(std::uint8_t *base)
+{
+	__try {
+		auto dos = reinterpret_cast<const IMAGE_DOS_HEADER *>(base);
+		if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0 ||
+			dos->e_lfanew > 0x100000)
+			return false;
+		auto nt = reinterpret_cast<const IMAGE_NT_HEADERS64 *>(base + dos->e_lfanew);
+		if (nt->Signature != IMAGE_NT_SIGNATURE ||
+			nt->FileHeader.Machine != IMAGE_FILE_MACHINE_AMD64 ||
+			nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC ||
+			nt->FileHeader.TimeDateStamp != kExpectedTimestamp ||
+			nt->OptionalHeader.SizeOfImage != kExpectedSizeOfImage)
+			return false;
+		for (const Site &site : kSites)
+			if (site.rva + site.size > nt->OptionalHeader.SizeOfImage)
+				return false;
+		return true;
+	} __except (EXCEPTION_EXECUTE_HANDLER) {
+		return false;
+	}
+}
+
+bool Matches(const std::uint8_t *base, const Site &site, bool patched)
+{
+	__try {
+		return std::memcmp(base + site.rva,
+			patched ? site.patched : site.original, site.size) == 0;
+	} __except (EXCEPTION_EXECUTE_HANDLER) {
+		return false;
+	}
+}
+
+bool AllMatch(const std::uint8_t *base, bool patched)
+{
+	for (const Site &site : kSites)
+		if (!Matches(base, site, patched))
+			return false;
+	return true;
+}
+
+bool RestoreProtection(void *address, std::size_t size, DWORD protection)
+{
+	DWORD ignored = 0;
+	if (VirtualProtect(address, size, protection, &ignored))
+		return true;
+	return VirtualProtect(address, size, protection, &ignored) != FALSE;
+}
+
+struct WriteOutcome
+{
+	Result result;
+	bool changed;
+};
+
+bool RollBackOne(std::uint8_t *base, const Site &site, bool install_direction,
+	DWORD original_protection)
+{
+	auto address = base + site.rva;
+	const auto *before = install_direction ? site.patched : site.original;
+	const auto *after = install_direction ? site.original : site.patched;
+	DWORD ignored_current = 0;
+	if (!VirtualProtect(address, site.size, PAGE_EXECUTE_READWRITE, &ignored_current))
+		return false;
+
+	bool known = std::memcmp(address, before, site.size) == 0 ||
+		std::memcmp(address, after, site.size) == 0;
+	if (known)
+		std::memcpy(address, after, site.size);
+	bool flushed = known && FlushInstructionCache(GetCurrentProcess(), address,
+		site.size) != FALSE;
+	bool restored = RestoreProtection(address, site.size, original_protection);
+	return known && flushed && restored &&
+		std::memcmp(address, after, site.size) == 0;
+}
+
+WriteOutcome WriteOne(std::uint8_t *base, const Site &site, bool install_direction)
+{
+	auto address = base + site.rva;
+	const auto *before = install_direction ? site.original : site.patched;
+	const auto *after = install_direction ? site.patched : site.original;
+	DWORD old_protection = 0;
+	if (!VirtualProtect(address, site.size, PAGE_EXECUTE_READWRITE, &old_protection))
+		return { Result::ProtectFailed, false };
+
+	if (std::memcmp(address, before, site.size) != 0) {
+		bool restored = RestoreProtection(address, site.size, old_protection);
+		return { restored ? Result::UnexpectedBytes
+			: Result::ProtectionRestoreFailed, false };
+	}
+
+	std::memcpy(address, after, site.size);
+	bool flushed = FlushInstructionCache(GetCurrentProcess(), address,
+		site.size) != FALSE;
+	bool restored = RestoreProtection(address, site.size, old_protection);
+	bool exact = std::memcmp(address, after, site.size) == 0;
+	if (flushed && restored && exact)
+		return { install_direction ? Result::Installed : Result::Removed, true };
+
+	Result first_failure = !flushed ? Result::CacheFlushFailed
+		: !restored ? Result::ProtectionRestoreFailed : Result::ConcurrentChange;
+	if (RollBackOne(base, site, install_direction, old_protection))
+		return { first_failure, false };
+	return { Result::RollbackFailed, exact };
+}
+
+bool RollBackCompleted(std::uint8_t *base, std::size_t count,
+	bool install_direction)
+{
+	bool ok = true;
+	for (std::size_t i = count; i > 0; --i) {
+		const Site &site = kSites[i - 1];
+		// WriteOne in the opposite direction has its own protection, flush and
+		// rollback handling. Continue through every site even after one failure.
+		WriteOutcome outcome = WriteOne(base, site, !install_direction);
+		if (outcome.result != (install_direction ? Result::Removed : Result::Installed))
+			ok = false;
+	}
+	return ok && AllMatch(base, !install_direction);
+}
+
+void SetStateFromSites(const std::uint8_t *base)
+{
+	if (AllMatch(base, false))
+		InterlockedExchange(&g_state, 0);
+	else if (AllMatch(base, true))
+		InterlockedExchange(&g_state, 1);
+	else
+		InterlockedExchange(&g_state, 2);
+}
+
+Result Transition(bool install_direction)
+{
+	LONG wanted = install_direction ? 0 : 1;
+	LONG previous = InterlockedCompareExchange(&g_state, 2, wanted);
+	if (previous != wanted) {
+		if (previous == 2)
+			return Result::ConcurrentChange;
+		auto existing_base = reinterpret_cast<std::uint8_t *>(GetModuleHandleW(nullptr));
+		if (!existing_base || !IsExpectedExecutable(existing_base))
+			return Result::UnsupportedExecutable;
+		if (install_direction && previous == 1 && AllMatch(existing_base, true))
+			return Result::AlreadyInstalled;
+		if (!install_direction && previous == 0 && AllMatch(existing_base, false))
+			return Result::NotInstalled;
+		SetStateFromSites(existing_base);
+		return Result::UnexpectedBytes;
+	}
+
+	auto base = reinterpret_cast<std::uint8_t *>(GetModuleHandleW(nullptr));
+	if (!base || !IsExpectedExecutable(base)) {
+		InterlockedExchange(&g_state, wanted);
+		return Result::UnsupportedExecutable;
+	}
+	if (!AllMatch(base, !install_direction)) {
+		SetStateFromSites(base);
+		return Result::UnexpectedBytes;
+	}
+
+	for (std::size_t i = 0; i < _countof(kSites); ++i) {
+		WriteOutcome outcome = WriteOne(base, kSites[i], install_direction);
+		Result success = install_direction ? Result::Installed : Result::Removed;
+		if (outcome.result == success)
+			continue;
+
+		bool rolled_back = RollBackCompleted(base, i, install_direction);
+		SetStateFromSites(base);
+		if (!rolled_back || outcome.result == Result::RollbackFailed)
+			return Result::RollbackFailed;
+		return outcome.result;
+	}
+
+	bool exact = AllMatch(base, install_direction);
+	if (!exact) {
+		bool rolled_back = RollBackCompleted(base, _countof(kSites), install_direction);
+		SetStateFromSites(base);
+		return rolled_back ? Result::ConcurrentChange : Result::RollbackFailed;
+	}
+	SetStateFromSites(base);
+	return install_direction ? Result::Installed : Result::Removed;
+}
+}
+
+Result Install()
+{
+	return Transition(true);
+}
+
+Result Remove()
+{
+	return Transition(false);
+}
+
+const wchar_t *Describe(Result result)
+{
+	switch (result) {
+	case Result::Installed: return L"CMAA lock installed";
+	case Result::AlreadyInstalled: return L"CMAA lock already installed";
+	case Result::Removed: return L"CMAA lock removed";
+	case Result::NotInstalled: return L"CMAA lock is not installed";
+	case Result::UnsupportedExecutable: return L"unsupported DiRT Rally 2.0 executable";
+	case Result::UnexpectedBytes: return L"CMAA lock bytes do not match";
+	case Result::ProtectFailed: return L"could not change CMAA patch page protection";
+	case Result::CacheFlushFailed: return L"instruction cache flush failed; changes rolled back";
+	case Result::ProtectionRestoreFailed: return L"page protection restoration failed; abort launch";
+	case Result::RollbackFailed: return L"CMAA transaction rollback incomplete; abort launch";
+	case Result::ConcurrentChange: return L"CMAA patch sites changed concurrently";
+	default: return L"unknown CMAA lock result";
+	}
+}
+}
diff --git b/DirectX11/TrueTripleCmaaLock.h b/DirectX11/TrueTripleCmaaLock.h
new file mode 100644
index 0000000..d0db704
--- /dev/null
+++ b/DirectX11/TrueTripleCmaaLock.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <windows.h>
+
+// Included once by D3D11Wrapper.cpp; installed during early proxy initialization
+// when the active mod configuration enables force_native_aa.
+namespace TrueTripleCmaaLock
+{
+enum class Result
+{
+	Installed,
+	AlreadyInstalled,
+	Removed,
+	NotInstalled,
+	UnsupportedExecutable,
+	UnexpectedBytes,
+	ProtectFailed,
+	CacheFlushFailed,
+	ProtectionRestoreFailed,
+	RollbackFailed,
+	ConcurrentChange,
+};
+
+// PRECONDITION: execution of every patched RVA must be excluded for the entire
+// call. Install belongs in early serialized proxy initialization; Remove only
+// in serialized teardown. These functions are not hot-patch APIs.
+Result Install();
+Result Remove();
+const wchar_t *Describe(Result result);
+}
diff --git b/DirectX11/TrueTripleTaaLock.cpp b/DirectX11/TrueTripleTaaLock.cpp
new file mode 100644
index 0000000..32fd295
--- /dev/null
+++ b/DirectX11/TrueTripleTaaLock.cpp
@@ -0,0 +1,222 @@
+#include "TrueTripleTaaLock.h"
+
+#include <cstdint>
+#include <cstring>
+
+namespace TrueTripleTaaLock
+{
+namespace
+{
+// DiRT Rally 2.0 1.18.130.9032, SHA256
+// C119F509FC315D8168AA7AAA5D0A1EE8E3570C7220BD6CBB2D337D6725D73442.
+constexpr DWORD kExpectedTimestamp = 0x605CBAE3;
+constexpr DWORD kExpectedSizeOfImage = 0x02255000;
+constexpr std::uintptr_t kTaaSetterRva = 0x005F5340;
+
+// Render TAA state setter:
+//   original: mov byte ptr [rcx], dl ; ret ; int3
+//   patched:  mov byte ptr [rcx], 0  ; ret
+// The four-byte site is naturally aligned, so the code transition itself can
+// be one atomic DWORD exchange after the page protection has changed.
+constexpr LONG kOriginalDword = static_cast<LONG>(0xCCC31188u);
+constexpr LONG kPatchedDword = static_cast<LONG>(0xC30001C6u);
+constexpr std::uint8_t kExpectedSite[8] = {
+	0x88, 0x11, 0xC3, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC,
+};
+constexpr std::uint8_t kExpectedPatchedSite[8] = {
+	0xC6, 0x01, 0x00, 0xC3, 0xCC, 0xCC, 0xCC, 0xCC,
+};
+static_assert((kTaaSetterRva & 3u) == 0, "patch site must be DWORD aligned");
+
+volatile LONG g_state = 0; // 0 absent, 1 installed, 2 transition in progress
+
+struct ExchangeOutcome
+{
+	Result result;
+	LONG final_dword;
+};
+
+bool IsExpectedExecutable(std::uint8_t *base)
+{
+	__try {
+		auto dos = reinterpret_cast<const IMAGE_DOS_HEADER *>(base);
+		if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0 ||
+			dos->e_lfanew > 0x100000)
+			return false;
+		auto nt = reinterpret_cast<const IMAGE_NT_HEADERS64 *>(base + dos->e_lfanew);
+		return nt->Signature == IMAGE_NT_SIGNATURE &&
+			nt->FileHeader.Machine == IMAGE_FILE_MACHINE_AMD64 &&
+			nt->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC &&
+			nt->FileHeader.TimeDateStamp == kExpectedTimestamp &&
+			nt->OptionalHeader.SizeOfImage == kExpectedSizeOfImage &&
+			kTaaSetterRva + sizeof(LONG) <= nt->OptionalHeader.SizeOfImage;
+	} __except (EXCEPTION_EXECUTE_HANDLER) {
+		return false;
+	}
+}
+
+LONG ReadSite(volatile LONG *site)
+{
+	// Naturally aligned 32-bit reads are atomic on x64.  Do not use an
+	// Interlocked read here: CMPXCHG requires write access and the code page is RX.
+	return *site;
+}
+
+bool SiteMatches(const volatile LONG *site, const std::uint8_t (&expected)[8])
+{
+	__try {
+		return std::memcmp(const_cast<const LONG *>(site), expected,
+			sizeof(expected)) == 0;
+	} __except (EXCEPTION_EXECUTE_HANDLER) {
+		return false;
+	}
+}
+
+bool RestoreProtection(volatile LONG *site, DWORD protection)
+{
+	DWORD ignored = 0;
+	if (VirtualProtect(const_cast<LONG *>(site), sizeof(LONG), protection, &ignored))
+		return true;
+	// A transient failure must not be silently treated as success.
+	return VirtualProtect(const_cast<LONG *>(site), sizeof(LONG), protection, &ignored) != FALSE;
+}
+
+bool RollBackSite(volatile LONG *site, LONG replacement, LONG expected,
+	DWORD original_protection)
+{
+	DWORD current_protection = 0;
+	if (!VirtualProtect(const_cast<LONG *>(site), sizeof(LONG),
+		PAGE_EXECUTE_READWRITE, &current_protection))
+		return false;
+
+	LONG observed = InterlockedCompareExchange(site, expected, replacement);
+	bool bytes_restored = observed == replacement || observed == expected;
+	bool cache_flushed = bytes_restored &&
+		FlushInstructionCache(GetCurrentProcess(), const_cast<LONG *>(site),
+			sizeof(LONG)) != FALSE;
+	bool protection_restored = RestoreProtection(site, original_protection);
+	return bytes_restored && cache_flushed && protection_restored &&
+		ReadSite(site) == expected;
+}
+
+ExchangeOutcome ExchangeSite(volatile LONG *site, LONG expected, LONG replacement)
+{
+	DWORD old_protection = 0;
+	if (!VirtualProtect(const_cast<LONG *>(site), sizeof(LONG),
+		PAGE_EXECUTE_READWRITE, &old_protection))
+		return { Result::ProtectFailed, ReadSite(site) };
+
+	LONG observed = InterlockedCompareExchange(site, replacement, expected);
+	if (observed != expected) {
+		bool protection_restored = RestoreProtection(site, old_protection);
+		return {
+			protection_restored ? Result::ConcurrentChange
+				: Result::ProtectionRestoreFailed,
+			ReadSite(site),
+		};
+	}
+
+	bool cache_flushed = FlushInstructionCache(GetCurrentProcess(),
+		const_cast<LONG *>(site), sizeof(LONG)) != FALSE;
+	bool protection_restored = RestoreProtection(site, old_protection);
+	LONG final_dword = ReadSite(site);
+	if (cache_flushed && protection_restored && final_dword == replacement)
+		return {
+			replacement == kPatchedDword ? Result::Installed : Result::Removed,
+			final_dword,
+		};
+	if (cache_flushed && protection_restored)
+		return { Result::ConcurrentChange, final_dword };
+
+	Result original_failure = cache_flushed
+		? Result::ProtectionRestoreFailed : Result::CacheFlushFailed;
+	if (RollBackSite(site, replacement, expected, old_protection))
+		return { original_failure, ReadSite(site) };
+	return { Result::RollbackFailed, ReadSite(site) };
+}
+
+void SetStateFromBytes(LONG value)
+{
+	if (value == kOriginalDword)
+		InterlockedExchange(&g_state, 0);
+	else if (value == kPatchedDword)
+		InterlockedExchange(&g_state, 1);
+	else
+		InterlockedExchange(&g_state, 2);
+}
+}
+
+Result Install()
+{
+	LONG previous = InterlockedCompareExchange(&g_state, 2, 0);
+	if (previous == 1) {
+		auto base = reinterpret_cast<std::uint8_t *>(GetModuleHandleW(nullptr));
+		if (!base || !IsExpectedExecutable(base))
+			return Result::UnsupportedExecutable;
+		auto site = reinterpret_cast<volatile LONG *>(base + kTaaSetterRva);
+		return SiteMatches(site, kExpectedPatchedSite)
+			? Result::AlreadyInstalled : Result::UnexpectedBytes;
+	}
+	if (previous != 0)
+		return Result::ConcurrentChange;
+
+	auto base = reinterpret_cast<std::uint8_t *>(GetModuleHandleW(nullptr));
+	if (!base || !IsExpectedExecutable(base)) {
+		InterlockedExchange(&g_state, 0);
+		return Result::UnsupportedExecutable;
+	}
+
+	auto site = reinterpret_cast<volatile LONG *>(base + kTaaSetterRva);
+	if (!SiteMatches(site, kExpectedSite) || ReadSite(site) != kOriginalDword) {
+		InterlockedExchange(&g_state, 0);
+		return Result::UnexpectedBytes;
+	}
+
+	ExchangeOutcome outcome = ExchangeSite(site, kOriginalDword, kPatchedDword);
+	SetStateFromBytes(outcome.final_dword);
+	return outcome.result;
+}
+
+Result Remove()
+{
+	LONG previous = InterlockedCompareExchange(&g_state, 2, 1);
+	if (previous == 0)
+		return Result::NotInstalled;
+	if (previous != 1)
+		return Result::ConcurrentChange;
+
+	auto base = reinterpret_cast<std::uint8_t *>(GetModuleHandleW(nullptr));
+	if (!base || !IsExpectedExecutable(base)) {
+		InterlockedExchange(&g_state, 1);
+		return Result::UnsupportedExecutable;
+	}
+
+	auto site = reinterpret_cast<volatile LONG *>(base + kTaaSetterRva);
+	if (!SiteMatches(site, kExpectedPatchedSite) || ReadSite(site) != kPatchedDword) {
+		InterlockedExchange(&g_state, 1);
+		return Result::UnexpectedBytes;
+	}
+
+	ExchangeOutcome outcome = ExchangeSite(site, kPatchedDword, kOriginalDword);
+	SetStateFromBytes(outcome.final_dword);
+	return outcome.result;
+}
+
+const wchar_t *Describe(Result result)
+{
+	switch (result) {
+	case Result::Installed: return L"TAA lock installed";
+	case Result::AlreadyInstalled: return L"TAA lock already installed";
+	case Result::Removed: return L"TAA lock removed";
+	case Result::NotInstalled: return L"TAA lock is not installed";
+	case Result::UnsupportedExecutable: return L"unsupported DiRT Rally 2.0 executable";
+	case Result::UnexpectedBytes: return L"TAA setter bytes do not match";
+	case Result::ProtectFailed: return L"could not change TAA setter page protection";
+	case Result::CacheFlushFailed: return L"instruction cache flush failed; patch rolled back";
+	case Result::ProtectionRestoreFailed: return L"page protection restoration failed; abort launch";
+	case Result::RollbackFailed: return L"TAA patch rollback incomplete; abort launch";
+	case Result::ConcurrentChange: return L"TAA setter changed concurrently";
+	default: return L"unknown TAA lock result";
+	}
+}
+}
diff --git b/DirectX11/TrueTripleTaaLock.h b/DirectX11/TrueTripleTaaLock.h
new file mode 100644
index 0000000..aa06198
--- /dev/null
+++ b/DirectX11/TrueTripleTaaLock.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <windows.h>
+
+// Included once by D3D11Wrapper.cpp; installed during early proxy initialization
+// when the active mod configuration enables force_native_aa.
+namespace TrueTripleTaaLock
+{
+enum class Result
+{
+	Installed,
+	AlreadyInstalled,
+	Removed,
+	NotInstalled,
+	UnsupportedExecutable,
+	UnexpectedBytes,
+	ProtectFailed,
+	CacheFlushFailed,
+	ProtectionRestoreFailed,
+	RollbackFailed,
+	ConcurrentChange,
+};
+
+// PRECONDITION: no other thread may execute exe+0x5F5340 until this call
+// returns. Install is intended for early serialized proxy initialization;
+// Remove is intended for serialized teardown only.
+Result Install();
+Result Remove();
+const wchar_t *Describe(Result result);
+}
diff --git b/DirectX11/VisibilityProbe.h b/DirectX11/VisibilityProbe.h
new file mode 100644
index 0000000..dd11733
--- /dev/null
+++ b/DirectX11/VisibilityProbe.h
@@ -0,0 +1,166 @@
+// Experimental passive visibility probe. No query/result/plane writes.
+// B2A610 ABI verified: uint32 __fastcall(this, query, result); no stack args.
+#pragma once
+#include <Windows.h>
+#include <stdint.h>
+#include <math.h>
+#include <string.h>
+
+namespace TTVisibilityProbe {
+typedef unsigned (__fastcall *QueryFn)(void *, void *, void *);
+static QueryFn original = NULL;
+static uintptr_t base = 0;
+static volatile LONG state = 0, total = 0, last_tick = 0, untracked = 0;
+struct Slot {
+    PVOID volatile query;
+    volatile LONG calls, sampled;
+};
+static Slot slots[64] = {};
+
+static bool context(uintptr_t *ctx, int *mode)
+{
+    __try {
+        uintptr_t renderer = *(uintptr_t *)(base + 0x159DD90);
+        *ctx = renderer ? *(uintptr_t *)(renderer + 0x2050) : 0;
+        *mode = *ctx ? *(int *)(*ctx + 0x1E98) : -1;
+        return *ctx != 0;
+    } __except (EXCEPTION_EXECUTE_HANDLER) { *ctx = 0; *mode = -2; return false; }
+}
+
+struct Sample {
+    float planes[24], eye[4], radius;
+    int pvs, extra;
+    unsigned long long items, secondary;
+    unsigned raw[10];
+    uintptr_t ctx, camera;
+    int mode, equals_main;
+};
+
+static bool read_sample(void *query, void *output, Sample *s)
+{
+    __try {
+        memcpy(s->planes, query, sizeof(s->planes));
+        memcpy(s->eye, (char *)query + 0xE0, sizeof(s->eye));
+        s->radius = *(float *)((char *)query + 0xEC);
+        s->pvs = *(int *)((char *)query + 0xF4);
+        s->extra = *(int *)((char *)query + 0x124);
+        s->items = s->secondary = 0;
+        for (int i = 0; i < 16; ++i) {
+            s->items += *(unsigned *)((char *)output + i * 0x18);
+            s->secondary += *(unsigned *)((char *)output + 0x180 + i * 0x18);
+        }
+        memcpy(s->raw, (char *)output + 0x320, sizeof(s->raw));
+        context(&s->ctx, &s->mode);
+        s->camera = s->ctx ? *(uintptr_t *)(s->ctx + 0x17C0) : 0;
+        // Equality is evidence only, not authoritative camera identity.
+        s->equals_main = s->ctx &&
+            memcmp(query, (void *)(s->ctx + 0x14E0), sizeof(s->planes)) == 0;
+        return true;
+    } __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+
+static unsigned __fastcall query_hook(void *self, void *query, void *output)
+{
+    InterlockedIncrement(&total);
+    unsigned result = original(self, query, output);
+    bool tracked = false;
+    for (int i = 0; i < 64; ++i) {
+        void *found = InterlockedCompareExchangePointer(&slots[i].query, query, NULL);
+        if (found && found != query) continue;
+        tracked = true;
+        LONG calls = InterlockedIncrement(&slots[i].calls);
+        DWORD now = GetTickCount();
+        LONG last = InterlockedCompareExchange(&slots[i].sampled, 0, 0);
+        if (calls != 1 && (DWORD)(now - (DWORD)last) < 5000) break;
+        if (InterlockedCompareExchange(&slots[i].sampled, (LONG)now, last) != last) break;
+        Sample s = {};
+        if (!read_sample(query, output, &s)) {
+            LogInfo("TTVIS: slot=%d calls=%ld sample_read_failed\n", i, calls);
+            break;
+        }
+        LogInfo("TTVIS: slot=%d calls=%ld query=%p self=%p result=%u ctx=%p "
+            "mode=%d camera=%p main_planes_equal=%d pvs=%d radius=%.3f extra=%d "
+            "eye=(%.3f,%.3f,%.3f) items=%llu secondary=%llu "
+            "raw320=[%u,%u,%u,%u,%u,%u,%u,%u,%u,%u]\n",
+            i, calls, query, self, result, (void *)s.ctx, s.mode, (void *)s.camera,
+            s.equals_main, s.pvs, s.radius, s.extra, s.eye[0], s.eye[1], s.eye[2],
+            s.items, s.secondary, s.raw[0], s.raw[1], s.raw[2], s.raw[3],
+            s.raw[4], s.raw[5], s.raw[6], s.raw[7], s.raw[8], s.raw[9]);
+        LogInfo("TTVIS_PLANES: slot=%d "
+            "%.9g,%.9g,%.9g,%.9g; %.9g,%.9g,%.9g,%.9g; "
+            "%.9g,%.9g,%.9g,%.9g; %.9g,%.9g,%.9g,%.9g; "
+            "%.9g,%.9g,%.9g,%.9g; %.9g,%.9g,%.9g,%.9g\n", i,
+            s.planes[0],s.planes[1],s.planes[2],s.planes[3],
+            s.planes[4],s.planes[5],s.planes[6],s.planes[7],
+            s.planes[8],s.planes[9],s.planes[10],s.planes[11],
+            s.planes[12],s.planes[13],s.planes[14],s.planes[15],
+            s.planes[16],s.planes[17],s.planes[18],s.planes[19],
+            s.planes[20],s.planes[21],s.planes[22],s.planes[23]);
+        break;
+    }
+    if (!tracked) InterlockedIncrement(&untracked);
+    return result;
+}
+
+static bool install()
+{
+    base = (uintptr_t)GetModuleHandleW(NULL);
+    static const unsigned char signature[] = {
+        0x4c,0x89,0x44,0x24,0x18,0x53,0x55,0x56,0x57,0x48,0x83,0xec,0x68,
+        0x48,0x8b,0xe9,0x49,0x8b,0xd8,0x48,0x81,0xc1,0xf0,0,3,0,0x48,0x8b,0xf2
+    };
+    static const unsigned char renderer_sig[] = {0x48,0x8b,0x0d,0x20,0x9b,0x20,0x01};
+    __try {
+        IMAGE_DOS_HEADER *dos = (IMAGE_DOS_HEADER *)base;
+        if (!base || dos->e_magic != IMAGE_DOS_SIGNATURE) return false;
+        IMAGE_NT_HEADERS64 *nt = (IMAGE_NT_HEADERS64 *)(base + dos->e_lfanew);
+        if (nt->Signature != IMAGE_NT_SIGNATURE || nt->FileHeader.Machine != IMAGE_FILE_MACHINE_AMD64 ||
+            nt->FileHeader.TimeDateStamp != 0x605CBAE3 ||
+            nt->OptionalHeader.SizeOfImage != 0x2255000) return false;
+        if (memcmp((void *)(base + 0xB2A610), signature, sizeof(signature)) ||
+            memcmp((void *)(base + 0x394269), renderer_sig, sizeof(renderer_sig))) return false;
+        if (*(uintptr_t *)(base + 0x13B6FE8) != base + 0xB2EA60 ||
+            *(uintptr_t *)(base + 0x13B6FF0) != base + 0xB2A610 ||
+            *(uintptr_t *)(base + 0x13B6FF8) != base + 0xB29790) return false;
+    } __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+    original = (QueryFn)(base + 0xB2A610);
+    PVOID volatile *entry = (PVOID volatile *)(base + 0x13B6FF0);
+    DWORD old = 0, ignored = 0;
+    if (!VirtualProtect((void *)entry, sizeof(void *), PAGE_READWRITE, &old)) return false;
+    // Aligned pointer replacement: no suspended threads or modified instructions.
+    void *was = InterlockedCompareExchangePointer(entry, (void *)&query_hook, (void *)original);
+    BOOL restored = VirtualProtect((void *)entry, sizeof(void *), old, &ignored);
+    LogInfo("TTVIS: vtable_pointer_installed=%d protection_restored=%d\n",
+        was == (void *)original, restored != FALSE);
+    return was == (void *)original;
+}
+
+static void tick()
+{
+    LONG current = InterlockedCompareExchange(&state, 0, 0);
+    if (current == 0 && InterlockedCompareExchange(&state, 2, 0) == 0) {
+        auto it = command_list_globals.find(L"$visibility_probe");
+        if (it == command_list_globals.end() || it->second.fval < 0.5f) {
+            InterlockedExchange(&state, -2);
+            return;
+        }
+        bool ok = install();
+        InterlockedExchange(&state, ok ? 1 : -1);
+        LogInfo("TTVIS: passive probe %s; does not change culling.\n", ok ? "ready" : "INACTIVE signature/install failure");
+        LogOverlay(LOG_WARNING, ok ? "TrueTriple: registro de visibilidad activo\n" :
+            "TrueTriple: fallo al iniciar registro de visibilidad\n");
+        current = ok ? 1 : -1;
+    }
+    if (current != 1) return;
+    DWORD now = GetTickCount();
+    LONG last = InterlockedCompareExchange(&last_tick, 0, 0);
+    if ((DWORD)(now - (DWORD)last) < 2000 ||
+        InterlockedCompareExchange(&last_tick, (LONG)now, last) != last) return;
+    uintptr_t ctx = 0;
+    int mode = -1;
+    context(&ctx, &mode);
+    LogInfo("TTVIS_HEARTBEAT: calls=%ld untracked=%ld ctx=%p mode=%d\n",
+        InterlockedCompareExchange(&total, 0, 0),
+        InterlockedCompareExchange(&untracked, 0, 0), (void *)ctx, mode);
+}
+} // namespace
