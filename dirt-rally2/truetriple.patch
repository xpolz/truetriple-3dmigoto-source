+// Vuelca `antes` floats previos y `despues` posteriores al hit, recortado a la
+// region para no leer afuera. 8 por linea, con un marcador donde cae el hit.
+static void cull_dump(const uint8_t *hit, const uint8_t *rbase, size_t rsize,
+	int antes, int despues)
+{
+	const float *lo = (const float *)max((uintptr_t)rbase, (uintptr_t)(hit - 4 * antes));
+	const float *hi = (const float *)min((uintptr_t)(rbase + rsize), (uintptr_t)(hit + 4 * despues));
+	char linea[512];
+	for (const float *p = lo; p < hi; p += 8) {
+		int n = _snprintf_s(linea, sizeof(linea), _TRUNCATE, "CULLSCAN   %p:", p);
+		for (const float *q = p; q < p + 8 && q < hi; q++) {
+			float v = *q;
+			// los valores absurdos se imprimen en hex para no romper columnas
+			if (v > -1e9f && v < 1e9f)
+				n += _snprintf_s(linea + n, sizeof(linea) - n, _TRUNCATE,
+					(q == (const float *)hit) ? " >%11.5f<" : " %12.5f", v);
+			else
+				n += _snprintf_s(linea + n, sizeof(linea) - n, _TRUNCATE, "  0x%08X ", *(const unsigned *)q);
+		}
+		LogInfo("%s\n", linea);
+	}
+}
