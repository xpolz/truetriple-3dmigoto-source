+// ===== v1.37: CAZAPLANOS — buscar los 6 planos del frustum (SOLO LECTURA) ====
+// El culling no testea contra "un angulo": testea contra 6 planos, y cada plano
+// es un semiespacio independiente. Rotar los dos laterales hacia afuera abre el
+// frustum a cualquier angulo — incluso mas de 180, que ninguna proyeccion plana
+// puede expresar (el techo que mato los intentos por FOV). Esta build BUSCA esos
+// planos y los loguea; no escribe nada. Con el log se decide si la fase 2 es
+// escribir planos o escalar al breakpoint de datos.
+//
+// Que se busca (tres firmas complementarias):
+//  1. PLANOS6 (nuevo): 6 grupos consecutivos de 4 floats con normal ~unitaria
+//     cuyos productos punto entre normales forman el apareamiento exacto de un
+//     frustum con ESTA camara: un par antiparalelo (near/far, dot=-1), un par
+//     lateral (dot=-cos(fovH)) y un par vertical (dot=-cos(fovV)). Los dots son
+//     invariantes a rotacion, asi que la firma funciona igual si el engine
+//     guarda los planos en espacio de VISTA o de MUNDO — el intento anterior
+//     (valor exacto) solo cubria espacio de vista. Exigir el apareamiento
+//     perfecto de a 3 pares sobre 6 normales hace el falso positivo rarisimo
+//     (la trampa del icosaedro del primer intento no pasa este filtro).
+//     El w de cada plano dice en que espacio estan: laterales con d~0 = vista
+//     (pasan por el ojo); d grandes = mundo.
+//  2. Componentes por valor exacto de los planos en vista: normalize(m00,0,-1)
+//     y normalize(0,m11,-1). Barato y con dump de vecindario.
+//  3. Camaras "laxas" ({fov,near,far,aspect} plausibles SIN exigir matriz a
+//     +0x2C): candidatas a la camara del hilo de simulacion, la que la firma
+//     estricta descartaba y probablemente la fuente real (MEMORIA.md).
+// Ademas se reloguean los descriptores estrictos como control positivo de que
+// el escaner ve lo mismo que la sesion pasada.
+
+struct CullScanReq {
+	float P[16];	// proyeccion tal como se sube en cb3[0..3]
+	float m00, m11, nearz, aspect;
+};
+static CullScanReq g_cullscan_req;
+static volatile LONG g_cullscan_state = 0;	// 0=esperando camara, 1=lanzado
+
+// Nombre del modulo dueno de una direccion, o "heap" si es memoria dinamica.
+static const char *cull_owner(const void *addr, char *buf, size_t bufsz)
+{
+	HMODULE hm = NULL;
+	if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+			GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, (LPCSTR)addr, &hm) && hm) {
+		char full[MAX_PATH];
+		if (GetModuleFileNameA(hm, full, MAX_PATH)) {
+			const char *base = strrchr(full, '\\');
+			_snprintf_s(buf, bufsz, _TRUNCATE, "%s", base ? base + 1 : full);
+			return buf;
+		}
+	}
+	_snprintf_s(buf, bufsz, _TRUNCATE, "heap");
+	return buf;
+}
