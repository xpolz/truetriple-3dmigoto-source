+// ===== v1.66: HOOK de BuildFrustum — abrir el culling de objetos en la FUENTE =
+//
+// El workflow del 2026-07-29 encontro la funcion generica del motor que arma
+// TODOS los frustums (Gribb-Hartmann): dirtrally2.exe+0x8B85D0 =
+// BuildFrustum(rcx=dst, rdx=viewProj). Verificado por desensamblado: escribe 6
+// planos float4 en dst[+0x00..+0x50] (orden near, far, IZQ+0x20, DER+0x30,
+// abajo+0x40, arriba+0x50) + 8 esquinas en +0x60. NO usa r8/r9 -> 2 argumentos.
+//
+// Esta es la FUENTE de los planos que RAM-A encontraba por firma y escribia
+// compitiendo contra el engine (carrera + fragilidad). El wrapper de cada CALL
+// los modifica justo despues de construirlos y antes de devolver al consumidor
+// (+0x8BCCD0, quadtree +0xA94840): determinista y sin escaneo.
+//
+// Se abre SOLO el frustum cuyo FOV horizontal Y vertical coincide con el cbuffer
+// de la camara principal. Sombras ortograficas, cubemaps, reflejos y queries con
+// otra proyeccion quedan intactos. Las bisectrices preservan el ojo y llevan el
+// horizontal a 178 grados; el vertical no se toca. Bit 16; reversible a 0.
+
+typedef void *(__fastcall *BuildFrustum_t)(void *dst, const float *viewProj);
+static BuildFrustum_t g_bf_orig = NULL;
+static CommandListVariable *g_bf_var = NULL;
+static volatile LONG g_bf_var_init = 0;
+static volatile LONG g_bf_hooked = 0;
+static uintptr_t g_bf_exe_base = 0;
+static volatile LONG g_bf_matched_sites = 0;
+static volatile LONG g_bf_last_mode = -1;
+
+// Los 32 CALL rel32 directos a BuildFrustum de este binario exacto. En vez de
+// detourar el prologo (Nektra corrompia el shadow-space de su caller), cambiamos
+// solamente el destino de cada CALL a un relay cercano. El relay hace JMP a
+// nuestro wrapper: la direccion de retorno sigue siendo callsite+5 y no se
+// mueve ni una instruccion del juego.
+static const DWORD g_bf_call_rvas[] = {
+	0x39E261, 0x3A93C2, 0x3AAD86, 0x3C0D07,
+	0x3C6633, 0x3C6744, 0x3C70DC, 0x3C74FF,
+	0x3C794F, 0x3C7AE7, 0x3C7E0A, 0x3C83F8,
+	0x3C870C, 0x3D09AE, 0x46DEBA, 0x4AAFA7,
+	0x4AB6AA, 0x4B2B91, 0x4B2FE5, 0x6934BA,
+	0x955AA1, 0x9F523D, 0xA774B9, 0xA77E75,
+	0xA7D78C, 0xA7DA6F, 0xAC3872, 0xAC4F9E,
+	0xAC55F5, 0xC34737, 0xC45041, 0xCF8D9A
+};
+
+// Pisa los planos laterales con SEH. En helper aparte SIN objetos C++: el __try
+// no convive con el iterador del unordered_map en la misma funcion (C2712).
+static bool bf_abrir_a_178(float *p)
+{
+	__try {
+		// Construir las bisectrices del par lateral COMPLETO (incluido d). Como
+		// ambos planos pasan por el ojo, sus combinaciones tambien. Esto abre el
+		// cono a 178 grados sin convertirlo en 360 ni inundar listas fijas.
+		float f[4], r[4];
+		float fl2 = 0.0f, rl2 = 0.0f;
+		for (int k = 0; k < 4; k++) {
+			f[k] = p[8 + k] + p[12 + k];
+			r[k] = p[8 + k] - p[12 + k];
+			if (k < 3) { fl2 += f[k] * f[k]; rl2 += r[k] * r[k]; }
+		}
+		if (fl2 < 1e-6f || rl2 < 1e-6f)
+			return false;
+		float fi = 1.0f / sqrtf(fl2), ri = 1.0f / sqrtf(rl2);
+		// sin(89 deg), cos(89 deg): FOV horizontal total 178 grados.
+		const float sf = 0.999847695f, cr = 0.017452406f;
+		for (int k = 0; k < 4; k++) {
+			f[k] *= fi; r[k] *= ri;
+			p[8 + k]  = sf * f[k] + cr * r[k];
+			p[12 + k] = sf * f[k] - cr * r[k];
+		}
+		return true;
+	} __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+
+// Diagnostic bit 256: widen the vertical pair too, ONLY at the main-view CS10.
+// The previous 178h test left this pair unchanged, so it cannot exclude frustum
+// rejection at the upper/lower edges of the side monitors. Not a >180 solution.
+static bool bf_abrir_vertical_a_178(float *p)
+{
+    __try {
+        float f[4], u[4], fl2 = 0.0f, ul2 = 0.0f;
+        for (int k = 0; k < 4; ++k) {
+            f[k] = p[16+k] + p[20+k];
+            u[k] = p[16+k] - p[20+k];
+            if (k < 3) { fl2 += f[k]*f[k]; ul2 += u[k]*u[k]; }
+        }
+        if (!(fl2 > 1e-6f) || !(ul2 > 1e-6f)) return false;
+        float fi = 1.0f/sqrtf(fl2), ui = 1.0f/sqrtf(ul2);
+        for (int k = 0; k < 4; ++k) {
+            p[16+k] = 0.999847695f*f[k]*fi + 0.017452406f*u[k]*ui;
+            p[20+k] = 0.999847695f*f[k]*fi - 0.017452406f*u[k]*ui;
+        }
+        return true;
+    } __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+
+// Conservative all-direction CPU volume, without changing render FOV.
+// Bit512 retains the original 250m diagnostic. Bit1024 derives the extent from
+// all original far corners and replaces the corners consistently too. Its broad
+// coverage deliberately trades angular rejection for correctness; measure cost.
+static bool bf_caja_local(float *p, bool conservar_alcance = false, float *radio_out = NULL)
+{
+    __try {
+        const float *a=p+8, *b=p+12, *c=p+16;
+        double bc[3]={b[1]*c[2]-b[2]*c[1], b[2]*c[0]-b[0]*c[2], b[0]*c[1]-b[1]*c[0]};
+        double ca[3]={c[1]*a[2]-c[2]*a[1], c[2]*a[0]-c[0]*a[2], c[0]*a[1]-c[1]*a[0]};
+        double ab[3]={a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]};
+        double det=a[0]*bc[0]+a[1]*bc[1]+a[2]*bc[2];
+        if (!(fabs(det)>1e-6)) return false;
+        float eye[3];
+        for (int k=0;k<3;k++) {
+            double e=(-a[3]*bc[k]-b[3]*ca[k]-c[3]*ab[k])/det;
+            if (!(fabs(e)<1e7)) return false;
+            eye[k]=(float)e;
+        }
+        float radius=250.0f;
+        bool corner_lo[8][3]={};
+        if(conservar_alcance) {
+            double max_dist2=0;
+            for(int i=0;i<8;i++) {
+                const float *pt=p+24+i*4;
+                double d2=0;
+                for(int axis=0;axis<3;axis++) {
+                    double d=(double)pt[axis]-eye[axis]; d2+=d*d;
+                }
+                if(!(d2>=0 && d2<1e14)) return false;
+                if(d2>max_dist2) max_dist2=d2;
+                // Preserve the engine's corner ordering by identifying the
+                // incident original plane from each opposing pair.
+                const int pairs[3]={8,16,0}; // world box x,y,z -> left,bottom,near
+                for(int axis=0;axis<3;axis++) {
+                    int o=pairs[axis];
+                    double lo=p[o+3],hi=p[o+7];
+                    for(int k=0;k<3;k++){lo+=(double)p[o+k]*pt[k]; hi+=(double)p[o+4+k]*pt[k];}
+                    corner_lo[i][axis]=fabs(lo)<=fabs(hi);
+                }
+            }
+            if(!(max_dist2>1.0)) return false;
+            radius=(float)(sqrt(max_dist2)*1.001+1.0);
+        }
+        float box[24]={};
+        for(int axis=0;axis<3;axis++) {
+            // Range-preserving mode also keeps near/far,left/right,bottom/top
+            // plane order consistent with the eight replacement corners.
+            int lo=conservar_alcance ? (axis==0?8:axis==1?16:0):axis*8, hi=lo+4;
+            box[lo+axis]=1.0f; box[lo+3]=radius-eye[axis];
+            box[hi+axis]=-1.0f; box[hi+3]=radius+eye[axis];
+        }
+        if(conservar_alcance) for(int i=0;i<8;i++) {
+            for(int axis=0;axis<3;axis++) p[24+i*4+axis]=eye[axis]+(corner_lo[i][axis]?-radius:radius);
+            p[24+i*4+3]=1.0f;
+        }
+        memcpy(p,box,sizeof(box));
+        if(radio_out) *radio_out=radius;
+        return true;
+    } __except(EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
