+		//
+		// El juego escribe hasta DIEZ camaras de pantalla completa por frame y la
+		// ULTIMA es siempre la del frontend, incluso manejando (medido el
+		// 2026-07-31, ver el comentario de v1.35 mas abajo). [Present] corre al
+		// final del frame, asi que leia justo esa: una altura CONSTANTE. Con eso
+		// la diferencia entre frames daba cero, el acumulador decaia a cero y la
+		// correccion era cero siempre.
+		//
+		// Medido: y4 (la correccion que llega a los shaders) valia 0.035 en las
+		// 5490 muestras de una corrida, un unico valor.
+		//
+		// Es el MISMO error que ya habia arruinado w3 y la deteccion de vista por
+		// m11, documentado veinte lineas mas abajo. Se repitio por escribir aca
+		// arriba, fuera del gate.
+		//
+		// La condicion es la ya probada: no es camara de menu y es perspectiva
+		// real (m22 < -0.9, para descartar una ortografica que se cuela).
+		if (!tt_es_camara_de_menu(f[5]) && f[10] < -0.9f && G->iniParams.size() >= 10) {
+			G->iniParams[9].z = f[33];
+			// Y el CABECEO de la camara respecto del mundo.
+			//
+			// Medido sobre 21240 muestras de conduccion: mirando el camino, la
+			// rotacion mueve la imagen 14 px y la traslacion vertical 3 px. O sea
+			// que lo que cansa la vista es sobre todo esto, no la altura — que
+			// sacude el cockpit y poco mas.
+			//
+			// relativeView es rotacion pura y row_major (floats 52..63): la fila 2
+			// es el vector ADELANTE de la camara en coordenadas de mundo, y su
+			// componente Y es el seno del cabeceo. Se elige esa y no la del vector
+			// ARRIBA porque esta ultima va como el coseno: cerca de 1 y casi sin
+			// cambiar con angulos chicos (medido, se mueve diez veces menos).
+			//
+			// Va entre -1 y 1, asi que no tiene el problema de precision que tuvo
+			// la altura absoluta a 2530 metros.
+			G->iniParams[9].w = f[61];
