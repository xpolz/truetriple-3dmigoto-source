+// Diagnostic032: site101 expands all validated ortho volumes; 201..232
+// selects one call site. Site0 records each ortho call site once, no mutation.
+static void bf_probe_ortho032(float *p, int site, int extra)
+{
+    if(site<0 || site>=(int)_countof(g_bf_call_rvas)) return;
+    __try {
+        static volatile LONG raw_logged[_countof(g_bf_call_rvas)]={};
+        if(InterlockedCompareExchange(&raw_logged[site],1,0)==0) {
+            for(int i=0;i<14;++i)
+                LogInfo("FRUSTUM032 CS%02d row%02d %.9g %.9g %.9g %.9g\n",site+1,i,p[4*i],p[4*i+1],p[4*i+2],p[4*i+3]);
+        }
+        float span=0;
+        if(!tt_scale_ortho_frustum(p,1,&span)) return;
+        static volatile LONG logged[_countof(g_bf_call_rvas)]={};
+        bool expand=extra==101 || extra==201+site;
+        LONG state=expand?2:1;
+        if(InterlockedExchange(&logged[site],state)!=state)
+            LogInfo("ORTHO032 CS%02d RVA=%X span=%.3f scale=%d\n",site+1,g_bf_call_rvas[site],span,expand?4:1);
+        if(expand && tt_scale_ortho_frustum(p,4)) InterlockedIncrement(&g_bf_site_open[site]);
+    } __except(EXCEPTION_EXECUTE_HANDLER) { }
+}
+static void *__fastcall Hooked_BuildFrustum(void *dst, const float *viewProj)
+{
+	void *ret = _ReturnAddress();
+	void *result = g_bf_orig(dst, viewProj);
+	DWORD call_rva = (DWORD)((uintptr_t)ret - g_bf_exe_base - 5);
+	int sitio = -1;
+	for (int i = 0; i < (int)_countof(g_bf_call_rvas); i++)
+		if (g_bf_call_rvas[i] == call_rva) { sitio = i; break; }
+	if (sitio >= 0)
+		InterlockedIncrement(&g_bf_site_calls[sitio]);
+	if (sitio == BF_SITIO_CS10) {
+		float h = 0.0f, v = 0.0f;
+		if (bf_fov_de_planos((const float *)dst, &h, &v)) {
+			InterlockedExchange(&g_bf_cs10_fov_h, (LONG)(h * 10.0f));
+			InterlockedExchange(&g_bf_cs10_fov_v, (LONG)(v * 10.0f));
+		}
+	}
+	int modo = bf_leer_modo_var();
+	LONG anterior = InterlockedExchange(&g_bf_last_mode, modo);
+	if (anterior != modo) {
+		char que[128];
+		bf_describir_modo(modo, que, sizeof(que));
+		LogInfo("BFCALL: modo CPU cambio a %d (%s).\n", modo, que);
+		LogOverlay(LOG_WARNING, "Culling CPU: %s\n", que);
+	}
+	if (tt_replay_activo())
+		return result;
+        // Confirmed039: widen the camera-space cascade fitting volume BEFORE
+        // the game derives its light projection, rather than just light culling.
+        // CS02 produces four perspective slices; all original corners remain
+        // enclosed. UI toggle or diagnostic site102; independent of main CS10.
+        if((bf_sombras_activas() || bf_leer_site_var()==102) && sitio==1) {
+            float radius=0;
+            if(bf_caja_local((float *)dst,true,&radius)) {
+                InterlockedIncrement(&g_bf_site_open[sitio]);
+                static volatile LONG report_count=0;
+                if(InterlockedIncrement(&report_count)<=8)
+                    LogInfo("CASCADE039 CS02 box radius=%.3f\n",radius);
+            }
+        }
+	if (modo & 32) {
+		int extra = bf_leer_site_var();
+        bf_probe_ortho032((float *)dst, sitio, extra);
+		LONG site_ant = InterlockedExchange(&g_bf_last_site, extra);
+		if (site_ant != extra) {
+			if (extra == 99)
+				LogOverlay(LOG_WARNING, "Culling CPU: CS10 + TODOS los sitios\n");
+			else if (extra >= 1 && extra <= (int)_countof(g_bf_call_rvas))
+				LogOverlay(LOG_WARNING, "Culling CPU: CS10 + CS%02d (exe+0x%X)\n", extra, g_bf_call_rvas[extra - 1]);
+			else
+				LogOverlay(LOG_WARNING, "Culling CPU: solo CS10\n");
+			LogInfo("BFCALL: sitio extra = %d.\n", extra);
+		}
+		bool abrir = (sitio == BF_SITIO_CS10) ||
+			(sitio >= 0 && (extra == 99 || extra == sitio + 1));
+        if (abrir) {
+            bool changed;
+            if ((modo & 1024) && sitio == BF_SITIO_CS10)
+                changed = bf_caja_local((float *)dst, true, &g_bf_box_radius);
+            else if ((modo & 512) && sitio == BF_SITIO_CS10)
+                changed = bf_caja_local((float *)dst);
+            else {
+                changed = bf_abrir_a_178((float *)dst);
+                if (changed && (modo & 256) && sitio == BF_SITIO_CS10)
+                    changed = bf_abrir_vertical_a_178((float *)dst);
+            }
+            if(changed) InterlockedIncrement(&g_bf_site_open[sitio]);
+        }
+		return result;
+	}
+	if ((modo & 16) == 0)
+		return result;
+	float fh = 0.0f, fv = 0.0f;
+	if (!bf_es_camara_principal((const float *)dst, &fh, &fv))
+		return result;
+	if (sitio >= 0) {
+		LONG bit = (LONG)(1u << sitio);
+		LONG old = InterlockedOr(&g_bf_matched_sites, bit);
+		if ((old & bit) == 0)
+			LogInfo("BFCALL: vista principal en call exe+0x%X (%.1fx%.1f deg); "
+				"frustum CPU abierto a 178 deg.\n", call_rva, fh, fv);
+	}
+	if (bf_abrir_a_178((float *)dst) && sitio >= 0)
+		InterlockedIncrement(&g_bf_site_open[sitio]);
+	return result;
+}
+
+static void *bf_alloc_relay_near(uintptr_t base)
+{
+	SYSTEM_INFO si; GetSystemInfo(&si);
+	uintptr_t gran = si.dwAllocationGranularity;
+	uintptr_t origin = (base + 0x1800000 + gran - 1) & ~(gran - 1);
+	for (uintptr_t delta = 0; delta < 0x70000000; delta += gran) {
+		uintptr_t tries[2] = { origin + delta, origin > delta ? origin - delta : 0 };
+		for (int i = 0; i < 2; i++) {
+			if (!tries[i]) continue;
+			void *p = VirtualAlloc((void *)tries[i], 0x1000,
+				MEM_RESERVE | MEM_COMMIT, PAGE_EXECUTE_READWRITE);
+			if (p) return p;
+		}
+	}
+	return NULL;
+}
+
+static bool bf_validate_calls(uint8_t *base, uint8_t *original)
+{
+	__try {
+		for (int i = 0; i < (int)_countof(g_bf_call_rvas); i++) {
+			uint8_t *call = base + g_bf_call_rvas[i];
+			if (call[0] != 0xE8) return false;
+			int32_t rel; memcpy(&rel, call + 1, 4);
+			if (call + 5 + rel != original) return false;
+		}
+		return true;
+	} __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+
+// Instala un relay de 12 bytes y redirige los 32 CALL, despues de verificar
+// primero que TODOS siguen apuntando a la funcion esperada. Si cambia el EXE,
+// aborta sin escribir un solo byte.
+static void triple_install_buildfrustum_hook()
+{
+	if (InterlockedCompareExchange(&g_bf_hooked, 1, 0) != 0)
+		return;
+	HMODULE base = GetModuleHandleA(NULL);
+	if (!base) {
+		LogInfo("BFHOOK: no pude obtener la base del exe.\n");
+		return;
+	}
+	g_bf_exe_base = (uintptr_t)base;
+	g_bf_orig = (BuildFrustum_t)((uint8_t *)base + 0x8B85D0);
+	if (!bf_validate_calls((uint8_t *)base, (uint8_t *)g_bf_orig)) {
+		LogInfo("BFCALL: los call sites no coinciden con el EXE investigado; "
+			"no se parcheo nada.\n");
+		return;
+	}
+	uint8_t *relay = (uint8_t *)bf_alloc_relay_near((uintptr_t)base);
+	if (!relay) {
+		LogInfo("BFCALL: no pude reservar relay cercano; no se parcheo nada.\n");
+		return;
+	}
+	// mov rax, imm64 ; jmp rax
+	relay[0] = 0x48; relay[1] = 0xB8;
+	void *wrapper = (void *)&Hooked_BuildFrustum;
+	memcpy(relay + 2, &wrapper, 8);
+	relay[10] = 0xFF; relay[11] = 0xE0;
+	FlushInstructionCache(GetCurrentProcess(), relay, 12);
+	DWORD relayOld; VirtualProtect(relay, 0x1000, PAGE_EXECUTE_READ, &relayOld);
+
+	// Pausar brevemente los otros hilos evita que alguno ejecute un CALL mientras
+	// se reemplazan sus cuatro bytes de desplazamiento.
+	std::vector<HANDLE> pausados;
+	pausados.reserve(256);
+	HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+	if (snap != INVALID_HANDLE_VALUE) {
+		THREADENTRY32 te = {}; te.dwSize = sizeof(te);
+		DWORD pid = GetCurrentProcessId(), self = GetCurrentThreadId();
+		if (Thread32First(snap, &te)) do {
+			if (te.th32OwnerProcessID != pid || te.th32ThreadID == self) continue;
+			HANDLE h = OpenThread(THREAD_SUSPEND_RESUME, FALSE, te.th32ThreadID);
+			if (h && SuspendThread(h) != (DWORD)-1) pausados.push_back(h);
+			else if (h) CloseHandle(h);
+		} while (Thread32Next(snap, &te));
+		CloseHandle(snap);
+	}
+
+	// El opcode E8 queda intacto; se cambia unicamente su rel32.
+	int patched = 0;
+	for (int i = 0; i < (int)_countof(g_bf_call_rvas); i++) {
+		uint8_t *call = (uint8_t *)base + g_bf_call_rvas[i];
+		intptr_t delta = relay - (call + 5);
+		if (delta < INT32_MIN || delta > INT32_MAX) break;
+		DWORD oldProtect;
+		if (!VirtualProtect(call, 5, PAGE_EXECUTE_READWRITE, &oldProtect)) break;
+		int32_t rel = (int32_t)delta;
+		memcpy(call + 1, &rel, 4);
+		FlushInstructionCache(GetCurrentProcess(), call, 5);
+		DWORD ignored; VirtualProtect(call, 5, oldProtect, &ignored);
+		patched++;
+	}
+	if (patched != (int)_countof(g_bf_call_rvas)) {
+		for (int i = 0; i < patched; i++) {
+			uint8_t *call = (uint8_t *)base + g_bf_call_rvas[i];
+			int32_t rel = (int32_t)((uint8_t *)g_bf_orig - (call + 5));
+			DWORD oldProtect;
+			if (VirtualProtect(call, 5, PAGE_EXECUTE_READWRITE, &oldProtect)) {
+				memcpy(call + 1, &rel, 4);
+				FlushInstructionCache(GetCurrentProcess(), call, 5);
+				DWORD ignored; VirtualProtect(call, 5, oldProtect, &ignored);
+			}
+		}
+	}
+	for (auto h : pausados) { ResumeThread(h); CloseHandle(h); }
+	if (patched == (int)_countof(g_bf_call_rvas))
+		LogInfo("BFCALL: 32 call sites verificados y redirigidos sin tocar el "
+			"prologo. Bit 16 = por FOV; bit 32 = solo CS10 (0x3C7AE7), sin compuerta.\n");
+	else
+		LogInfo("BFCALL: ERROR en %d/32; se revirtieron los sitios ya tocados.\n",
+			patched);
+}
+
+
+// ===========================================================================
+// BIT 64 DE $cull_widen: ENSANCHAR LA MATRIZ DE LA CAMARA EN SU CONSTRUCTOR (2026-09-05)
+//
+// Con los 12 call sites de BuildFrustum activos abiertos (corrida 2 del paso 2) los
+// objetos vuelven pero el pasto y el terreno de fondo no: lo que los cullea no lee
+// planos, lee la MATRIZ (o el fov/aspecto) de la camara. Ghidra: la actualizacion de
+// matrices de la vista principal es 9D9B80(ctx, cam=ctx+0x17C0, ctx+0x17E0, f, 4),
+// llamada desde 3C5B30 (exe+0x3C5C2F), que es lo primero que hace 3C7AA0. Adentro:
+//   aspecto = (rt_ancho/rt_alto de *(ctx+0xFA0) +0xA4/+0xA8) * *(float*)(ctx+0xFE0)
+//   fov     = *(float*)(ctx+0x1830)        m11 = cot(fov/2)      m00 = m11 / aspecto
+// El multiplicador ctx+0xFE0 es la palanca: durante ESA llamada se le pone el valor que
+// deja el horizontal en $cull_hfov grados (172 por defecto) y al volver se restaura.
+// Todo lo que 9D9B80 deriva (proyeccion +0x190, viewProj +0x1D0, inversas, esquinas, y
+// los planos de BuildFrustum en CS10) sale coherente y ancho; el fov y el aspecto que
+// leen otros (LOD) quedan intactos. Mismo principio que DR1, sin prometer su resultado.
+//
+// El cbuffer de camara (cb3) se arma desde esas matrices, asi que llegaria ancho a la
+// GPU y los shaders SIN parchear del juego dibujarian ancho. Por eso TripleRestaurarM00
+// le devuelve el m00 original justo antes del Unmap (HackerContext), identificando la
+// camara por su m11 (que el ensanche no toca): f[0] (proj m00), f[16] (invProj [0][0]) y
+// la componente .x de los cuatro registros de relativeViewProjection (f[36..48]).
+// Los shaders del mod se auto-calibran con el m00 que ven, asi que para ellos da igual.
+// ===========================================================================
+#define TT_CAM_CALL_RVA   0x3C5C2FUL
+#define TT_CAM_FN_RVA     0x9D9B80UL
+#define TT_M00_MAX        24
+typedef void *(__fastcall *tt_cam_fn)(intptr_t ctx, intptr_t cam, intptr_t params, float f, unsigned n);
+static tt_cam_fn g_cam_orig = NULL;
+static volatile LONG g_cam_hooked = 0;
+static volatile LONG g_cam_llamadas = 0, g_cam_ensanchadas = 0, g_cam_saltadas = 0;
+static volatile LONG g_m00_restauradas = 0, g_m00_sin_par = 0;
+// Foto del ultimo intervalo de 2 s, para la linea permanente del overlay (TripleCullingOSD).
+static volatile LONG g_osd_cam_llam = 0, g_osd_cam_ens = 0, g_osd_m00rest = 0, g_osd_sinpar = 0;
+// El m00 que deja el ensanche identifica al cbuffer de la vista principal (es el mismo para
+// todas sus camaras: m00 = cot(fov_ctx/2)/(wh*mult), no depende de m11) y g_m00_orig es lo
+// que se le devuelve. Se publican DESPUES de la llamada original, desde el unico hilo que
+// pasa por el call site.
+static float g_m00_ancho = 0.0f, g_m00_orig = 0.0f;
+static float g_m00_ancho_pendiente = 0.0f, g_m00_orig_pendiente = 0.0f;
+// Corrida 5: el gancho SIN cambiar el numero tambien achica el agujero. La unica diferencia
+// con el modo 0 es escribir ctx+0xFE0 antes y despues de la llamada. Se mide que valor deja
+// el juego en ctx+0xFE0 al volver de 9D9B80 (si no es el de entrada, la "restauracion" es
+// un cambio real que el modo 0 no hace).
+static float g_fe0_pre = 0.0f, g_fe0_post = 0.0f;
+static volatile LONG g_fe0_dif = 0, g_fe0_dif_log = 0;
+static CommandListVariable *g_hfov_var = NULL;
+static volatile LONG g_hfov_var_init = 0;
+static volatile LONG g_cam_log_una_vez = 0;
+
+static volatile LONG g_hfov_ultimo_x10 = -99999;
+static float tt_hfov_objetivo();
+static void tt_hfov_anunciar_cambio()
+{
+	LONG ahora = (LONG)(tt_hfov_objetivo() * 10.0f);
+	LONG antes = InterlockedExchange(&g_hfov_ultimo_x10, ahora);
+	if (antes == ahora || antes == -99999)
+		return;
+	LogInfo("BFCALL: $cull_hfov cambio a %.1f (frame %u).\n", ahora / 10.0f, G ? G->frame_no : 0u);
+	LogOverlay(LOG_WARNING, "Culling CPU: ancho de matriz -> %.0f\n", ahora / 10.0f);
+}
+
+static float tt_hfov_objetivo()
+{
+	if (!g_hfov_var_init) {
+		auto it = command_list_globals.find(L"$cull_hfov");
+		if (it != command_list_globals.end()) {
+			g_hfov_var = &it->second;
+			InterlockedExchange(&g_hfov_var_init, 1);
+		}
+	}
+	float h = g_hfov_var ? g_hfov_var->fval : 172.0f;
+	if (h < -2.5f) return -3.0f;                 // -3 = pasante puro (marco propio, sin relleno)
+	if (h < -1.5f) return -2.0f;                 // -2 = pasante + rellena su marco con 0xFF
+	if (h < -0.5f) return -1.0f;                 // -1 = pasante + rellena su marco con 0x00
+	if (h < 1.0f) return 0.0f;                   // 0 = gancho puesto, matriz sin cambio
+	if (h < 100.0f) h = 100.0f;
+	if (h > 178.0f) h = 178.0f;
+	return h;
+}
+
+// Llamado desde HackerContext::Unmap con el mapeo vivo del cbuffer de camara, ANTES de
+// TripleCaptureCameraCB (que identifica la camara por m11/m00 y no debe ver el ancho).
+void TripleRestaurarM00(void *data, unsigned size)
+{
+	if (!data || size < 52 * 4 || g_m00_ancho <= 0.0f)
+		return;
+	float *f = (float *)data;
+	__try {
+		float m00 = f[0];
+		if (fabsf(m00 - g_m00_ancho) > 1e-5f * g_m00_ancho)
+			return;
+		float orig = g_m00_orig;
+		if (orig <= 0.0f || fabsf(orig - m00) <= 1e-6f * orig) {
+			InterlockedIncrement(&g_m00_sin_par);   // ahora: "coincidio pero no habia que tocar"
+			return;
+		}
+		if (bf_leer_modo_var() & 128) {
+			InterlockedIncrement(&g_m00_sin_par);   // bit 128: restauracion apagada a proposito
+			return;
+		}
+		float k = orig / m00;          // > 1: el m00 ancho es mas chico que el original
+		f[0] = orig;
+		if (f[16] != 0.0f)
+			f[16] /= k;
+		f[36] *= k;
+		f[40] *= k;
+		f[44] *= k;
+		f[48] *= k;
+		InterlockedIncrement(&g_m00_restauradas);
+	} __except (EXCEPTION_EXECUTE_HANDLER) { }
+}
+
+// Sin objetos C++ (SEH). Devuelve el multiplicador original si ensancho, 0 si no toco.
+static float tt_cam_ensanchar(intptr_t ctx, float *mult_nuevo_out)
+{
+	__try {
+		intptr_t rt = *(intptr_t *)(ctx + 0xFA0);
+		if (!rt) return 0.0f;
+		unsigned w = *(unsigned *)(rt + 0xA4), h = *(unsigned *)(rt + 0xA8);
+		if (w < 16 || h < 16 || w > 32768 || h > 32768) return 0.0f;
+		float mult = *(float *)(ctx + 0xFE0);
+		float fov = *(float *)(ctx + 0x1830);
+		if (!(mult > 0.01f) || !(mult < 100.0f) || !(fov > 0.02f) || !(fov < 2.9f)) return 0.0f;
+		float wh = (float)w / (float)h;
+		float aspecto = wh * mult;
+		if (aspecto < 1.0f || aspecto > 12.0f) return 0.0f;
+		float cot = 1.0f / tanf(fov * 0.5f);
+		float m00_orig = cot / aspecto;
+		float hfov_orig = 2.0f * atanf(1.0f / m00_orig) * 57.2957795f;
+		float objetivo = tt_hfov_objetivo();
+		float m00_ancho, mult_nuevo;
+		if (objetivo <= 0.0f) {
+			// hfov 0: el gancho corre entero (escribe y restaura ctx+0xFE0) pero el numero
+			// no cambia. Si el terreno mejora igual, el efecto es del gancho, no del ancho.
+			// (Corrida 5: mejora igual.) Nada que devolver al cbuffer: pendientes en 0.
+			m00_ancho = 0.0f;
+			mult_nuevo = mult;
+		} else {
+			float tan_h = tanf(objetivo * 0.5f * 0.017453292f);
+			m00_ancho = 1.0f / tan_h;
+			// m00 = cot / (wh * mult_nuevo) = m00_ancho  ->  mult_nuevo = cot / (wh * m00_ancho)
+			mult_nuevo = cot / (wh * m00_ancho);
+		}
+		*(float *)(ctx + 0xFE0) = mult_nuevo;
+		*mult_nuevo_out = mult_nuevo;
+		g_m00_orig_pendiente = m00_ancho > 0.0f ? m00_orig : 0.0f;
+		g_m00_ancho_pendiente = m00_ancho;
+		g_fe0_pre = mult;
+		if (InterlockedCompareExchange(&g_cam_log_una_vez, 1, 0) == 0)
+			LogInfo("TTCAM: vista principal fov=%.2f deg aspecto=%.4f (rt %ux%u x %.3f) m00 %.5f -> %.5f "
+				"(hfov %.1f -> %.1f deg), mult %.4f -> %.4f\n", fov * 57.2957795f, aspecto, w, h, mult,
+				m00_orig, m00_ancho, hfov_orig, objetivo, mult, mult_nuevo);
+		return mult;
+	} __except (EXCEPTION_EXECUTE_HANDLER) { return 0.0f; }
+}
+
+// Despues de la llamada original: restaura el multiplicador y publica el par
+// (m00 ancho -> m00 original) que TripleRestaurarM00 aplica al cbuffer. Corrida 4: cam+0x190
+// NO es la proyeccion (dio m00=0.753 m11=0.978), asi que no se lee nada de la camara.
+static void tt_cam_restaurar_mult(intptr_t ctx, intptr_t cam, float mult)
+{
+	(void)cam;
+	__try {
+		float post = *(float *)(ctx + 0xFE0);
+		g_fe0_post = post;
+		if (post != g_fe0_pre) {
+			InterlockedIncrement(&g_fe0_dif);
+			if (InterlockedIncrement(&g_fe0_dif_log) <= 3)
+				LogInfo("TTCAM: ctx+0xFE0 entro %.6f y el juego lo dejo en %.6f (la restauracion SI cambia algo)\n",
+					g_fe0_pre, post);
+		}
+		*(float *)(ctx + 0xFE0) = mult;
+		if (g_m00_ancho_pendiente <= 0.0f)
+			g_m00_ancho = 0.0f;                  // hfov 0: el cbuffer queda como esta
+		if (g_m00_ancho_pendiente > 0.0f && g_m00_orig_pendiente > 0.0f) {
+			g_m00_orig = g_m00_orig_pendiente;
+			g_m00_ancho = g_m00_ancho_pendiente;
+			if (InterlockedCompareExchange(&g_cam_log_una_vez, 2, 1) == 1)
+				LogInfo("TTCAM: par publicado: cbuffer f[0]=%.6f se devuelve a %.6f\n",
+					g_m00_ancho, g_m00_orig);
+		}
+	} __except (EXCEPTION_EXECUTE_HANDLER) { }
+}
+
+static void *__fastcall Hooked_CamUpdate(intptr_t ctx, intptr_t cam, intptr_t params, float f, unsigned n)
+{
+	InterlockedIncrement(&g_cam_llamadas);
+	tt_hfov_anunciar_cambio();
+	int modo = bf_leer_modo_var();
+	if ((modo & 64) == 0 || tt_replay_activo()) {
+		g_m00_ancho = 0.0f;                      // modo 0: el cbuffer no se toca
+		return g_cam_orig(ctx, cam, params, f, n);
+	}
+	float variante = tt_hfov_objetivo();
+	if (variante < 0.0f) {
+		// -1/-2/-3: pasante. No escribe ctx+0xFE0; mide que valor tiene antes y despues.
+		float pre = 0.0f, post = 0.0f;
+		__try { pre = *(float *)(ctx + 0xFE0); } __except (EXCEPTION_EXECUTE_HANDLER) { }
+		void *r = g_cam_orig(ctx, cam, params, f, n);
+		__try { post = *(float *)(ctx + 0xFE0); } __except (EXCEPTION_EXECUTE_HANDLER) { }
+		if (variante > -2.5f) {
+			// Rellena 24 KB de pila por DEBAJO de este marco (donde 9D9B80 acaba de dejar lo suyo
+			// y donde el culling del juego va a armar sus marcos al volver nosotros).
+			volatile unsigned char basura[24576];
+			unsigned char patron = variante < -1.5f ? 0xFF : 0x00;
+			for (size_t i = 0; i < sizeof(basura); i++) basura[i] = patron;
+			g_fe0_post = post + (float)basura[sizeof(basura) - 1] * 0.0f;   // que no se optimice
+		}
+		g_fe0_pre = pre; g_fe0_post = post;
+		if (post != pre) {
+			InterlockedIncrement(&g_fe0_dif);
+			if (InterlockedIncrement(&g_fe0_dif_log) <= 3)
+				LogInfo("TTCAM: (pasante) ctx+0xFE0 entro %.6f y el juego lo dejo en %.6f\n", pre, post);
+		}
+		g_m00_ancho = 0.0f;
+		InterlockedIncrement(&g_cam_saltadas);
+		return r;
+	}
+	float mult_nuevo = 0.0f;
+	float mult_orig = tt_cam_ensanchar(ctx, &mult_nuevo);
+	if (mult_orig == 0.0f) {
+		InterlockedIncrement(&g_cam_saltadas);
+		return g_cam_orig(ctx, cam, params, f, n);
+	}
+	void *r = g_cam_orig(ctx, cam, params, f, n);
+	tt_cam_restaurar_mult(ctx, cam, mult_orig);
+	InterlockedIncrement(&g_cam_ensanchadas);
+	return r;
+}
+
+// Redirige el unico CALL rel32 de 3C5B30 a 9D9B80 a un relay -> Hooked_CamUpdate. Mismo
+// metodo que los call sites de BuildFrustum: se verifica el opcode y el destino, y si
+// cambia el exe no se escribe un byte.
+static bool tt_cam_validar(const uint8_t *call, const uint8_t *destino)
+{
+	__try {
+		int32_t rel; memcpy(&rel, call + 1, 4);
+		return call[0] == 0xE8 && call + 5 + rel == destino;
+	} __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+
+static void tt_cam_instalar()
+{
+	if (InterlockedCompareExchange(&g_cam_hooked, 1, 0) != 0)
+		return;
+	HMODULE base = GetModuleHandleA(NULL);
+	if (!base) return;
+	uint8_t *call = (uint8_t *)base + TT_CAM_CALL_RVA;
+	uint8_t *destino = (uint8_t *)base + TT_CAM_FN_RVA;
+	if (!tt_cam_validar(call, destino)) {
+		LogInfo("TTCAM: el call site exe+0x%X no coincide con el EXE investigado; no se parcheo.\n",
+			(unsigned)TT_CAM_CALL_RVA);
+		return;
+	}
+	g_cam_orig = (tt_cam_fn)destino;
+	uint8_t *relay = (uint8_t *)bf_alloc_relay_near((uintptr_t)base);
+	if (!relay) {
+		LogInfo("TTCAM: no pude reservar relay cercano; no se parcheo nada.\n");
+		return;
+	}
+	relay[0] = 0x48; relay[1] = 0xB8;
+	void *wrapper = (void *)&Hooked_CamUpdate;
+	memcpy(relay + 2, &wrapper, 8);
+	relay[10] = 0xFF; relay[11] = 0xE0;
+	FlushInstructionCache(GetCurrentProcess(), relay, 12);
+	DWORD relayOld; VirtualProtect(relay, 0x1000, PAGE_EXECUTE_READ, &relayOld);
+
+	std::vector<HANDLE> pausados;
+	pausados.reserve(256);
+	HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+	if (snap != INVALID_HANDLE_VALUE) {
+		THREADENTRY32 te = {}; te.dwSize = sizeof(te);
+		DWORD pid = GetCurrentProcessId(), self = GetCurrentThreadId();
+		if (Thread32First(snap, &te)) do {
+			if (te.th32OwnerProcessID != pid || te.th32ThreadID == self) continue;
+			HANDLE h = OpenThread(THREAD_SUSPEND_RESUME, FALSE, te.th32ThreadID);
+			if (h && SuspendThread(h) != (DWORD)-1) pausados.push_back(h);
+			else if (h) CloseHandle(h);
+		} while (Thread32Next(snap, &te));
+		CloseHandle(snap);
+	}
+	bool ok = false;
+	intptr_t delta = relay - (call + 5);
+	DWORD oldProtect;
+	if (delta >= INT32_MIN && delta <= INT32_MAX &&
+	    VirtualProtect(call, 5, PAGE_EXECUTE_READWRITE, &oldProtect)) {
+		int32_t rel = (int32_t)delta;
+		memcpy(call + 1, &rel, 4);
+		FlushInstructionCache(GetCurrentProcess(), call, 5);
+		DWORD ignored; VirtualProtect(call, 5, oldProtect, &ignored);
+		ok = true;
+	}
+	for (auto h : pausados) { ResumeThread(h); CloseHandle(h); }
+	LogInfo(ok ? "TTCAM: call exe+0x%X redirigido; bit 64 ensancha la matriz de la vista principal a $cull_hfov.\n"
+	           : "TTCAM: ERROR al escribir el call exe+0x%X; nada cambiado.\n", (unsigned)TT_CAM_CALL_RVA);
+}
+
+// Se instala SOLO si el usuario pidio un modo de call sites (bit 16 o 32 de
+// $cull_widen). Con 0 no se toca un byte del exe. Un solo intento, un solo parche.
+static void bf_instalar_si_pedido()
+{
+	if (g_bf_hooked && g_cam_hooked)
+		return;
+	int modo = bf_leer_modo_var();
+	if (modo & 64)
+		tt_cam_instalar();
+	if ((modo & (16 | 32)) == 0 && !bf_sombras_activas())
+		return;
+	triple_install_buildfrustum_hook();
+}
+
+// Cada 2 s: llamadas/aperturas por call site, el modo del contexto (ctx+0x1E98) y el
+// FOV que trae CS10. Es lo que faltaba el 4 de septiembre: el registro era one-shot
+// por sitio y no probaba cobertura durante la conduccion. Formato: CSnn:llamadas/abiertos.
+static void bf_reportar()
+{
+	if (!g_bf_hooked && !g_cam_hooked)
+		return;
+	ULONGLONG ahora = GetTickCount64();
+	if (g_bf_ultimo_reporte && ahora - g_bf_ultimo_reporte < 2000)
+		return;
+	g_bf_ultimo_reporte = ahora;
+	CommandListVariable *grass = cl_global(L"$pasto_frustum_mode");
+	LogInfo("GRASSSTAT: frustum_mode=%.0f\n", grass ? grass->fval : -1.0f);
+	if(bf_leer_modo_var() & 1024) LogInfo("CULLRANGE: CS10 box half extent %.1f world units\n", g_bf_box_radius);
+	LONG cam_llam = InterlockedExchange(&g_cam_llamadas, 0);
+	LONG cam_ens = InterlockedExchange(&g_cam_ensanchadas, 0);
+	LONG cam_salt = InterlockedExchange(&g_cam_saltadas, 0);
+	LONG m00rest = InterlockedExchange(&g_m00_restauradas, 0);
+	LONG sinpar = InterlockedExchange(&g_m00_sin_par, 0);
+	InterlockedExchange(&g_osd_cam_llam, cam_llam);
+	InterlockedExchange(&g_osd_cam_ens, cam_ens);
+	InterlockedExchange(&g_osd_m00rest, m00rest);
+	InterlockedExchange(&g_osd_sinpar, sinpar);
+	char linea[1024];
+	int n = _snprintf_s(linea, sizeof(linea), _TRUNCATE,
+		"BFSTAT: cull_widen=%d site=%d hfov=%.0f cam=%ld/%ld/%ld m00rest=%ld sinpar=%ld fe0=%.4f->%.4f dif=%ld CS10fov=%.1fx%.1f | frame=%u |",
+		bf_leer_modo_var(), bf_leer_site_var(), tt_hfov_objetivo(),
+		cam_llam, cam_ens, cam_salt, m00rest, sinpar,
+		g_fe0_pre, g_fe0_post, InterlockedExchange(&g_fe0_dif, 0),
+		(float)InterlockedCompareExchange(&g_bf_cs10_fov_h, 0, 0) / 10.0f,
+		(float)InterlockedCompareExchange(&g_bf_cs10_fov_v, 0, 0) / 10.0f,
+		G ? G->frame_no : 0u);
+	if (n < 0) n = 0;
+	for (int i = 0; i < (int)_countof(g_bf_call_rvas); i++) {
+		LONG c = InterlockedExchange(&g_bf_site_calls[i], 0);
+		LONG o = InterlockedExchange(&g_bf_site_open[i], 0);
+		if (c == 0 && o == 0)
+			continue;
+		if (n >= (int)sizeof(linea) - 32)
+			break;
+		int r = _snprintf_s(linea + n, sizeof(linea) - n, _TRUNCATE, " CS%02d:%ld/%ld", i + 1, c, o);
+		if (r < 0) break;
+		n += r;
+	}
+	LogInfo("%s\n", linea);
+}
+
+// Linea PERMANENTE del overlay (la dibuja Overlay::DrawOverlay en cada frame mientras
+// haya algun gancho instalado). Existe porque las capturas del 5 de septiembre no
+// decian en que modo estaban: el aviso de cambio dura 10 s y con el bit 64 decia
+// "frustum original". Con el numero de frame, una captura se cruza con el log sin
+// adivinar. Vacia (buf[0] == 0) si no hay nada que mostrar.
+void TripleCullingOSD(wchar_t *buf, size_t n)
+{
+	buf[0] = 0;
+	int modo = bf_leer_modo_var();
+	if (!g_bf_var && !g_bf_hooked && !g_cam_hooked)
+		return;
+	char que[128];
+	bf_describir_modo(modo, que, sizeof(que));
+	CommandListVariable *grass = cl_global(L"$pasto_frustum_mode");
+	int k = _snwprintf_s(buf, n, _TRUNCATE, L"CULLING modo %d = %S | grass %.0f", modo, que, grass ? grass->fval : -1.0f);
+	if (k < 0) return;
+	if (modo & 32) {
+		int extra = bf_leer_site_var();
+		int r = 0;
+		if (extra == 99) r = _snwprintf_s(buf + k, n - k, _TRUNCATE, L" + TODOS los sitios");
+		else if (extra >= 1 && extra <= (int)_countof(g_bf_call_rvas)) r = _snwprintf_s(buf + k, n - k, _TRUNCATE, L" + CS%02d", extra);
+		if (r < 0) return;
+		k += r;
+	}
+	_snwprintf_s(buf + k, n - k, _TRUNCATE, L" | cam %ld/%ld m00rest %ld | fe0 %.3f>%.3f | frame %u",
+		InterlockedCompareExchange(&g_osd_cam_llam, 0, 0), InterlockedCompareExchange(&g_osd_cam_ens, 0, 0),
+		InterlockedCompareExchange(&g_osd_m00rest, 0, 0), g_fe0_pre, g_fe0_post,
+		G ? G->frame_no : 0u);
+}
+
+// ===========================================================================
+// CORRIDA AUTOMATICA (2026-09-05): el autor deja el auto quieto, aprieta una tecla y el mod
+// recorre los estados solo, sostiene cada uno TT_AUTO_SEG segundos, guarda el backbuffer a
+// un JPG (con la linea amarilla adentro) y pasa al siguiente. Existe porque las corridas
+// 3 a 6 se leyeron mal por ciclar rapido: cada captura media el estado ANTERIOR.
+// Se arranca con $cull_auto = 1 (tecla en la plantilla de prueba); volverla a 0 la aborta.
+// ===========================================================================
+#include <wincodec.h>
+#include <ScreenGrab.h>
+#define TT_AUTO_SEG 12
+struct tt_auto_paso { int modo; float hfov; const char *nombre; };
+static const tt_auto_paso g_auto_pasos[] = {
+	{ 0,  172.0f, "A-modo0-juego-original" },
+	{ 64, 172.0f, "B-modo64-matriz172" },
+	{ 64,   0.0f, "C-modo64-hfov0-matriz-original" },
+	{ 64, 172.0f, "D-modo64-matriz172" },
+	{ 0,  172.0f, "E-modo0-de-nuevo" },
+};
+static volatile LONG g_auto_estado = 0;      // 0 apagado, 1 corriendo, 2 terminado
+static int g_auto_paso = -1;
+static ULONGLONG g_auto_t0 = 0, g_auto_aviso_hasta = 0;
+static wchar_t g_auto_dir[MAX_PATH] = L"";
+static int g_auto_guardadas = 0, g_auto_fallidas = 0;
+static CommandListVariable *g_auto_var = NULL;
+static volatile LONG g_auto_var_init = 0;
+
+static float tt_auto_leer_var()
+{
+	if (!g_auto_var_init) {
+		auto it = command_list_globals.find(L"$cull_auto");
+		if (it != command_list_globals.end())
+			g_auto_var = &it->second;
+		InterlockedExchange(&g_auto_var_init, 1);
+	}
+	return g_auto_var ? g_auto_var->fval : 0.0f;
+}
+
+static void tt_auto_poner_estado(int modo, float hfov)
+{
+	bf_leer_modo_var(); tt_hfov_objetivo();       // aseguran los punteros a las variables
+	if (g_bf_var) g_bf_var->fval = (float)modo;
+	if (g_hfov_var) g_hfov_var->fval = hfov;
+}
+
+static void tt_auto_capturar(IDXGISwapChain *sc, ID3D11DeviceContext *ctx, const char *nombre, int idx)
+{
+	ID3D11Texture2D *bb = NULL;
+	if (!sc || !ctx || FAILED(sc->GetBuffer(0, __uuidof(ID3D11Texture2D), (void **)&bb)) || !bb) {
+		LogInfo("AUTO: no pude tomar el backbuffer para %s\n", nombre);
+		g_auto_fallidas++;
+		return;
+	}
+	wchar_t ruta[MAX_PATH];
+	_snwprintf_s(ruta, _countof(ruta), _TRUNCATE, L"%s\\%02d-%S.jpg", g_auto_dir, idx + 1, nombre);
+	HRESULT hr = DirectX::SaveWICTextureToFile(ctx, bb, GUID_ContainerFormatJpeg, ruta);
+	bb->Release();
+	if (SUCCEEDED(hr)) {
+		g_auto_guardadas++;
+		LogInfo("AUTO: captura %d guardada: %S (frame %u)\n", idx + 1, ruta, G ? G->frame_no : 0u);
+	} else {
+		g_auto_fallidas++;
+		LogInfo("AUTO: SaveWICTextureToFile fallo hr=0x%08X para %S\n", (unsigned)hr, ruta);
+	}
+}
