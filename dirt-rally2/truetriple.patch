+static void triple_gc_repetir_tramos(HackerContext *ctx, ID3D11Buffer *args,
+	UINT offset, UINT64 vs_hash, bool indexado)
+{
+	if (tls_gc_repitiendo || !es_vs_clutter(vs_hash) || !args)
+		return;
