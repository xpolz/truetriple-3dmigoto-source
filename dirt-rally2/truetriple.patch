+#define BF_SITIO_CS10 9
+static volatile LONG g_bf_site_calls[32];
+static volatile LONG g_bf_site_open[32];
+static volatile LONG g_bf_cs10_fov_h = 0, g_bf_cs10_fov_v = 0;   // ultimo FOV visto en CS10, decimas de grado
