+		// MEDICION (temporal): la posicion de camara al log, una vez cada 300
+		// frames. El muestreo anterior cada 3 frames genero decenas de miles de
+		// escrituras sincronas por sesion y ya no era necesario para diagnosticar
+		// el rebote. Un numero en pantalla solo dice cuanto vale AHORA; lo que hace
+		// falta saber es si se MUEVE y cuanto, y eso es una serie en el tiempo.
+		// Con media docena de lineas alcanza para ver si el rebote existe y de
+		// que tamano es, sin hacer probar de nuevo.
+		{
+			static unsigned ultimo = 0;
+			if (G->frame_no - ultimo >= 300) {
+				ultimo = G->frame_no;
+				LogInfo("TTCAM f=%u y=%.4f y4=%.5f m11=%.3f rv=%.5f %.5f %.5f %.5f %.5f %.5f\n",
+					G->frame_no, f[33],
+					// y4 = el desplazamiento que YA llega a los shaders.
+					(G->iniParams.size() >= 5) ? G->iniParams[4].y : -999.0f,
+					f[5],
+					// relativeView: rotacion pura de la camara, floats 52..63 del
+					// buffer. Valores entre -1 y 1, o sea sin el problema de precision
+					// que tiene la altura absoluta. Se vuelcan seis componentes para
+					// poder MEDIR cuanto pesa el cabeceo frente al rebote vertical:
+					// si el traqueteo es sobre todo angular, mover la camara en Y no
+					// puede tocarlo por mucho que se ajusten las constantes.
+					f[52], f[53], f[54], f[56], f[57], f[58]);
+			}
+		}
