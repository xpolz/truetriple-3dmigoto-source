+// Called from HackerContext when the game writes a constant buffer that looks
+// like the main perspective camera (cb3 = CameraParamsConstantBuffer). Captures
+// it CPU-side so no GPU readback is needed.
+// ===========================================================================
+// IDENTIFICACION DEL AUTO POR SU MALLA (v1.36)
+//
+// El problema: el usuario quiere una postura de asiento por camara Y por auto,
+// pero nada de lo que veniamos leyendo distingue el auto. Medido: las camaras de
+// DiRT tienen los mismos parametros en todos los autos (se probo con dos autos y
+// no aparecio ni una firma nueva).
+//
+// Por que la MALLA y no una textura: 3Dmigoto hashea los recursos por CONTENIDO,
+// asi que la textura del auto serviria... hasta que el usuario le cambia la
+// pintura, y ahi el mismo auto pasa a parecer otro. Lo hizo notar el propio
+// usuario. La geometria del interior, en cambio, es la misma pintes como pintes.
+//
+// De donde sale el shader: de una caza del usuario. Al saltear
+// d0d1ddd09d064e71 el interior del auto se pone negro, y ese shader visita 19
+// mallas distintas (los pedazos del habitaculo: volante, tablero, puertas...) y
+// solo 2 texturas en el registro 0 — un shader generico de pista tendria
+// cientos, asi que es del auto. La caza se hace UNA sola vez en la vida del
+// proyecto, no una por auto: de aca en mas el mod aprende cada auto solo.
+//
+// La huella es el hash de la malla MAS GRANDE que dibuje ese shader en el frame
+// (la carroceria del habitaculo). Se elige la mas grande y no el conjunto entero
+// porque el conjunto cambia con el culling de las piezas chicas, mientras que la
+// pieza principal se dibuja siempre.
+//
+// CONTEXTOS DIFERIDOS (regla 5): esto corre en los 7 contextos del juego y el
+// "maximo del frame" es un global sin candado. Una carrera puede hacer que un
+// frame suelto publique la malla equivocada. Es tolerable a proposito: el que
+// consume la huella exige que se mantenga varios frames seguidos antes de
+// hacerle caso, igual que con las camaras. Un candado por draw costaria mas que
+// el problema que evita.
+// ===========================================================================
+// OJO (v1.86): ES UNA LECTURA DE INSTRUMENTO, NO UNA IDENTIDAD CON AUTORIDAD.
+//
+// La identidad del auto es MANUAL desde v1.85: el global $auto_elegido del ini
+// (1..82 en la v14), que cicla el usuario con teclas. Este tracker NO la
+// decide y no
+// puede pisarla — solo dice "el habitaculo que se esta dibujando ahora tiene
+// esta huella". Se publica de nuevo en iniParams[8].x (en v1.85 quedo mudo,
+// solo con su LogInfo) porque la plantilla v13 la usa para una tabla
+// huella<->auto ENSENADA por las selecciones del propio usuario: si el cockpit
+// que se ve ya fue asociado a un auto, el menu se auto-selecciona; si no
+// figura, no pasa NADA y el usuario elige a mano como hasta ahora.
+//
+// Por que este canal SI es seguro, cuando el exterior latcheado de v1.84 no lo
+// era: el juego nunca dibuja el habitaculo de un rival. Lo unico que puede
+// llegar por aca es TU auto o nada — a diferencia de la carroceria exterior,
+// que en rallycross tiene los otros autos en pantalla y fue justo por donde se
+// heredaron dos identidades equivocadas (ver la lapida de abajo).
+//
+// La derivacion es & 0x00FFFFFF y NO SE TOCA: son los 24 bits bajos, o sea la
+// mantisa entera de un float32. Arriba de 2^23 el float no tiene medios, el ini
+// compara por diferencia con ±0.5 y la ventana colapsa: dos autos distintos
+// podrian dar "igual". Ademas es la misma derivacion que imprime el log desde
+// v1.36, asi que las corridas viejas siguen siendo comparables.
+//
+// ⚠️ Y CADUCA AL VOLVER AL FRONTEND (v1.86). Ver TripleCaducarHuellaAuto, abajo:
+// sin eso la ultima huella vista quedaba latcheada para siempre y el auto
+// SIGUIENTE heredaba la identidad del anterior.
+#define TRIPLE_CAR_VS 0xd0d1ddd09d064e71ULL
+
+// El estado del tracker vive AFUERA de la funcion (v1.86) nada mas que porque
+// TripleCaducarHuellaAuto tiene que poder ponerlo en cero. Antes eran statics
+// locales; el comportamiento no cambia.
+static unsigned g_car_frame = 0xFFFFFFFF;
+static UINT     g_car_mejor_n = 0;
+static uint32_t g_car_mejor_ib = 0;
+static uint32_t g_car_publicada = 0;   // lo ultimo que se publico en x8 (0 = nada)
+
+void TripleTrackCarMesh(UINT64 vs_hash, uint32_t ib_hash, UINT index_count)
+{
+	if (!ib_hash || vs_hash != TRIPLE_CAR_VS)
+		return;
+
+	unsigned &frame = g_car_frame;
+	UINT     &mejor_n = g_car_mejor_n;
+	uint32_t &mejor_ib = g_car_mejor_ib;
+
+	if (G->frame_no != frame) {
+		// Cierre del frame anterior: se publica el ganador (v1.86) y se lo
+		// anota en el log. Los dos usan la MISMA derivacion, asi que la huella
+		// que sale por el log es exactamente la que ve el ini: si alguna vez no
+		// coincidieran, el diagnostico por el log mentiria.
+		if (mejor_ib) {
+			if (G->iniParams.size() >= 9)
+				G->iniParams[8].x = (float)(mejor_ib & 0x00FFFFFF);
+			g_car_publicada = mejor_ib;
+
+			// Log deduplicado: una linea por malla distinta. Con esto se ve si la
+			// huella es estable dentro de un auto y si cambia entre autos.
+			static uint32_t vistos[64];
+			static int nvistos = 0;
+			bool nuevo = true;
+			for (int k = 0; k < nvistos; k++)
+				if (vistos[k] == mejor_ib) { nuevo = false; break; }
+			if (nuevo && nvistos < 64) {
+				vistos[nvistos++] = mejor_ib;
+				LogInfo("TRIPLE car mesh #%d: ib=%08x indices=%u -> huella=%.0f\n",
+					nvistos - 1, mejor_ib, mejor_n,
+					(double)(mejor_ib & 0x00FFFFFF));
+			}
+		}
+		frame = G->frame_no;
+		mejor_n = 0;
+		mejor_ib = 0;
+	}
+
+	if (index_count > mejor_n) {
+		mejor_n = index_count;
+		mejor_ib = ib_hash;
+	}
+}
+
+// ===========================================================================
+// LA HUELLA CADUCA AL VOLVER AL FRONTEND (v1.86)
+//
+// EL BUG QUE CIERRA, dicho como lo vive el autor: cambia de auto por el
+// frontend y larga en CAPO, que es su vista habitual. El habitaculo del auto
+// nuevo NO se dibuja nunca, asi que x8 seguia trayendo la huella del auto
+// ANTERIOR, la auto-seleccion elegia el auto anterior, y la postura se guardaba
+// bajo el auto equivocado EN SILENCIO. Es la falla que mato al latch exterior
+// de v1.84, reencarnada por el otro lado.
+//
+// POR QUE NO SE PUEDE CADUCAR "POR FRAMES SIN VER EL HABITACULO", que es lo
+// primero que uno escribe: el autor guarda y carga desde CAPO, y ahi el
+// interior tampoco se dibuja. Caducar por ausencia le mataria la identidad en
+// pleno tramo — o sea el caso bueno. La identidad TIENE que sobrevivir mientras
+// siga siendo el mismo auto.
+//
+// LA SEÑAL CORRECTA ES VOLVER AL FRONTEND: entre auto y auto se pasa si o si
+// por menus o garage. Y no hace falta inventar como detectarlo: es la MISMA
+// lista negra de camaras del motor que publica x3 desde v1.41
+// (tt_es_camara_de_menu), constantes bit-exactas que el usuario no puede tocar.
+//
+// ⚠️ EL RIESGO ES CADUCAR EN PLENO TRAMO — ahi al autor se le bloquean los
+// slots manejando. Dos cosas lo sostienen, y ninguna es una opinion:
+//
+//  1. La señal ya esta probada en el campo. x3 usa exactamente este predicado
+//     y pone el mod en PASSTHROUGH cuando da 1. Si una camara de la lista negra
+//     pasara el gate de arriba (pantalla completa + aspecto de triple) mientras
+//     se maneja, el mod estaria en passthrough manejando y no funcionaria nunca
+//     — y funciona, confirmado en el juego desde v1.41. O sea que el falso
+//     positivo en pista no es "improbable": es incompatible con que el mod ande.
+//     (El comentario de mas abajo avisa que la ULTIMA camara del frame es
+//     siempre la del frontend; esa no pasa el gate `f[5] <= 3.0f` que la
+//     excluye de w3/w7, y sobre todo no puede pasar el de x3 sin romper el mod.)
+//  2. Aun asi, ANTIRREBOTE: no alcanza con ver el frontend una vez. Hacen falta
+//     TRIPLE_MENU_CADUCA frames SEGUIDOS. Un frame suelto no borra nada.
+//
+// ⚠️ El antirrebote es por frames SEGUIDOS y no por "se vio en los ultimos N",
+// que es la forma en la que se suele escribir esto y **no protege de nada**:
+// con esa, un unico frame raro ya dispara la caducidad y el daño esta hecho.
+// Aca la racha se corta apenas pase un frame entero sin frontend. Ir al garage
+// son segundos, o sea cientos de frames: el caso real lo cumple de sobra.
+//
+// El numero es 12, el mismo que $menu_hold y que el CAR_ESTABLE del ini — es el
+// numero que este proyecto ya usa para "no le creas a un frame solo", y tener
+// uno nuevo seria una constante mas que explicar.
+//
+// Deja rastro en el log (una linea por caducidad, no por frame) para poder leer
+// despues si caduco cuando no debia.
+// ===========================================================================
+#define TRIPLE_MENU_CADUCA 12
+
+static void TripleCaducarHuellaAuto(void)
+{
+	// Idempotente: si ya estaba en cero no se re-escribe ni se re-loguea. Sin
+	// esto seria una linea de log por frame durante todo el menu.
+	if (!g_car_publicada && !g_car_mejor_ib)
+		return;
+
+	LogInfo("TRIPLE car mesh: huella caducada (frontend)\n");
+
+	// Se limpia TAMBIEN el ganador del frame en curso: si no, al volver a una
+	// vista de cockpit el cierre de frame publicaria una vez la huella vieja
+	// antes de que los dibujos nuevos la pisen. Un frame solo no le alcanza al
+	// ini (exige 12 seguidos), pero es basura que no tiene por que existir.
+	g_car_mejor_n = 0;
+	g_car_mejor_ib = 0;
+	g_car_publicada = 0;
+	if (G->iniParams.size() >= 9)
+		G->iniParams[8].x = 0.0f;
+}
+
+// LAPIDA (v1.85): aca vivio TripleTrackCarMeshExt (v1.84) — la huella de la
+// carroceria exterior (VS 206e8426c2576e52) latcheada en la orbita del
+// garage, con compuerta doble contra la cola del garage post-largada e
+// invalidacion por cambio de habitaculo. Murio por dos fallos reales de
+// identidad heredada entre autos (el preset del auto A aplicado al auto B),
+// y la decision del autor fue identidad MANUAL ($auto_elegido): "no quiero
+// fallos; si falla, mejor solo menu". Codigo que no existe no falla. La
+// historia completa esta en git (commits c0fa00e y fcc7525).
+
+// LISTA NEGRA de camaras del motor (v1.41). Los tres m11 de las camaras que NO
+// deben recibir el triple: menu principal, menu del garage y la orbita del
+// garage. Son CONSTANTES del juego, bit-exactas en toda sesion — a diferencia
+// del rango de "camaras de conduccion" que se uso antes, que en realidad media
+// el slider de FOV del usuario (m11 = 1/tan(fovV/2), ajustable POR CAMARA en
+// DiRT) y por eso se rompio dos veces. La tolerancia 0.01 en espacio m11 es
+// generosa para constantes exactas y chica frente a la camara real mas cercana
+// medida (cockpit 3.732 vs menu2 3.546: distancia 0.186).
+// El ASM de los shaders hace la misma comparacion por su cuenta (fila 5 de
+// IniParams, publicada por [Present]); esta copia es para los flags x3/x9.
+static inline bool tt_es_camara_de_menu(float m11)
+{
+	const float negras[3] = { 4.272611f, 3.545733f, 1.000000f };
+	for (int i = 0; i < 3; i++) {
+		float d = m11 - negras[i];
+		if (d < 0) d = -d;
+		if (d < 0.01f)
+			return true;
+	}
+	return false;
+}
+
+// Ultimo frame con una camara de la lista negra en pantalla, y el frame en que
+// arranco la RACHA seguida de esas camaras. Eran statics locales del bloque de
+// x3; se subieron a este alcance (v1.86) porque la caducidad de la huella del
+// auto necesita la racha. La logica de x3 no cambio.
+static unsigned g_triple_menu_frame = 0x80000000;
+static unsigned g_triple_menu_racha = 0x80000000;
+
+#include "VisibilityProbe.h"
+
+void TripleCaptureCameraCB(const void *data, unsigned size)
+{
+	// Se actualiza antes de filtrar el buffer: el estado pertenece al renderer,
+	// no a una camara concreta. [Present] lo recibe en `$en_replay` y lo usa en
+	// el frame siguiente; los caminos C++ de culling leen el flag inmediatamente.
+	tt_replay_update();
+	TTVisibilityProbe::tick();
+
+	// 2026-09-05: relay de call sites, instalado SOLO si $cull_widen trae el bit 16 o 32
+	// (con 0 no se toca un byte del exe). El bit 32 abre unicamente CS10, la query de la
+	// vista principal, sin compuerta de FOV. Ver docs/CULLING-GHIDRA-2026-09-05.md.
+	bf_instalar_si_pedido();
+	bf_reportar();
+
+	if (!data || size < 208 || size > sizeof(g_triple_cam_buf))
+		return;
+	const float *f = (const float*)data;
+	float aspect = (f[0] != 0.0f) ? (f[5] / f[0]) : 0.0f;
+
+	// Gate: solo la camara PRINCIPAL (perspectiva m33~0 + aspecto de triple).
+	//
+	// El rango era 4.5-6.5, hecho a medida del rig del autor (3x 2560x1440 =
+	// 5.39). Eso dejaba afuera EN SILENCIO a cualquier otro triple: tres
+	// ultrawide 21:9 dan 7.1, tres pantallas 5:4 dan 3.75. Esos usuarios
+	// instalaban el mod y no les pasaba absolutamente nada, sin un solo aviso.
+	// Aparecio probando otra cosa (bajar la resolucion para ensanchar el
+	// culling): el aspecto se fue a 7.18 y el mod dejo de ver camaras.
+	//
+	// Ahora cubre de 3x 5:4 (3.75) a 3x 32:9 (10.67) con margen. El piso 3.6
+	// sigue excluyendo los espejos del juego, que son 768x256 = 3.0 exacto, y
+	// el envmap, que es 1.0.
+	if (f[51] < 0.5f && aspect > 3.6f && aspect < 12.0f) {
+		memcpy(g_triple_cam_buf, data, size);
+		g_triple_cam_size = size;
+		g_triple_cam_valid = true;
+
+		// v1.26: DETECCION DE MENU. La camara de fondo del frontend tiene una
+		// firma inconfundible (m11 = 4.2726 / 3.5457; las de conduccion van de
+		// 1.9 a 2.5 y el garage es 1.0). Si en los ultimos frames se escribio
+		// una camara con m11 > 3.0, publicamos x3 = 1 y el d3dx.ini pasa el
+		// triple a passthrough -> los menus se ven como el juego normal.
+		// (Identificada por el analisis del volcado: el fondo 3D del menu usa
+		// los MISMOS shaders de mundo; la UI 2D nunca declara cb3.)
+		{
+			// v1.41: el umbral "m11 > 3.0" dejo de servir — el cockpit del
+			// usuario tiene FOV de 30 grados = m11 3.732, o sea que manejar
+			// contaba como "menu". Se pasa al mismo criterio que el resto: la
+			// LISTA NEGRA de camaras del motor (constantes bit-exactas que el
+			// usuario no puede tocar). Ver tt_es_camara_de_menu().
+			if (tt_es_camara_de_menu(f[5])) {
+				// v1.86: la RACHA de frames seguidos con el frontend en
+				// pantalla. Si paso un frame ENTERO sin ninguna camara de la
+				// lista negra, la racha se corto y vuelve a empezar. Que la
+				// diferencia sea > 1 (y no > 0) es lo que deja seguir la racha
+				// cuando el juego escribe varias camaras de menu en el mismo
+				// frame, que es el caso normal.
+				if ((unsigned)(G->frame_no - g_triple_menu_frame) > 1)
+					g_triple_menu_racha = G->frame_no;
+				g_triple_menu_frame = G->frame_no;
+
+				// ⛔ v1.87 — LA CADUCIDAD AUTOMATICA ESTA APAGADA. NO
+				// REACTIVARLA SIN ARREGLAR ANTES EL PREDICADO.
+				//
+				// La v1.86 llamaba aca a TripleCaducarHuellaAuto() con la racha
+				// hecha. MEDIDO en la corrida del 2026-08-17: caduco 14.304
+				// veces entre los frames 4378 y 14482 —diez mil frames
+				// SEGUIDOS, o sea minutos de tramo— mientras la camara viva
+				// era de CONDUCCION (m11 1.428 y 1.921). La huella no sobrevivio
+				// ni un cierre de frame: el log quedo con 14.304 caducidades y
+				// CERO publicaciones, asi que el auto no se reconocia nunca y
+				// Ctrl+F2 no tenia nada que vincular.
+				//
+				// LA LECCION, que es la que importa: se dio por bueno este
+				// predicado razonando que "si diera falso positivo en pista, x3
+				// pondria el mod en passthrough y el mod no andaria — y anda".
+				// El razonamiento es invalido. x3 solo gobierna la logica del
+				// INI; el passthrough de verdad lo deciden los shaders por su
+				// cuenta, comparando el m11 del propio draw (ver el comentario
+				// de tt_es_camara_de_menu). O sea que este predicado venia
