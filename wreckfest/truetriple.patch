+
+// TrueTriple (2026-11-01): ver Overlay.h. Mismo canal que LogOverlay(LOG_WARNING):
+// LOG_WARNING no tiene hide_in_release, asi que se dibuja tambien fuera de caza.
+// Reemplazar en vez de apilar importa con las teclas con repeat: mantener
+// apretado el bisel cambia el valor cada pocos frames y sin esto se llenaria la
+// columna de lineas viejas.
+void LogOverlayTrueTriple(int tipo, const char *fmt, ...)
+{
+	char amsg[maxstring];
+	wchar_t wmsg[maxstring];
+	va_list ap;
+
+	va_start(ap, fmt);
+	_vsnprintf_s(amsg, maxstring, _TRUNCATE, fmt, ap);
+	va_end(ap);
+
+	LogInfo("%s", amsg);
+	mbstowcs(wmsg, amsg, maxstring);
+	wmsg[maxstring - 1] = L'\0';
+
+	EnterCriticalSectionPretty(&notices.lock);
+
+	std::vector<OverlayNotice> &v = notices.notices[LOG_WARNING];
+	if (tipo > 0) {
+		for (auto it = v.begin(); it != v.end(); ) {
+			if (it->tt_tipo == tipo)
+				it = v.erase(it);
+			else
+				++it;
+		}
+	}
+	v.emplace_back(wmsg, tipo);
+	has_notice = true;
+
+	LeaveCriticalSection(&notices.lock);
+}
