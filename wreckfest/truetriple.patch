+// -----------------------------------------------------------------------------
+// TrueTriple Wreckfest (2026-11-01): un modo de pantalla triple en la lista de
+// resoluciones del juego.
+//
+//     [Device]
+//     triple_window_mode = 7680 1440      ; ausente o 0 = no cambia nada
+//
+// Por que: Wreckfest dibuja la escena con SU resolucion interna, no con la del
+// backbuffer (con [Device] width=7680 el backbuffer sale de 7680 y la escena
+// ocupa los 2560 de la izquierda), y esa resolucion vive en settings.conf, que
+// tiene suma de control propia y no se puede escribir desde afuera. Lo unico
+// que queda es que el propio juego la elija: para eso tiene que aparecer en su
+// lista, que arma con IDXGIOutput::GetDisplayModeList.
+//
+// Como: se engancha el CODIGO de GetDisplayModeList, GetDisplayModeList1 y
+// FindClosestMatchingMode (Nektra, mismo patron que CreateSwapChain), sacando
+// las direcciones de la vtable de la primera salida que se encuentre. La
+// implementacion de dxgi es una sola, asi que vale para todas las salidas.
+// A la lista de cada salida se le suma W x H copiando formato, refresco,
+// scanline y scaling del modo mas ANCHO que tenga el mismo alto (una entrada
+// por cada variante de ese modo, o sea una por refresco).
+//
+// Riesgo: el modo no existe en ningun monitor. En Modo Ventana el juego solo
+// crea una ventana de ese tamano (es lo que se busca). En pantalla completa
+// exclusiva DXGI intentaria un cambio de modo imposible: la app tiene que
+// decirle al usuario que elija Modo Ventana. Ver docs/DLL-HECHO-2026-11-01.md.
+//
+// Reentrada: dxgi puede implementar una variante llamando a la otra. Mientras
+// uno de estos ganchos esta adentro, los demas pasan derecho (contador por
+// hilo), si no el modo se agregaria dos veces.
+
+typedef HRESULT(__stdcall *tt_tGetDisplayModeList)(IDXGIOutput *This,
+	DXGI_FORMAT EnumFormat, UINT Flags, UINT *pNumModes, DXGI_MODE_DESC *pDesc);
+typedef HRESULT(__stdcall *tt_tGetDisplayModeList1)(IDXGIOutput1 *This,
+	DXGI_FORMAT EnumFormat, UINT Flags, UINT *pNumModes, DXGI_MODE_DESC1 *pDesc);
+typedef HRESULT(__stdcall *tt_tFindClosestMatchingMode)(IDXGIOutput *This,
+	const DXGI_MODE_DESC *pModeToMatch, DXGI_MODE_DESC *pClosestMatch, IUnknown *pConcernedDevice);
+
+static tt_tGetDisplayModeList      fnOrigGetDisplayModeList = nullptr;
+static tt_tGetDisplayModeList1     fnOrigGetDisplayModeList1 = nullptr;
+static tt_tFindClosestMatchingMode fnOrigFindClosestMatchingMode = nullptr;
+
+static thread_local int tt_modos_dentro = 0;
+
+struct tt_guardia_modos {
+	tt_guardia_modos() { tt_modos_dentro++; }
+	~tt_guardia_modos() { tt_modos_dentro--; }
+};
+
+template <typename Desc>
+static bool tt_mismo_modo(const Desc &a, const Desc &b)
+{
+	return a.Width == b.Width && a.Height == b.Height &&
+		a.RefreshRate.Numerator == b.RefreshRate.Numerator &&
+		a.RefreshRate.Denominator == b.RefreshRate.Denominator &&
+		a.Format == b.Format &&
+		a.ScanlineOrdering == b.ScanlineOrdering &&
+		a.Scaling == b.Scaling;
+}
+
+// Lista completa = la original + las copias W x H al final (la lista de DXGI
+// va de menor a mayor, y el triple es el mas ancho). `extra` = cuantas se
+// agregaron; 0 = no hay nada que agregar (no hay modo de ese alto, o ya esta).
+template <typename Desc, typename Fn, typename Out>
+static HRESULT tt_lista_con_triple(Fn orig, Out *This, DXGI_FORMAT fmt, UINT flags,
+	std::vector<Desc> &modos, UINT *extra)
+{
+	*extra = 0;
+	modos.clear();
+	HRESULT hr = S_OK;
+	// El protocolo de dos llamadas tiene una carrera de fabrica (la lista puede
+	// crecer entre contar y llenar, p.ej. si se enchufa un monitor): reintentar.
+	for (int intento = 0; intento < 4; intento++) {
+		UINT n = 0;
+		hr = orig(This, fmt, flags, &n, NULL);
+		if (FAILED(hr))
+			return hr;
+		modos.resize(n);
+		if (n == 0)
+			break;
+		hr = orig(This, fmt, flags, &n, modos.data());
+		if (hr == DXGI_ERROR_MORE_DATA)
+			continue;
+		if (FAILED(hr))
+			return hr;
+		modos.resize(n);
+		break;
+	}
+	if (hr == DXGI_ERROR_MORE_DATA)
+		return hr;
+
+	const UINT W = (UINT)G->TRIPLE_MODE_WIDTH, H = (UINT)G->TRIPLE_MODE_HEIGHT;
+	if (!W || !H)
+		return hr;
+
+	UINT maxw = 0;
+	for (const Desc &m : modos)
+		if (m.Height == H && m.Width < W && m.Width > maxw)
+			maxw = m.Width;
+	if (!maxw)
+		return hr;
+
+	const size_t n0 = modos.size();
+	for (size_t i = 0; i < n0; i++) {
+		if (modos[i].Height != H || modos[i].Width != maxw)
+			continue;
+		Desc nuevo = modos[i];
+		nuevo.Width = W;
+		bool ya = false;
+		for (size_t j = 0; j < modos.size() && !ya; j++)
+			ya = tt_mismo_modo(modos[j], nuevo);
+		if (!ya) {
+			modos.push_back(nuevo);
+			(*extra)++;
+		}
+	}
+	return hr;
+}
+
+template <typename Desc, typename Fn, typename Out>
+static HRESULT tt_get_display_mode_list(Fn orig, const char *nombre, Out *This,
+	DXGI_FORMAT fmt, UINT flags, UINT *pNumModes, Desc *pDesc)
+{
+	if (tt_modos_dentro || G->TRIPLE_MODE_WIDTH <= 0 || G->TRIPLE_MODE_HEIGHT <= 0 || !pNumModes)
+		return orig(This, fmt, flags, pNumModes, pDesc);
+
+	tt_guardia_modos guardia;
+
+	std::vector<Desc> modos;
+	UINT extra = 0;
+	HRESULT hr;
+	try {
+		hr = tt_lista_con_triple<Desc>(orig, This, fmt, flags, modos, &extra);
+	} catch (...) {
+		LogInfo("TrueTriple: %s fallo armando la lista; se devuelve la original\n", nombre);
+		hr = E_FAIL;
+		extra = 0;
+	}
+
+	// Nada que agregar o algo raro: la respuesta exacta de dxgi.
+	if (FAILED(hr) || hr == DXGI_ERROR_MORE_DATA || extra == 0)
+		return orig(This, fmt, flags, pNumModes, pDesc);
+
+	const UINT total = (UINT)modos.size();
+	LogInfo("TrueTriple: modo triple agregado %dx%d (%s, formato %d, %u de %u entradas)\n",
+		G->TRIPLE_MODE_WIDTH, G->TRIPLE_MODE_HEIGHT, nombre, (int)fmt, extra, total);
+
+	if (!pDesc) {
+		*pNumModes = total;
+		return S_OK;
+	}
+	const UINT cap = *pNumModes;
+	const UINT k = cap < total ? cap : total;
+	if (k)
+		memcpy(pDesc, modos.data(), k * sizeof(Desc));
+	if (cap < total) {
+		*pNumModes = k;
+		return DXGI_ERROR_MORE_DATA;
+	}
+	*pNumModes = total;
+	return S_OK;
+}
+
+static HRESULT __stdcall Hooked_GetDisplayModeList(IDXGIOutput *This,
+	DXGI_FORMAT EnumFormat, UINT Flags, UINT *pNumModes, DXGI_MODE_DESC *pDesc)
+{
+	return tt_get_display_mode_list<DXGI_MODE_DESC>(fnOrigGetDisplayModeList,
+		"GetDisplayModeList", This, EnumFormat, Flags, pNumModes, pDesc);
+}
+
+static HRESULT __stdcall Hooked_GetDisplayModeList1(IDXGIOutput1 *This,
+	DXGI_FORMAT EnumFormat, UINT Flags, UINT *pNumModes, DXGI_MODE_DESC1 *pDesc)
+{
+	return tt_get_display_mode_list<DXGI_MODE_DESC1>(fnOrigGetDisplayModeList1,
+		"GetDisplayModeList1", This, EnumFormat, Flags, pNumModes, pDesc);
+}
+
+// Si piden EXACTAMENTE W x H se devuelve el modo falso (el de refresco mas
+// cercano al pedido, o el mas alto si no piden refresco); si no, dxgi.
+static HRESULT __stdcall Hooked_FindClosestMatchingMode(IDXGIOutput *This,
+	const DXGI_MODE_DESC *pModeToMatch, DXGI_MODE_DESC *pClosestMatch, IUnknown *pConcernedDevice)
+{
+	if (tt_modos_dentro || G->TRIPLE_MODE_WIDTH <= 0 || G->TRIPLE_MODE_HEIGHT <= 0 ||
+	    !pModeToMatch || !pClosestMatch || !fnOrigGetDisplayModeList ||
+	    pModeToMatch->Width != (UINT)G->TRIPLE_MODE_WIDTH ||
+	    pModeToMatch->Height != (UINT)G->TRIPLE_MODE_HEIGHT)
+		return fnOrigFindClosestMatchingMode(This, pModeToMatch, pClosestMatch, pConcernedDevice);
+
+	tt_guardia_modos guardia;
+
+	DXGI_FORMAT fmt = pModeToMatch->Format;
+	if (fmt == DXGI_FORMAT_UNKNOWN)
+		fmt = DXGI_FORMAT_R8G8B8A8_UNORM;
+
+	std::vector<DXGI_MODE_DESC> modos;
+	UINT extra = 0;
+	HRESULT hr;
+	try {
+		hr = tt_lista_con_triple<DXGI_MODE_DESC>(fnOrigGetDisplayModeList, This, fmt, 0, modos, &extra);
+	} catch (...) {
+		hr = E_FAIL;
+		extra = 0;
+	}
+	if (FAILED(hr) || hr == DXGI_ERROR_MORE_DATA || extra == 0)
+		return fnOrigFindClosestMatchingMode(This, pModeToMatch, pClosestMatch, pConcernedDevice);
+
+	double pedido = pModeToMatch->RefreshRate.Denominator ?
+		(double)pModeToMatch->RefreshRate.Numerator / pModeToMatch->RefreshRate.Denominator : 0.0;
+	size_t mejor = modos.size() - extra;
+	double mejor_d = 1e30;
+	for (size_t i = modos.size() - extra; i < modos.size(); i++) {
+		const DXGI_RATIONAL &r = modos[i].RefreshRate;
+		double hz = r.Denominator ? (double)r.Numerator / r.Denominator : 0.0;
+		double d = pedido > 0.0 ? fabs(hz - pedido) : -hz;
+		if (d < mejor_d) {
+			mejor_d = d;
+			mejor = i;
+		}
+	}
+	*pClosestMatch = modos[mejor];
+	LogInfo("TrueTriple: FindClosestMatchingMode %dx%d -> modo triple %u/%u Hz\n",
+		G->TRIPLE_MODE_WIDTH, G->TRIPLE_MODE_HEIGHT,
+		pClosestMatch->RefreshRate.Numerator, pClosestMatch->RefreshRate.Denominator);
+	return S_OK;
+}
+
+// Sin objetos de C++ adentro: la llama tt_instalar_ganchos_modos bajo __try.
+static void tt_instalar_ganchos_modos_cuerpo(void *factory)
+{
+	IDXGIFactory *fac = reinterpret_cast<IDXGIFactory*>(factory);
+	IDXGIAdapter *ad = NULL;
+	IDXGIOutput *out = NULL;
+	IDXGIOutput1 *out1 = NULL;
+	SIZE_T hook_id;
+	DWORD err;
+
+	// La primera salida del primer adaptador que tenga una (en una notebook
+	// hibrida el adaptador 0 puede no tener monitores).
+	for (UINT a = 0; a < 8 && !out; a++) {
+		if (FAILED(fac->EnumAdapters(a, &ad)) || !ad)
+			break;
+		if (FAILED(ad->EnumOutputs(0, &out)))
+			out = NULL;
+		ad->Release();
+		ad = NULL;
+	}
+	if (!out) {
+		LogInfo("TrueTriple: triple_window_mode sin ninguna salida DXGI; no se engancha nada\n");
+		return;
+	}
+
+	err = cHookMgr.Hook(&hook_id, (void**)&fnOrigGetDisplayModeList,
+		lpvtbl_GetDisplayModeList(out), Hooked_GetDisplayModeList, 0);
+	if (err != ERROR_SUCCESS) {
+		fnOrigGetDisplayModeList = nullptr;
+		LogInfo("TrueTriple: no se pudo enganchar IDXGIOutput::GetDisplayModeList (%u); triple_window_mode sin efecto\n", err);
+		out->Release();
+		return;
+	}
+	LogInfo("TrueTriple: enganchado IDXGIOutput::GetDisplayModeList (modo triple %dx%d)\n",
+		G->TRIPLE_MODE_WIDTH, G->TRIPLE_MODE_HEIGHT);
+
+	err = cHookMgr.Hook(&hook_id, (void**)&fnOrigFindClosestMatchingMode,
+		lpvtbl_FindClosestMatchingMode(out), Hooked_FindClosestMatchingMode, 0);
+	if (err != ERROR_SUCCESS) {
+		fnOrigFindClosestMatchingMode = nullptr;
+		LogInfo("TrueTriple: no se pudo enganchar IDXGIOutput::FindClosestMatchingMode (%u)\n", err);
+	}
+
+	if (SUCCEEDED(out->QueryInterface(__uuidof(IDXGIOutput1), (void**)&out1)) && out1) {
+		err = cHookMgr.Hook(&hook_id, (void**)&fnOrigGetDisplayModeList1,
+			lpvtbl_GetDisplayModeList1(out1), Hooked_GetDisplayModeList1, 0);
+		if (err != ERROR_SUCCESS) {
+			fnOrigGetDisplayModeList1 = nullptr;
+			LogInfo("TrueTriple: no se pudo enganchar IDXGIOutput1::GetDisplayModeList1 (%u)\n", err);
+		} else {
+			LogInfo("TrueTriple: enganchado IDXGIOutput1::GetDisplayModeList1\n");
+		}
+		out1->Release();
+	}
+	out->Release();
+}
+
+static void tt_instalar_ganchos_modos(void *factory)
+{
+	static volatile LONG hecho = 0;
+
+	if (G->TRIPLE_MODE_WIDTH <= 0 || G->TRIPLE_MODE_HEIGHT <= 0 || !factory)
+		return;
+	if (InterlockedCompareExchange(&hecho, 1, 0) != 0)
+		return;
+
+	__try {
+		tt_instalar_ganchos_modos_cuerpo(factory);
+	} __except (EXCEPTION_EXECUTE_HANDLER) {
+		LogInfo("TrueTriple: excepcion 0x%x instalando los ganchos de triple_window_mode; el juego sigue sin ellos\n",
+			GetExceptionCode());
+	}
+}
