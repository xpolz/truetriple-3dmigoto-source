+// TrueTriple — fija el scissor de un tercio del lienzo, o repone el del juego.
+//
+// 3Dmigoto de fabrica sabe LEER los scissor rects (como expresion) y sabe
+// HABILITARLOS en un estado de rasterizer, pero no tiene ningun comando que los
+// escriba. Sin eso no hay tres pasadas: cada redibujo pintaria sobre todo el
+// lienzo en vez de sobre su tercio, porque la proyeccion por region COLOCA pero
+// no RECORTA.
+//
+//     triple_scissor = <lo> <hi>    fraccion horizontal del render target
+//     triple_scissor = restore      repone lo que habia seteado el juego
+//     triple_scissor = fila <N> <par> <lo> <hi>
+//         (2026-11-01) las fracciones salen de IniParams en CADA ejecucion:
+//         par 0 = xN/yN, par 1 = zN/wN. Asi [Present] las calcula desde el
+//         lienzo real (bisel en vivo). <lo> <hi> son el respaldo cuando la fila
+//         no tiene un valor valido (arranque, NaN, fuera de 0..1).
+//
+// Las fracciones y no pixeles absolutos, a proposito: asi es independiente de la
+// resolucion y, sobre todo, no asume que todos los destinos midan lo mismo.
+class TripleScissorCommand : public CommandListCommand {
+public:
+	float frac_lo, frac_hi;   // literales (forma vieja) o respaldo (forma fila)
+	bool restore;
+	int fila;                 // -1 = forma vieja (literal)
+	int par;                  // 0 = .xy de la fila, 1 = .zw
+
+	TripleScissorCommand() :
+		frac_lo(0.0f),
+		frac_hi(1.0f),
+		restore(false),
+		fila(-1),
+		par(0)
+	{}
+
+	void run(CommandListState*) override;
+};
+
+// TrueTriple — bindea la textura de IniParams PRE-ARMADA de una region.
+//
+//     triple_params = <region 0..3> <fila de IniParams del indice de region>
+//
+// Sustituye a escribir el indice de region con "xN = valor". Ese camino marca
+// IniParams como sucia y dispara un Map(WRITE_DISCARD) de la textura antes del
+// dibujo siguiente (CommandList.cpp: CommandListFlushState). Con tres redibujos
+// mas la vuelta al passthrough son CUATRO Map por cada draw de la camara
+// principal: en Wreckfest, ~8.000 por frame. 3Dmigoto ya cuenta ese costo en
+// Profiling::iniparams_updates, o sea que sus autores tambien lo veian como
+// punto caliente.
+//
+// En vez de eso se mantienen CUATRO copias de la textura, identicas salvo el
+// indice de region, refrescadas UNA vez por frame; el comando solo cambia cual
+// esta bindeada. De ~8.000 Map por frame a 4 UpdateSubresource.
+//
+// Ojo con el efecto de borde: mientras hay una de estas bindeada, escribir
+// IniParams desde el ini NO tiene efecto, porque se escribe en la textura real
+// y la que lee el shader es otra. Por eso hace falta cerrar siempre con
+// `triple_params = 3` (passthrough) al terminar los redibujos.
+// La fila va EXPLICITA y no se deduce del tamano de IniParams: deducirla como
+// "la ultima reservada" es cierto hoy y se romperia MUDO el dia que el ini
+// reserve una fila mas alta, aplicando el indice de region sobre otro dato.
+class TripleParamsCommand : public CommandListCommand {
+public:
+	int region;
+	int fila;
+
+	TripleParamsCommand() : region(3), fila(-1) {}
+
+	void run(CommandListState*) override;
+};
+
+// Libera las texturas por region. La llama HackerDevice al recrear IniParams.
+void TripleParamsRelease();
+
+// TrueTriple (2026-11-01): aviso en pantalla cuando cambia $triple_on o una
+// perilla de geometria. Lanza el hilo UNA vez; se llama en cada Present.
+void TripleAvisoStart();
+
+// Validacion de las fracciones del scissor, compartida entre el parseo y la
+// lectura en vivo de la fila. NaN da false en las tres comparaciones.
+static inline bool TripleFraccionesValidas(float lo, float hi)
+{
+	return lo >= 0.0f && hi > lo && hi <= 1.0f;
+}
+
+// Parseo puro de "fila <N> <par> <lo> <hi>" (sin efectos), separado para poder
+// probarlo fuera del DLL (ver docs/DLL-HECHO-2026-11-01.md).
+//   devuelve 0 si val no empieza con "fila" (no es esta forma),
+//            1 si es la forma fila y es valida,
+//           -1 si empieza con "fila" pero esta mal escrita.
+static inline int TripleParseScissorFila(const wchar_t *val, int *fila, int *par, float *lo, float *hi)
+{
+	if (wcsncmp(val, L"fila", 4) != 0 || (val[4] != L' ' && val[4] != L'\t'))
+		return 0;
+	int f = -1, p = -1, n = 0;
+	float l = 0.0f, h = 0.0f;
+	if (swscanf_s(val, L"fila %d %d %f %f %n", &f, &p, &l, &h, &n) != 4)
+		return -1;
+	if (val[n] != L'\0')            // basura al final: mejor avisar que adivinar
+		return -1;
+	if (f < 0 || (p != 0 && p != 1) || !TripleFraccionesValidas(l, h))
+		return -1;
+	*fila = f; *par = p; *lo = l; *hi = h;
+	return 1;
+}
