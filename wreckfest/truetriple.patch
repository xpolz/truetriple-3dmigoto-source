+	if (total == 256)
+		Bloque512(h, ultimo + 128);
+	TTM_FOR(i, 8)
+	{
+		TTM_FOR(k, 8) salida[8 * i + k] = (u8)(h[i] >> (56 - 8 * k));
+	}
