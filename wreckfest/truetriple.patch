+// ---- TrueTriple: texturas de IniParams pre-armadas por region --------------
+// Ver TripleParamsCommand en CommandList.h para el porque.
+
+static ID3D11Texture1D        *g_tp_tex[4] = { NULL, NULL, NULL, NULL };
+static ID3D11ShaderResourceView *g_tp_srv[4] = { NULL, NULL, NULL, NULL };
+static size_t   g_tp_size  = 0;
+static unsigned g_tp_frame = (unsigned)-1;
+
+void TripleParamsRelease()
+{
+	for (int i = 0; i < 4; i++) {
+		if (g_tp_srv[i]) { g_tp_srv[i]->Release(); g_tp_srv[i] = NULL; }
+		if (g_tp_tex[i]) { g_tp_tex[i]->Release(); g_tp_tex[i] = NULL; }
+	}
+	g_tp_size = 0;
+	g_tp_frame = (unsigned)-1;
+}
+
+// Refresca las cuatro copias desde G->iniParams. Una vez por frame alcanza: lo
+// unico que cambia dentro del frame es el indice de region, y de eso se encarga
+// tener una copia por valor.
+static bool triple_params_refresh(CommandListState *state, size_t fila)
+{
+	if (G->iniParams.empty() || fila >= G->iniParams.size())
+		return false;
+
+	if (g_tp_size != G->iniParams.size())
+		TripleParamsRelease();
+
+	const size_t n = G->iniParams.size();
+	std::vector<DirectX::XMFLOAT4> buf(G->iniParams);
+
+	for (int i = 0; i < 4; i++) {
+		buf[fila] = G->iniParams[fila];
+		buf[fila].x = (float)i;
+
+		if (!g_tp_tex[i]) {
+			D3D11_TEXTURE1D_DESC desc;
+			memset(&desc, 0, sizeof(desc));
+			desc.Width     = (UINT)n;
+			desc.MipLevels = 1;
+			desc.ArraySize = 1;
+			desc.Format    = DXGI_FORMAT_R32G32B32A32_FLOAT;
+			// DEFAULT + UpdateSubresource en vez de DYNAMIC + Map: son cuatro
+			// escrituras por frame, no por draw, y UpdateSubresource es valido
+			// tambien en contextos diferidos.
+			desc.Usage     = D3D11_USAGE_DEFAULT;
+			desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+
+			D3D11_SUBRESOURCE_DATA init;
+			memset(&init, 0, sizeof(init));
+			init.pSysMem = buf.data();
+
+			if (FAILED(state->mOrigDevice1->CreateTexture1D(&desc, &init, &g_tp_tex[i]))) {
+				LogInfo("TripleParams: CreateTexture1D fallo para la region %d\n", i);
+				TripleParamsRelease();
+				return false;
+			}
+			if (FAILED(state->mOrigDevice1->CreateShaderResourceView(g_tp_tex[i], NULL, &g_tp_srv[i]))) {
+				LogInfo("TripleParams: CreateShaderResourceView fallo para la region %d\n", i);
+				TripleParamsRelease();
+				return false;
+			}
+		} else {
+			state->mOrigContext1->UpdateSubresource(g_tp_tex[i], 0, NULL, buf.data(), 0, 0);
+		}
+	}
+
+	g_tp_size = n;
+	return true;
+}
+
+void TripleParamsCommand::run(CommandListState *state)
+{
+	if (G->IniParamsReg < 0 || fila < 0)
+		return;
+
+	// Antes de tocar nada hay que VOLCAR lo que el ini haya escrito en este
+	// frame (por ejemplo las matrices de [Present]): si no, las copias se
+	// armarian con datos viejos.
+	CommandListFlushState(state);
+
+	if (g_tp_frame != G->frame_no) {
+		if (!triple_params_refresh(state, (size_t)fila))
+			return;
+		g_tp_frame = G->frame_no;
+	}
+
+	if (region < 0 || region > 3 || !g_tp_srv[region])
+		return;
+
+	// DIAGNOSTICO (una vez cada 600 frames, ~10 s): que ve el gate del shader.
+	//
+	// El gate vive en el ENSAMBLADOR, asi que no hay forma de observarlo desde
+	// aca; pero sus dos entradas si. La fila de region que se publica es
+	// exactamente lo que el shader lee de t120, y `aspect` es contra lo que
+	// compara. Si aspect sale 0 o distinto del lienzo, el gate cierra siempre y
+	// el sintoma es "los redibujos ocurren pero la perspectiva no cambia".
+	//
+	// Se logea desde la region 0 nomas, para tener una linea por frame y no tres.
+	{
+		// 2026-11-01: solo en modo caza. Es un LogInfo barato, pero en
+		// produccion no le sirve a nadie y ensucia el log del usuario.
+		static unsigned ultimo = (unsigned)-1;
+		if (G->hunting == HUNTING_MODE_ENABLED && region == 0 && G->frame_no / 600 != ultimo / 600) {
+			ultimo = G->frame_no;
+			const DirectX::XMFLOAT4 &f = G->iniParams[fila];
+			LogInfo("TRIPLEDIAG f=%u  fila%d=(%.4f, %.4f, %.4f, %.4f)  iniParams=%Iu  srv=%p\n",
+				G->frame_no, fila, f.x, f.y, f.z, f.w,
+				G->iniParams.size(), g_tp_srv[region]);
+		}
+	}
+
+	// Solo la etapa de vertex: los shaders parcheados son todos vertex shaders,
+	// y asi el resto del pipeline sigue viendo la textura de 3Dmigoto.
+	state->mOrigContext1->VSSetShaderResources(G->IniParamsReg, 1, &g_tp_srv[region]);
+}
+
+// TrueTriple (2026-11-01): aca vivia triple_diag_camara, que cada 600 frames
+// copiaba el cb2 del juego a un buffer STAGING y lo leia con Map(READ) sin
+// DO_NOT_WAIT: una espera a la GPU dentro del frame, en la ruta de cada usuario.
+// Se ELIMINO en vez de dejarla atras de G->hunting porque el ini de produccion
+// corre con hunting=1, asi que la compuerta no la hubiera apagado, y porque el
+// dato que daba era inutil (siempre identidad: ver
+// docs/INVENTARIO-MOD-2026-11-01.md, secciones 0 y 1.2). Si hace falta la
+// camara, la tecnica sin lectura de GPU es interceptar el Map del juego (DR2).
+
+void TripleScissorCommand::run(CommandListState *state)
+{
+	// Se llama al contexto ORIGINAL a proposito: asi estas escrituras no pasan
+	// por HackerContext::RSSetScissorRects y no contaminan la copia sombra, que
+	// tiene que quedarse con lo ultimo que seteo EL JUEGO.
+	ID3D11DeviceContext1 *ctx = state->mOrigContext1;
+	D3D11_RECT r;
+
+	if (restore) {
+		HackerContext *hc = state->mHackerContext;
+		if (hc && hc->mTripleScissorShadowCount > 0) {
+			ctx->RSSetScissorRects(hc->mTripleScissorShadowCount, hc->mTripleScissorShadow);
+			return;
+		}
+		// El juego no habia seteado ninguno: hay que dejar un rectangulo que no
+		// pueda recortar nada. NO sirve poner el del lienzo (p.ej. 7760x1440):
+		// los pases fuera de pantalla tienen otros tamanos —el shadow map suele
+		// ser cuadrado y mas alto que 1440— y ese rectangulo les cortaria la
+		// parte de abajo. El sintoma son sombras que "nadan" al girar, que no se
+		// parece en nada a un error de proyeccion y por eso cuesta rastrearlo.
+		// 16384 es el maximo de textura en D3D11: no puede recortar ningun RT.
+		r.left = 0; r.top = 0; r.right = 16384; r.bottom = 16384;
+		ctx->RSSetScissorRects(1, &r);
+		return;
+	}
+
+	// Fracciones efectivas. Forma vieja: los literales. Forma fila: lo que
+	// [Present] dejo en IniParams en ESTE frame, con los literales de respaldo
+	// si la fila no existe o no trae un rango valido (NaN cae afuera solo).
+	float lo = frac_lo, hi = frac_hi;
+	bool de_fila = false;
+	if (fila >= 0 && (size_t)fila < G->iniParams.size()) {
+		const DirectX::XMFLOAT4 &v = G->iniParams[fila];
+		float l = par ? v.z : v.x;
+		float h = par ? v.w : v.y;
+		if (TripleFraccionesValidas(l, h)) {
+			lo = l;
+			hi = h;
+			de_fila = true;
+		}
+	}
+
+	const bool caza = (G->hunting == HUNTING_MODE_ENABLED);
+
+	// DIAGNOSTICO (solo caza): las fracciones que se estan usando de verdad,
+	// una linea por (fila, par) cada 600 frames. Sirve para ver en el log que
+	// el scissor sigue al lienzo y si esta cayendo al respaldo.
+	if (caza && fila >= 0) {
+		static struct { int fila, par; unsigned ultimo; } vistos_sc[8];
+		static int nvistos_sc = 0;
+		int i;
+		for (i = 0; i < nvistos_sc; i++)
+			if (vistos_sc[i].fila == fila && vistos_sc[i].par == par)
+				break;
+		if (i == nvistos_sc && nvistos_sc < 8) {
+			vistos_sc[i].fila = fila; vistos_sc[i].par = par;
+			vistos_sc[i].ultimo = (unsigned)-1;
+			nvistos_sc++;
+		}
+		if (i < nvistos_sc && G->frame_no / 600 != vistos_sc[i].ultimo / 600) {
+			vistos_sc[i].ultimo = G->frame_no;
+			LogInfo("TRIPLEDIAG f=%u  scissor fila%d par%d: %.5f .. %.5f (%s)\n",
+				G->frame_no, fila, par, lo, hi, de_fila ? "de la fila" : "RESPALDO");
+		}
+	}
+
+	// DIAGNOSTICO: los TAMANOS de render target que estan llegando a triplicarse.
+	//
+	// El gate por destino decide con rt_width/rt_height, y si deja pasar algo que
+	// no es el lienzo principal —un atlas de sombras cuadrado, por ejemplo— se
+	// triplica el mapa de sombras y se ve como manchas negras enormes que se
+	// mueven con la camara, no como un error de proyeccion. Esto lista cada
+	// tamano distinto UNA vez, asi que el log dice exactamente que paso.
+	if (caza && lo < 0.001f) {
+		ProcessParamRTSize(state);
+		static struct { int w, h; } vistos[16];
+		static int nvistos = 0;
+		int w = (int)state->rt_width, h = (int)state->rt_height;
+		bool nuevo_tam = true;
+		for (int i = 0; i < nvistos; i++)
+			if (vistos[i].w == w && vistos[i].h == h) { nuevo_tam = false; break; }
+		if (nuevo_tam && nvistos < 16) {
+			vistos[nvistos].w = w; vistos[nvistos].h = h; nvistos++;
+			LogInfo("TRIPLEDIAG destino que se TRIPLICA: %dx%d (f=%u)\n", w, h, G->frame_no);
+		}
+	}
+
+	ProcessParamRTSize(state);
+	if (state->rt_width <= 0.0f || state->rt_height <= 0.0f)
+		return;
+
+	r.left   = (LONG)(state->rt_width * lo + 0.5f);
+	r.right  = (LONG)(state->rt_width * hi + 0.5f);
+	r.top    = 0;
+	r.bottom = (LONG)(state->rt_height + 0.5f);
+	ctx->RSSetScissorRects(1, &r);
+}
+
+// ===== TrueTriple (2026-11-01): aviso en pantalla de F7 y de las perillas ======
+//
+// Idea copiada de DR2 (eye_hud_thread), codigo propio. Antes de esto F7 no daba
+// ninguna respuesta visible: el unico indicio de ON/OFF era la imagen.
+//
+// Lecciones que vienen con la idea, todas escritas en DR2:
+//  - LOG_WARNING y no LOG_NOTICE: NOTICE tiene hide_in_release y fuera del modo
+//    caza no se dibuja nunca (Overlay.cpp, DrawNotices y LogOverlay).
+//  - Los valores se leen ANTES del bucle: con un centinela la primera vuelta
+//    siempre "cambia" y al arrancar saldrian cinco carteles diciendo que esta
+//    todo normal, que se leen como un error.
+//  - Se lee por NOMBRE en cada vuelta, bajo G->mCriticalSection (el mismo que
+//    toma ReloadConfig mientras rearma command_list_globals). NUNCA se guarda
+//    un puntero a la variable: la recarga del ini libera las globales y en DR2
+//    un puntero guardado dio un AccessViolation.
+//  - Si una global no existe (ini viejo), de esa no se avisa nada.
+
+struct TripleAvisoValor {
+	bool found;
+	float fval;
+};
+
+static TripleAvisoValor triple_aviso_leer(const wchar_t *nombre)
+{
+	TripleAvisoValor r = { false, 0.0f };
+	EnterCriticalSectionPretty(&G->mCriticalSection);
+	auto it = command_list_globals.find(nombre);
+	if (it != command_list_globals.end()) {
+		r.found = true;
+		r.fval = it->second.fval;
+	}
+	LeaveCriticalSection(&G->mCriticalSection);
+	return r;
+}
+
+// "61" si es entero (a la decima), si no "60.5". El bisel y el angulo se mueven
+// de a enteros; la distancia puede llegar con decimales desde la app.
+static void triple_aviso_num(char *buf, size_t n, float v)
+{
+	float r = floorf(v + 0.5f);
+	if (fabsf(v - r) < 0.05f)
+		_snprintf_s(buf, n, _TRUNCATE, "%.0f", r);
+	else
+		_snprintf_s(buf, n, _TRUNCATE, "%.1f", v);
+}
+
+static DWORD WINAPI triple_aviso_thread(LPVOID)
+{
+	struct Perilla {
+		const wchar_t *nombre;
+		int tipo;              // un aviso vivo por tipo (Overlay.cpp)
+		TripleAvisoValor ultimo;
+	} perillas[] = {
+		{ L"$triple_on", 1 },
+		{ L"$bezel_px",  2 },
+		{ L"$eye_cm",    3 },
+		{ L"$ang_deg",   4 },
+		{ L"$fov_zoom",  5 },
+		// 2026-11-02: SUELO FIJO (experimental, Ctrl+Alt+F7). Solo el estado,
+		// como $triple_on. Ver docs/SUELO-NEGRO-ARREGLO-2026-11-02.md.
+		{ L"$cb2_fijo",  6 },
+	};
+	const int n = sizeof(perillas) / sizeof(perillas[0]);
+
+	for (int i = 0; i < n; i++)
+		perillas[i].ultimo = triple_aviso_leer(perillas[i].nombre);
+
+	LogInfo("TTAVISO: hilo del aviso en pantalla activo (triple_on %s, bisel %s, "
+		"distancia %s, angulo %s, zoom %s, suelo fijo %s)\n",
+		perillas[0].ultimo.found ? "si" : "no", perillas[1].ultimo.found ? "si" : "no",
+		perillas[2].ultimo.found ? "si" : "no", perillas[3].ultimo.found ? "si" : "no",
+		perillas[4].ultimo.found ? "si" : "no", perillas[5].ultimo.found ? "si" : "no");
+
+	while (true) {
+		Sleep(120);
+		for (int i = 0; i < n; i++) {
+			TripleAvisoValor v = triple_aviso_leer(perillas[i].nombre);
+			TripleAvisoValor &u = perillas[i].ultimo;
+			if (!v.found) {
+				// Desaparecio (recarga a un ini viejo): olvidarla, asi si
+				// vuelve no avisa por haber "cambiado" desde nada.
+				u = v;
+				continue;
+			}
+			if (!u.found) {
+				// Aparecio (recarga a un ini nuevo): tomarla como base, sin
+				// aviso. Mismo criterio que al arrancar.
+				u = v;
+				continue;
+			}
+			if (v.fval == u.fval)
+				continue;
+
+			char num[32];
+			switch (perillas[i].tipo) {
+			case 1:
+				// Solo el estado: pasar de 1 a 2 no es "cambiar".
+				if ((v.fval >= 0.5f) != (u.fval >= 0.5f))
+					LogOverlayTrueTriple(1, "TrueTriple %s\n", v.fval >= 0.5f ? "ON" : "OFF");
+				break;
+			case 2:
+				triple_aviso_num(num, sizeof(num), v.fval);
+				LogOverlayTrueTriple(2, "Bisel %s px\n", num);
+				break;
+			case 3:
+				triple_aviso_num(num, sizeof(num), v.fval);
+				LogOverlayTrueTriple(3, "Distancia %s cm\n", num);
+				break;
+			case 4:
+				triple_aviso_num(num, sizeof(num), v.fval);
+				LogOverlayTrueTriple(4, "Angulo %s\n", num);
+				break;
+			case 5:
+				LogOverlayTrueTriple(5, "Zoom %.2f\n", v.fval);
+				break;
+			case 6:
+				if ((v.fval >= 0.5f) != (u.fval >= 0.5f))
+					LogOverlayTrueTriple(6, "Suelo fijo %s\n", v.fval >= 0.5f ? "ON" : "OFF");
+				break;
+			}
+			u = v;
+		}
+	}
+	return 0;
+}
+
+static volatile LONG g_triple_aviso_estado = 0;
+
+void TripleAvisoStart()
+{
+	// Una sola vez por proceso. Se llama desde el Present, o sea despues de
+	// cargado el ini, que es lo que hace falta para leer los valores iniciales.
+	if (InterlockedCompareExchange(&g_triple_aviso_estado, 1, 0) != 0)
+		return;
+	HANDLE h = CreateThread(NULL, 0, triple_aviso_thread, NULL, 0, NULL);
+	if (h)
+		CloseHandle(h);
+	else
+		LogInfo("TTAVISO: no pude lanzar el hilo del aviso en pantalla\n");
+}
