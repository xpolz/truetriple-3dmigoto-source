+	InitializeCriticalSection(&g_tt_cam_cs);
+	g_tt_cam_exe = exe;
+	g_tt_cam_slot = slot;
+	g_tt_cam_build_orig = (tt_cam_build_fn)(uintptr_t)slot[0];
+#if TT_CULL_DIAG
