+// ===== TrueTriple DR1: captura del constant buffer de camara =================
+// Leer el cb3 del juego con un copy+Map(READ) de GPU es ilegal en contextos
+// diferidos (el juego usa varios), asi que espiamos los datos del lado CPU que
+// el juego escribe en el constant buffer via Map/Unmap. Cada contexto lo usa un
+// solo hilo, asi que el tracking thread_local no tiene carreras (regla dura 5).
+void TripleCaptureCameraCB(void *data, unsigned size);  // en CommandList.cpp (ESCRIBE: ver alla)
+void TripleNotaVS(UINT64 hash);                                // en CommandList.cpp: anota los VS de terreno
+
+static thread_local ID3D11Resource *tls_triple_map_res = NULL;
+static thread_local void *tls_triple_map_ptr = NULL;
+static thread_local UINT tls_triple_map_size = 0;
+
+static bool triple_buffer_desc(ID3D11Resource *res, D3D11_BUFFER_DESC *out)
+{
+	if (!res)
+		return false;
+	D3D11_RESOURCE_DIMENSION dim;
+	res->GetType(&dim);
+	if (dim != D3D11_RESOURCE_DIMENSION_BUFFER)
+		return false;
+	ID3D11Buffer *buf = NULL;
+	if (FAILED(res->QueryInterface(__uuidof(ID3D11Buffer), (void**)&buf)) || !buf)
+		return false;
+	buf->GetDesc(out);
+	buf->Release();
+	return true;
+}
+
+// Filtro barato por TAMANO. En DR1 el CameraParamsConstantBuffer mide 320 bytes
+// exactos y tiene un solo layout en los 3 shaderpacks (verificado offline, ver
+// docs/PSSG.md). Se deja la ventana 256..320 heredada de DR2 en vez de exigir
+// 320: cualquier candidato de mas que entre lo descarta despues el gate de
+// TripleCaptureCameraCB (perspectiva + aspecto de triple), mientras que un
+// filtro demasiado angosto dejaria el mod inerte sin un solo aviso.
+static bool triple_is_camera_cb_candidate(ID3D11Resource *res, UINT *out_size)
+{
+	D3D11_BUFFER_DESC d;
+	if (!triple_buffer_desc(res, &d))
+		return false;
+	if (!(d.BindFlags & D3D11_BIND_CONSTANT_BUFFER))
+		return false;
+	if (d.ByteWidth < 256 || d.ByteWidth > 320)
+		return false;
+	*out_size = d.ByteWidth;
+	return true;
+}
