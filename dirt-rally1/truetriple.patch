+// se bindea siempre la passthrough.
+class TripleParamsCommand : public CommandListCommand {
+public:
+	wstring ini_section;
+	int region;
+
+	TripleParamsCommand(wstring section, int r) :
+		ini_section(section), region(r)
+	{}
+
+	void run(CommandListState*) override;
+};
+
+// triple_restore
+// Rebindea el cb3 original del juego (la copia intacta que guarda
+// triple_region) despues de los 3 redibujos por region, para que los draws
+// posteriores que no matchean (carroceria, cockpit, etc.) no queden corrompidos
+// por el override de region, y repone el scissor rect del juego.
+class TripleRestoreCommand : public CommandListCommand {
+public:
+	wstring ini_section;
+
+	TripleRestoreCommand(wstring section) :
